// Xulo Language Grammar (PEG) — pest.rs implementation.
// Faithful transcription of spec/grammar.md (plus lexical-structure.md).
// Prose in the spec repository governs meaning; this file mirrors its syntax.

// ============================================================
// 0. Document root
// ============================================================

program = { SOI ~ import_decl* ~ declaration* ~ EOI }

// ============================================================
// 1. Comments & whitespace
// ============================================================

WHITESPACE = _{ (" " | "\t" | "\n" | "\r" | comment)+ }
comment = _{ line_comment | block_comment }
line_comment = _{ "//" ~ (!line_terminator ~ ANY)* }
block_comment = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }
line_terminator = _{ "\n" | "\r\n" | "\r" }

// ============================================================
// 2. Identifiers, keywords, reserved words
// ============================================================

identifier = @{ !keyword ~ !reserved ~ ident_raw }
ident_raw = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
ident_part = _{ ASCII_ALPHANUMERIC | "_" }

keyword = _{ kw_word ~ !ident_part }
// NOTE: longer spellings MUST precede their prefixes — pest matches string
// alternations through a character trie that stops at the first terminal, so
// "as" before "async" would make `async` (and `await`) escape the keyword
// guard and lex as identifiers.
kw_word = _{
      "and" | "async" | "await" | "as" | "break" | "const"
    | "continue" | "copy" | "defer" | "else" | "enum" | "false" | "fn"
    | "for" | "from" | "if" | "impl" | "in" | "import" | "is" | "let"
    | "lock" | "match" | "move" | "mut" | "not" | "null" | "or" | "panic"
    | "pub" | "return" | "self" | "shared" | "spawn" | "struct" | "test"
    | "trait" | "true" | "type" | "use" | "where" | "while"
}

reserved = _{ reserved_word ~ !ident_part }
reserved_word = _{
      "abstract" | "actor" | "arguments" | "associatedtype" | "bench"
    | "case" | "cfg" | "channel" | "class" | "debugger" | "default"
    | "deinit" | "delete" | "derive" | "doc" | "do" | "eval" | "export"
    | "extension" | "fallthrough" | "final" | "function" | "generator"
    | "generic" | "global" | "guard" | "init" | "instanceof" | "interface"
    | "isolated" | "iterator" | "lazy" | "library" | "local" | "macro"
    | "meta" | "module" | "new" | "open" | "override" | "package" | "priv"
    | "protocol" | "receiver" | "ref" | "rethrows" | "select" | "sender"
    | "static" | "super" | "switch" | "task" | "this" | "typealias"
    | "unowned" | "unsafe" | "var" | "virtual" | "void" | "weak" | "with"
    | "yield"
}

// Word-boundary keyword tokens (atomic so no whitespace is skipped between
// the spelling and the boundary check).
kw_and = @{ "and" ~ !ident_part }
kw_as = @{ "as" ~ !ident_part }
kw_async = @{ "async" ~ !ident_part }
kw_await = @{ "await" ~ !ident_part }
kw_break = @{ "break" ~ !ident_part }
kw_const = @{ "const" ~ !ident_part }
kw_continue = @{ "continue" ~ !ident_part }
kw_copy = @{ "copy" ~ !ident_part }
kw_defer = @{ "defer" ~ !ident_part }
kw_else = @{ "else" ~ !ident_part }
kw_enum = @{ "enum" ~ !ident_part }
kw_fn = @{ "fn" ~ !ident_part }
kw_for = @{ "for" ~ !ident_part }
kw_from = @{ "from" ~ !ident_part }
kw_if = @{ "if" ~ !ident_part }
kw_impl = @{ "impl" ~ !ident_part }
kw_in = @{ "in" ~ !ident_part }
kw_import = @{ "import" ~ !ident_part }
kw_is = @{ "is" ~ !ident_part }
kw_let = @{ "let" ~ !ident_part }
kw_lock = @{ "lock" ~ !ident_part }
kw_match = @{ "match" ~ !ident_part }
kw_move = @{ "move" ~ !ident_part }
kw_mut = @{ "mut" ~ !ident_part }
kw_not = @{ "not" ~ !ident_part }
kw_or = @{ "or" ~ !ident_part }
kw_panic = @{ "panic" ~ !ident_part }
kw_pub = @{ "pub" ~ !ident_part }
kw_return = @{ "return" ~ !ident_part }
kw_self = @{ "self" ~ !ident_part }
kw_shared = @{ "shared" ~ !ident_part }
kw_spawn = @{ "spawn" ~ !ident_part }
kw_struct = @{ "struct" ~ !ident_part }
kw_test = @{ "test" ~ !ident_part }
kw_trait = @{ "trait" ~ !ident_part }
kw_type = @{ "type" ~ !ident_part }
kw_use = @{ "use" ~ !ident_part }
kw_where = @{ "where" ~ !ident_part }
kw_while = @{ "while" ~ !ident_part }

pub_marker = { kw_pub }

// ============================================================
// 3. Literals
// ============================================================

number_literal = @{ (hex_int | bin_int | oct_int | float_literal | dec_int) ~ !ident_part }
dec_int = @{ ASCII_DIGIT+ }
hex_int = @{ "0" ~ ("x" | "X") ~ ASCII_HEX_DIGIT+ }
bin_int = @{ "0" ~ ("b" | "B") ~ ASCII_BIN_DIGIT+ }
oct_int = @{ "0" ~ ("o" | "O") ~ ASCII_OCT_DIGIT+ }
float_literal = @{ dec_int ~ "." ~ dec_int }

string_literal = @{ "\"" ~ string_char* ~ "\"" | "'" ~ string_char* ~ "'" }
string_char = _{ string_escape | !("\"" | "'" | "\\" | "\n" | "\r") ~ ANY }
string_escape = @{ "\\" ~ ("\"" | "'" | "\\" | "n" | "t" | "r" | unicode_body) }
unicode_body = _{ "u" ~ (ASCII_HEX_DIGIT{4} | "{" ~ ASCII_HEX_DIGIT+ ~ "}") }

boolean_literal = @{ ("true" | "false") ~ !ident_part }
null_literal = @{ "null" ~ !ident_part }

// A template is: opening text (through `template_start`), then any number of
// interpolations (each with its trailing text folded into `interp_tail`).
// Folding the text runs into atomic rules that *start at* a real token (the
// backtick / `}`) keeps them from being eaten by inter-token whitespace
// skipping in this non-atomic rule — `${i} times` must keep the space.
template_literal = { template_start ~ interpolation* ~ "`" }
template_start = @{ "`" ~ (template_escape | !("${" | "`") ~ ANY)* }
interpolation = { "${" ~ expression ~ interp_tail }
interp_tail = @{ "}" ~ (template_escape | !("${" | "`") ~ ANY)* }
template_escape = @{ "\\" ~ ("`" | "$" | "n" | "t" | "r" | "\\" | "\"" | "'" | unicode_body) }

// ============================================================
// 4. Program and modules
// ============================================================

import_decl = { kw_import ~ ( type_import | namespace_import | named_import | side_effect_import ) }
type_import = { kw_type ~ named_imports ~ kw_from ~ string_literal }
named_import = { named_imports ~ kw_from ~ string_literal }
namespace_import = { "*" ~ kw_as ~ identifier ~ kw_from ~ string_literal }
side_effect_import = { string_literal }
named_imports = { "{" ~ (import_entry ~ ("," ~ import_entry)* ~ ","?)? ~ "}" }
import_entry = { identifier ~ (kw_as ~ identifier)? }

// ============================================================
// 5. Declarations
// ============================================================

declaration = {
      pub_use
    | fn_decl
    | test_decl
    | struct_decl
    | enum_decl
    | trait_decl
    | impl_decl
    | type_alias
    | let_decl
    | const_decl
}

pub_use = { kw_pub ~ kw_use ~ "{" ~ (identifier ~ ("," ~ identifier)* ~ ","?)? ~ "}"
    ~ (kw_from ~ string_literal)? }

fn_decl = { pub_marker? ~ kw_async? ~ kw_fn ~ identifier ~ generic_params?
    ~ "(" ~ parameter_list? ~ ")" ~ (":" ~ type_expr)? ~ where_clause? ~ block }

// `TestDecl = "test" [ "async" ] "fn" Identifier "(" ")" Block` — fixed
// shape: no pub, no parameters, no return type, no generics, no where.
test_decl = { kw_test ~ kw_async? ~ kw_fn ~ identifier ~ "(" ~ ")" ~ block }

parameter_list = { parameter ~ ("," ~ parameter)* ~ ","? }
parameter = { receiver | identifier ~ ":" ~ param_mode? ~ type_expr ~ ("=" ~ expression)? }
receiver = { kw_self | kw_mut ~ kw_self }
param_mode = { kw_mut | kw_shared }

struct_decl = { pub_marker? ~ kw_struct ~ identifier ~ generic_params? ~ "{" ~ field_list? ~ "}" }
field_list = { field ~ (","? ~ field)* ~ ","? }
field = { pub_marker? ~ identifier ~ ":" ~ type_expr }

enum_decl = { pub_marker? ~ kw_enum ~ identifier ~ generic_params? ~ "{" ~ variant_list? ~ "}" }
variant_list = { variant ~ (","? ~ variant)* ~ ","? }
variant = { identifier ~ variant_payload? }
variant_payload = { "(" ~ (name_type_list | type_list)? ~ ")" }
name_type_list = { named_payload ~ ("," ~ named_payload)* }
named_payload = { identifier ~ ":" ~ type_expr }
type_list = { type_expr ~ ("," ~ type_expr)* }

trait_decl = { pub_marker? ~ kw_trait ~ identifier ~ generic_params? ~ "{" ~ trait_methods? ~ "}" }
trait_methods = { trait_method ~ (";" ~ trait_method)* ~ ";"? }
trait_method = { kw_async? ~ kw_fn ~ identifier ~ "(" ~ parameter_list? ~ ")" ~ ":" ~ type_expr }

impl_decl = { kw_impl ~ generic_params? ~ (identifier ~ kw_for)? ~ type_expr
    ~ "{" ~ fn_decl* ~ "}" }

type_alias = { pub_marker? ~ kw_type ~ identifier ~ generic_params? ~ "=" ~ type_expr }

let_decl = { pub_marker? ~ kw_let ~ (mut_binding | simple_binding | destructuring_binding) }
mut_binding = { kw_mut ~ identifier ~ (":" ~ type_expr)? ~ "=" ~ kw_shared? ~ expression }
simple_binding = { identifier ~ (":" ~ type_expr)? ~
    ( ("=" ~ kw_shared? ~ expression) | (":=" ~ expression) ) }
destructuring_binding = { ("{" ~ identifier_list ~ "}" | "(" ~ identifier_list ~ ")") ~ "=" ~ expression }
identifier_list = { identifier ~ ("," ~ identifier)* ~ ","? }

const_decl = { pub_marker? ~ kw_const ~ identifier ~ (":" ~ type_expr)? ~ "=" ~ expression }

// Component declarations (meaningful only at the top level of a component
// body; the checker enforces that).
component_decl = { state_decl | store_decl | effect_decl | environment_decl }
state_decl = { "@" ~ identifier ~ kw_let ~ identifier ~ (":" ~ type_expr)? ~ "=" ~ expression }
store_decl = { "@" ~ identifier ~ kw_let ~ "{" ~ identifier_list ~ "}" ~ "=" ~ expression }
effect_decl = { "@" ~ identifier ~ expression ~ ("," ~ expression)? }
environment_decl = { "@" ~ identifier ~ kw_let ~ identifier ~ ":" ~ type_expr }

// ============================================================
// 6. Types
// ============================================================

type_expr = { union_type }
union_type = { intersection_type ~ ("|" ~ intersection_type)* }
intersection_type = { postfix_type ~ ("&" ~ postfix_type)* }
// `opt_question` is a named (non-silent) rule so the builder can see the `?`
// as an inner pair: a bare `"?"?` string is invisible, and comparing rule
// spans misfires because pest spans include trailing skipped whitespace.
postfix_type = { primary_type ~ opt_question? }
opt_question = @{ "?" }
primary_type = { named_type | function_type | literal_type | paren_or_tuple_type }
named_type = { identifier ~ type_args? }
literal_type = { string_literal | number_literal | boolean_literal }
// `( T )` groups, `( T1, T2, … )` is a tuple type — one pass (see the
// parenthesized-expression note about exponential backtracking).
paren_or_tuple_type = { "(" ~ type_expr ~ ("," ~ type_expr ~ ("," ~ type_expr)* ~ ","?)? ~ ")" }

type_args = { "<" ~ type_list ~ gt_close }
gt_close = @{ ">" ~ !">" }

function_type = { kw_async? ~ kw_fn ~ "(" ~ fn_type_params? ~ ")" ~ (":" ~ type_expr)? }
fn_type_params = { fn_type_param ~ ("," ~ fn_type_param)* }
fn_type_param = { (ident_raw ~ ":")? ~ param_mode? ~ type_expr }

generic_params = { "<" ~ generic_param ~ ("," ~ generic_param)* ~ ","? ~ ">" }
generic_param = { identifier ~ (":" ~ trait_bound)? }
trait_bound = { type_expr ~ ("+" ~ type_expr)* }
where_clause = { kw_where ~ where_item ~ ("," ~ where_item)* }
where_item = { identifier ~ ":" ~ trait_bound }

// ============================================================
// 7. Statements
// ============================================================

statement = { inner_statement ~ ";"? }
inner_statement = {
      component_decl
    | let_decl
    | const_decl
    | fn_decl
    | return_stmt
    | break_stmt
    | continue_stmt
    | defer_stmt
    | for_stmt
    | while_stmt
    | component_call
    | expr_stmt_or_assignment
}

return_stmt = { kw_return ~ expression? }
break_stmt = { kw_break }
continue_stmt = { kw_continue }
defer_stmt = { kw_defer ~ (block | expression) }

// One rule, one pass: the expression is parsed once, and a following `=`
// (if any) makes the statement an assignment — whose target accepts any
// expression so a non-place one (`f() = 2`) is rejected as the semantic
// `E0402` the error table promises (spec/grammar.md `Assignment` names
// `Place`; two alternatives that each re-parse the whole expression would
// backtrack exponentially on deeply nested input).
expr_stmt_or_assignment = { !("{" ~ ANY) ~ ternary_expression
    ~ (assign_op ~ assignment_expression)? }
assignment_expression = { ternary_expression ~ (assign_op ~ assignment_expression)? }
assign_op = @{ "=" ~ !"=" }

block = { "{" ~ statement* ~ "}" }

for_stmt = { kw_for ~ identifier ~ kw_in ~ expression ~ block }
while_stmt = { kw_while ~ expression ~ block }

// ============================================================
// 8. Expressions
// ============================================================

expression = { ternary_expression }

ternary_expression = { logical_or_expression
    ~ ("?" ~ !"?" ~ !"." ~ expression ~ ":" ~ ternary_expression)? }
logical_or_expression = { logical_and_expression ~ (kw_or ~ logical_and_expression)* }
logical_and_expression = { nullish_expression ~ (kw_and ~ nullish_expression)* }
nullish_expression = { equality_expression ~ ("??" ~ equality_expression)* }
equality_expression = { is_expression ~ (eq_op ~ is_expression)* }
eq_op = { "==" | "!=" }
is_expression = { relational_expression ~ (kw_is ~ kw_not? ~ type_expr)? }
relational_expression = { range_expression ~ (rel_op ~ range_expression)? }
rel_op = { "<=" | ">=" | "<" ~ !"<" | ">" ~ !">" }
range_expression = { bit_or_expression ~ (range_op ~ bit_or_expression)? }
range_op = { "..<" | "..." }
bit_or_expression = { bit_xor_expression ~ ("|" ~ bit_xor_expression)* }
bit_xor_expression = { bit_and_expression ~ ("^" ~ bit_and_expression)* }
bit_and_expression = { shift_expression ~ ("&" ~ shift_expression)* }
shift_expression = { additive_expression ~ (shift_op ~ additive_expression)* }
shift_op = { "<<" | ">>" }
additive_expression = { multiplicative_expression ~ (add_op ~ multiplicative_expression)* }
add_op = { "+" | "-" }
multiplicative_expression = { power_expression ~ (mul_op ~ power_expression)* }
mul_op = { "*" ~ !"*" | "/" | "%" }
power_expression = { unary_expression ~ ("**" ~ power_expression)? }

unary_expression = { postfix_expression | unary_op ~ unary_expression }
unary_op = { "!" | "-" | "~" | kw_await | kw_move | kw_copy }

postfix_expression = { primary_expression ~ postfix_op* }
postfix_op = {
      call_args
    | "[" ~ expression ~ "]"
    | "." ~ (identifier | integer_literal)
    | "?." ~ (identifier | integer_literal)
    | propagation_q
}
// The postfix `?` (failure propagation) only applies when the ternary reading
// `? Expression ":"` does not parse (spec: error-handling.md). The adjacent
// `?.` token is claimed by the `?." postfix alternative above, so no extra
// guard against `.` is needed here.
propagation_q = { "?" ~ !"?" ~ !(expression ~ ":") }
integer_literal = @{ dec_int ~ !ident_part }
call_args = { "(" ~ (argument ~ ("," ~ argument)* ~ ","?)? ~ ")" }
// The `::` lookahead keeps `Foo::bar(x)` from being read as a named argument
// `Foo:` + a failed `:bar(x)` value: without it, the named-arg prefix consumes
// the first colon of `::` and the whole call argument fails.
argument = { (ident_raw ~ !("::") ~ ":")? ~ (dollar_place | expression) }
dollar_place = { "$" ~ place }
place = { place_primary ~ place_op* }
place_primary = { ident_raw | "(" ~ place ~ ")" }
place_op = { "." ~ (ident_raw | integer_literal) | "[" ~ expression ~ "]" }

primary_expression = {
      literal_expression
    | template_literal
    | variant_path
    | function_expression
    | arrow_closure
    | if_expression
    | match_expression
    | panic_expression
    | spawn_expression
    | lock_expression
    | typed_map
    | paren_or_tuple
    | list_literal
    | brace_map
    | self_expression
    | identifier_expression
}

literal_expression = { number_literal | string_literal | boolean_literal | null_literal }
variant_path = { identifier ~ "::" ~ identifier ~ ("(" ~ argument_list? ~ ")")? }
argument_list = { argument ~ ("," ~ argument)* ~ ","? }

component_call = { identifier ~ ("(" ~ argument_list? ~ ")")? ~ component_block }
component_block = { "{" ~ child_item* ~ "}" }
child_item = { for_stmt | component_call | expression }

function_expression = { kw_async? ~ kw_fn ~ "(" ~ closure_param_list? ~ ")"
    ~ (":" ~ type_expr)? ~ block }
arrow_closure = { kw_async? ~ arrow_params ~ (":" ~ type_expr)? ~ "=>"
    ~ (block | expression) }
arrow_params = { "(" ~ closure_param_list? ~ ")" | identifier }
closure_param_list = { closure_param ~ ("," ~ closure_param)* ~ ","? }
closure_param = { identifier ~ (":" ~ type_expr)? }

if_expression = { kw_if ~ expression ~ block ~ (kw_else ~ (block | if_expression))? }

match_expression = { kw_match ~ expression ~ "{" ~ match_arm_list? ~ "}" }
match_arm_list = { match_arm ~ (","? ~ match_arm)* ~ ","? }
match_arm = { pattern ~ guard? ~ "=>" ~ (block | expression) }
guard = { kw_if ~ expression }

panic_expression = { kw_panic ~ "(" ~ expression ~ ")" }

spawn_expression = { kw_spawn ~ (service_spawn | task_spawn) }
task_spawn = { spawn_target? ~ kw_async ~ block }
spawn_target = { "." ~ ("thread" | "process" | (kw_on ~ "(" ~ expression ~ ")")) }
kw_on = @{ "on" ~ !ident_part }
service_spawn = { "." ~ "process" ~ type_expr ~ "{" ~ (field_init ~ ("," ~ field_init)* ~ ","?)? ~ "}" }
field_init = { identifier ~ ":" ~ expression }

lock_expression = { kw_lock ~ identifier ~ block }

// TypedMap is written with the fixed `Map` spelling (spec: PrimaryExpression).
typed_map = { map_kw ~ type_args ~ "{" ~ (map_entry ~ ("," ~ map_entry)* ~ ","?)? ~ "}" }
map_kw = @{ "Map" ~ !ident_part }
map_entry = { expression ~ ":" ~ expression }

// `( e )` groups, `( e1, e2, … )` is a tuple — one rule, one pass, so nested
// parens don't re-parse (exponential backtracking otherwise). A single element
// with a trailing comma — `( e , )` — is not a tuple (spec: tuples need >= 2).
paren_or_tuple = { "(" ~ expression ~ ("," ~ expression ~ ("," ~ expression)* ~ ","?)? ~ ")" }

list_literal = { "[" ~ (list_element ~ ("," ~ list_element)* ~ ","?)? ~ "]" }
list_element = { spread | expression }
spread = { "..." ~ expression }

brace_map = { "{" ~ (map_field ~ ("," ~ map_field)* ~ ","?)? ~ "}" }
map_field = { spread | identifier ~ ":" ~ expression }

// `self` is a keyword, but inside a method body it is an ordinary name
// (spec: expressions/path-and-access.md — "self is an ordinary name").
self_expression = { kw_self }
identifier_expression = { identifier }

// ============================================================
// 9. Patterns
// ============================================================

pattern = { pattern_alt ~ ("|" ~ pattern_alt)* }
pattern_alt = {
      range_pattern
    | variant_pattern
    | struct_pattern
    | type_pattern
    | paren_pattern
    | literal_pattern
    | wildcard_binding
}
range_pattern = { number_literal ~ range_pat_op ~ number_literal }
range_pat_op = @{ "..<" | "..." }
literal_pattern = { number_literal | string_literal | boolean_literal | null_literal }
variant_pattern = { identifier ~ "::" ~ identifier ~ ("(" ~ pattern_list? ~ ")")? }
struct_pattern = { identifier ~ "(" ~ pattern_list? ~ ")" }
type_pattern = { pattern_type ~ pattern_binder }
pattern_binder = { wildcard_us | identifier }
wildcard_us = @{ "_" ~ !ident_part }
pattern_type = { identifier ~ "?"? ~ ("|" ~ identifier ~ "?"?)* }
pattern_list = { pattern ~ ("," ~ pattern)* }
paren_pattern = { "(" ~ pattern ~ ")" }
wildcard_binding = { identifier }
