// Readiness probe L19 (§5.1): `Result`/`Error` and `?` propagation.
// @expect
// 42
// bad input
// caught
fn parse(v: int): Result<int, Error> {
    if v < 0 {
        return Result::Err(Error("bad input"))
    }
    Result::Ok(v)
}

fn double(v: int): Result<int, Error> {
    let x = parse(v)?
    Result::Ok(x * 2)
}

fn main() {
    match double(21) {
        Result::Ok(v) => print(v)
        Result::Err(e) => print(e.message)
    }
    match double(-1) {
        Result::Ok(_) => print("ok")
        Result::Err(e) => print(e.message)
    }
    match double(-2) {
        Result::Ok(_) => print("ok")
        Result::Err(_) => print("caught")
    }
}
