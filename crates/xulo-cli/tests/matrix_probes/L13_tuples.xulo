// Readiness probe L13 (§5.1): tuple literals, positional access,
// destructuring, positional writes through `let mut`, and structural
// equality for tuples, lists, and structs.
// @expect
// 10
// ten
// 10
// ten
// 9 2
// true
// true
// false
// true
struct P { x: int, y: int }
fn main() {
    let p: (int, string) = (10, "ten")
    print(p.0)
    print(p.1)
    let (a, b) = p
    print(a)
    print(b)
    let mut q = (1, 2)
    q.0 = 9
    print(q.0, q.1)
    print((1, 2) == (1, 2))
    print([1, 2] == [1, 2])
    print([1, 2] != [1, 2])
    print(P(x: 1, y: 2) == P(x: 1, y: 2))
}
