// Readiness probe L13 (§5.1): tuple literals, positional access,
// destructuring, and positional writes through `let mut`.
//
// Equality is deliberately absent: stage 0 compares `List`/tuple/`struct`
// values by identity rather than structurally, so `(1, 2) == (1, 2)` is
// `false` even though the spec requires element-wise comparison. L13 is
// PARTIAL for that reason; compare elements individually as the workaround.
// @expect
// 10
// ten
// 10
// ten
// 9 2
fn main() {
    let p: (int, string) = (10, "ten")
    print(p.0)
    print(p.1)
    let (a, b) = p
    print(a)
    print(b)
    let mut q = (1, 2)
    q.0 = 9
    print(q.0, q.1)
}
