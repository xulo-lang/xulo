// Readiness probe L4 (§5.1): `let`, `let mut`, assignment, and shadowing in a
// nested block (a second `let` for the same name in one block is E0203 by
// spec, so shadowing is exercised where it is legal).
// @expect
// 1 3
// 100
// 1
// 6
fn main() {
    let a = 1
    let mut b = 2
    b = b + a
    print(a, b)
    if b > 0 {
        let a = 100
        print(a)
    }
    print(a)
    let mut x = 0
    let mut y = 0
    x = 3
    y = x * 2
    print(y)
}
