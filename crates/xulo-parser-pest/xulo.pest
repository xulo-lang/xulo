// Xulo Language Grammar (PEG) - pest.rs implementation
// Based on the grammar.mdx specification

// ============================================================
// 0. Document Root
// ============================================================

program = _{ SOI ~ (declaration | statement)* ~ EOI }

declaration = { fn_decl | struct_decl | enum_decl | trait_decl
    | impl_decl | type_alias | export_decl | import_stmt }

// ============================================================
// 1. Comments & Whitespace
// ============================================================

comment = _{ "//" ~ (!newline ~ ANY)* | "/*" ~ (!"*/" ~ ANY)* ~ "*/" }
WHITESPACE = _{ (" " | "\t" | "\n" | "\r" | comment)+ }

// ============================================================
// 2. Identifiers & Literals
// ============================================================

identifier = @{ (letter | "_") ~ (letter | digit | "_")* }
type_identifier = @{ uppercase_letter ~ (letter | digit | "_")* }

string_literal = @{ "\"" ~ (!"\"" ~ char)* ~ "\"" }
number_literal = @{ digit+ ~ ("." ~ digit+)? }
boolean_literal = { "true" | "false" }
null_literal = { "null" }

letter = { 'a'..'z' | 'A'..'Z' }
uppercase_letter = { 'A'..'Z' }
digit = { '0'..'9' }
newline = @{ "\n" | "\r\n" | "\r" }

char = { escape | !("\"" | "\\") ~ ANY }
escape = @{ "\\" ~ ("n" | "r" | "t" | "\\" | "\"") }

// ============================================================
// 3. Types
// ============================================================

type_expr = { type_intersection }
type_intersection = { type_union ~ ("&" ~ type_union)* }
type_union = { type_optional ~ ("|" ~ type_optional)* }
type_optional = { type_primary ~ "?"? }
type_primary = { type_atom ~ ("<" ~ type_list ~ ">")? }

type_atom = { "string" | "number" | "int" | "float" | "boolean" | "null"
    | "void"
    | "i8" | "i16" | "i32" | "i64"
    | "u8" | "u16" | "u32" | "u64"
    | "f32" | "f64"
    | type_identifier
    | "(" ~ type_expr ~ ")"
    | "{" ~ field_list? ~ "}"
    | "fn" ~ "(" ~ type_list? ~ ")" ~ (":" ~ type_expr)?
}

type_list = { type_expr ~ ("," ~ type_expr)* ~ ","? }

field_list = { field_def ~ ("," ~ field_def)* ~ ","? }
field_def = { identifier ~ ":" ~ type_expr }

// ============================================================
// 4. Declarations
// ============================================================

// Export declaration
export_decl = { "export" ~ (fn_decl | struct_decl | enum_decl | trait_decl | type_alias) }

// Function declaration
fn_decl = { "async"? ~ "fn" ~ identifier ~ type_params? ~ "(" ~ param_list? ~ ")"
    ~ (":" ~ type_expr)? ~ block }
param_list = { param_def ~ ("," ~ param_def)* ~ ","? }
param_def = { "self" | identifier ~ ":" ~ type_expr ~ "?"? ~ ("=" ~ expression)? }

type_params = { "<" ~ type_param ~ ("," ~ type_param)* ~ ">" }
type_param = { identifier }

// Struct declaration
struct_decl = { "struct" ~ identifier ~ type_params? ~ "{" ~ field_list? ~ "}" }
field_decl = { "pub"? ~ identifier ~ ":" ~ type_expr }

// Enum declaration
enum_decl = { "enum" ~ identifier ~ type_params? ~ "{" ~ enum_variant_list? ~ "}" }
enum_variant_list = { enum_variant ~ ("," ~ enum_variant)* ~ ","? }
enum_variant = { identifier ~ ("(" ~ type_list ~ ")")? }

// Trait declaration
trait_decl = { "trait" ~ identifier ~ "{" ~ trait_method* ~ "}" }
trait_method = { "fn" ~ identifier ~ "(" ~ param_list? ~ ")" ~ ":" ~ type_expr ~ ";" }

// Impl declaration (two forms)
impl_decl = { "impl" ~ identifier ~ "for" ~ type_expr ~ "{" ~ fn_decl* ~ "}"
    | "impl" ~ type_expr ~ "{" ~ fn_decl* ~ "}" }

// Type alias
type_alias = { "type" ~ identifier ~ type_params? ~ "=" ~ type_expr }

// ============================================================
// 5. Statements
// ============================================================

statement = { variable_decl | assignment_stmt | if_expr | for_stmt | while_stmt
    | return_stmt | try_stmt | throw_stmt | component_stmt | expression_stmt }

block = { "{" ~ statement* ~ "}" }

variable_decl = { "let" ~ "mut"? ~ identifier ~ (":" ~ type_expr)? ~ "=" ~ expression }
assignment_stmt = { postfix_expr ~ "=" ~ expression }
expression_stmt = { expression ~ ";"? }
return_stmt = { "return" ~ expression? }
throw_stmt = { "throw" ~ expression }

// ============================================================
// 6. Expressions
// ============================================================

expression = { ternary }

ternary = { logical_or ~ ("?" ~ expression ~ ":" ~ expression)? }
logical_or = { logical_and ~ ("or" ~ logical_and)* }
logical_and = { comparison ~ ("and" ~ comparison)* }
comparison = { addition ~ (("<" | ">" | "<=" | ">=" | "==" | "!=" | "..<") ~ addition)* }
addition = { multiplication ~ (("+" | "-") ~ multiplication)* }
multiplication = { unary ~ (("*" | "/") ~ unary)* }
unary = { ("!" | "-" | "await") ~ unary | postfix_expr }

postfix_expr = { primary ~ postfix_op* }
postfix_op = { "." ~ identifier
    | "[" ~ expression ~ "]"
    | "(" ~ arg_list? ~ ")"
}

primary = { if_expr
    | match_expr
    | fn_expr
    | number_literal
    | string_literal
    | boolean_literal
    | null_literal
    | "(" ~ expression ~ ")"
    | "[" ~ expression_list? ~ "]"
    | "{" ~ field_init_list? ~ "}"
    | identifier
}

if_expr = { "if" ~ expression ~ block ~ ("else" ~ (block | if_expr))? }
match_expr = { "match" ~ expression ~ "{" ~ match_arm ~ ("," ~ match_arm)* ~ ","? ~ "}" }

fn_expr = { "async"? ~ "fn" ~ "(" ~ param_list? ~ ")"
    ~ (":" ~ type_expr)? ~ block }

// ============================================================
// 7. Call Arguments & Field Initializers
// ============================================================

arg_list = { arg ~ ("," ~ arg)* ~ ","? }
arg = { identifier ~ ":" ~ expression | expression }

expression_list = { expression ~ ("," ~ expression)* ~ ","? }

field_init_list = { field_init ~ ("," ~ field_init)* ~ ","? }
field_init = { identifier ~ ":" ~ expression | "..." ~ expression }

// ============================================================
// 8. Match Patterns
// ============================================================

match_arm = { match_pattern ~ "=>" ~ expression }
match_pattern = { "_"
    | string_literal
    | number_literal
    | boolean_literal
    | type_identifier ~ "::" ~ identifier ~ ("(" ~ (identifier ~ ("," ~ identifier)*)? ~ ")")?
    | identifier
}

// ============================================================
// 9. UI Component Block
// ============================================================

component_stmt = { component_call ~ component_block }
component_block = { "{" ~ ui_element* ~ "}" }

ui_element = { component_stmt
    | identifier ~ ":" ~ expression
    | string_literal
    | if_expr
    | for_stmt
    | "{" ~ ui_element* ~ "}"
}

component_call = { identifier ~ type_args? ~ ("(" ~ arg_list? ~ ")")? }
type_args = { "<" ~ type_expr ~ ("," ~ type_expr)* ~ ">" }

// ============================================================
// 10. Control Flow (used in statements and UI blocks)
// ============================================================

for_stmt = { "for" ~ identifier ~ "in" ~ expression ~ block }
while_stmt = { "while" ~ expression ~ block }
try_stmt = { "try" ~ block ~ "catch" ~ "(" ~ identifier ~ ")" ~ block }

// ============================================================
// 11. State / Store / Effect (Xulo-specific)
// ============================================================

state_stmt = { "@State" ~ ("let" | "const") ~ "mut"? ~ identifier ~ ":" ~ type_expr ~ ("=" ~ expression)? }
store_stmt = { "@Store" ~ "const"? ~ binding_pattern ~ "=" ~ expression }
effect_stmt = { "@Effect" ~ fn_expr ~ ("," ~ "[" ~ expression_list? ~ "]")? }

binding_pattern = { identifier | "{" ~ (binding_field ~ ("," ~ binding_field)* ~ ","?)? ~ "}" }
binding_field = { identifier ~ (":" ~ identifier)? }

// ============================================================
// 12. Import (Xulo-specific)
// ============================================================

import_stmt = { "import" ~ "type"? ~ import_spec ~ ("from" ~ string_literal)?
    | "import" ~ "type"? ~ string_literal }

import_spec = { "*" ~ "as" ~ identifier
    | "{" ~ import_name_list ~ "}"
    | identifier ~ "as" ~ identifier }

import_name_list = { import_name ~ ("," ~ import_name)* ~ ","? }
import_name = { identifier ~ ("as" ~ identifier)? }
