// Xulo 运行时基准：递归调用、整数循环、列表 push、StringBuilder 追加。
// 解释器：xulo run benchmarks/bench.xulo
// AOT：cd benchmarks && xupm build --release && ./.xupm/build/xulo-benchmarks
// 与 Rust 版一致用 std::hint::black_box 阻止 AOT 把纯计算循环常量折叠。
fn fib(n: number): number {
    if n < 2 {
        n
    } else {
        fib(n - 1) + fib(n - 2)
    }
}

fn sum_loop(n: number): number {
    let mut sum = 0
    let mut i = 0
    while i < n {
        sum = std::hint::black_box(sum + std::hint::black_box(i))
        i = i + 1
    }
    sum
}

fn list_work(n: number): number {
    let mut xs = []
    let mut i = 0
    while i < n {
        xs.push(std::hint::black_box(i))
        i = i + 1
    }
    xs.len
}

fn string_work(n: number): number {
    let mut b = StringBuilder::new()
    let mut i = 0
    while i < n {
        b.append("x")
        i = i + 1
    }
    b.build().len
}

fn report(name: string, start: number, result: number) {
    let elapsed_ms = (std::time::monotonic_nanos() - start) / 1000000.0
    print(`${name}: ${elapsed_ms} ms (${result})`)
}

fn main() {
    print("xulo benchmark")

    let fib_start = std::time::monotonic_nanos()
    let fib_result = fib(std::hint::black_box(30))
    report("fib(30)", fib_start, fib_result)

    let sum_start = std::time::monotonic_nanos()
    let sum_result = sum_loop(std::hint::black_box(5000000))
    report("sum_loop(5M)", sum_start, sum_result)

    let list_start = std::time::monotonic_nanos()
    let list_result = list_work(std::hint::black_box(1000000))
    report("list_work(1M)", list_start, list_result)

    let string_start = std::time::monotonic_nanos()
    let string_result = string_work(std::hint::black_box(5000))
    report("string_work(5000)", string_start, string_result)
}
