{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"]
  ],
  "wordPattern": "(-?\\d*\\.\\d+\\w*)|([A-Za-z_][A-Za-z0-9_]*)",
  "indentationRules": {
    "increaseIndentPattern": "(^\\s*else\\b)|([\\{\\[(][^\\}\\)\\]\\\"'`]*)$",
    "decreaseIndentPattern": "^\\s*[\\}\\)\\]]"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*/\\*(?!\\*/)",
      "action": { "indentAction": "none", "appendText": " * " }
    },
    {
      "beforeText": "^\\s*\\*(?!/)",
      "action": { "indentAction": "none", "appendText": " * " }
    },
    {
      "beforeText": "^\\s*\\*/",
      "action": { "indentAction": "none", "removeText": 1 }
    }
  ]
}
