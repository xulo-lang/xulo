// 内联模块：`mod name { ... }`、`use self::...`、`use` 分组、`pub use`
//
// - `mod inner { ... }` 在同一个文件里声明一个模块
// - `use self::inner as i` 给模块起别名；`use inner::{hi}` 引入成员
// - `pub use { hi }` 把引入的名字重新导出
// - `pub fn` / `pub const` 才能被模块外使用
mod inner {
    pub fn hi(): string {
        "hi"
    }

    pub const K: int = 2

    pub fn twice(n: int): int {
        n * 2
    }
}

mod tools {
    pub fn tool(): string {
        "tool"
    }
}

use self::inner as i;
use inner::{hi};
use tools::*;

pub use { hi };

fn main() {
    print(i::hi())
    print(inner::K)
    print(hi())
    print(inner::twice(i::K))

    // glob 导入把 `tools` 的公开名字直接带进当前作用域
    print(tool())
}
