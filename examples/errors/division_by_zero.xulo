// 除零：整数除以零是运行时失败，不是编译错误
//
// - `x / 0` 在 check 阶段通过，运行时以 `error[E0006] runtime: ... division by zero`
//   终止，退出码为 1
// - 失败信息写在 stderr；解释器收集的 stdout 在失败路径上不会写出
//
// @aot-failure-shape all: 两条路径的失败格式不同（解释器带源码片段并丢弃
// stdout，原生路径流式写出 stdout），差分只比较失败形态：都非零退出、运行时
// 消息一致；stdout 不比较（T13 选项 c）
// @panic division by zero

fn main() {
    print("before")
    let zero = 0
    print(10 / zero)
    print("never reached")
}
