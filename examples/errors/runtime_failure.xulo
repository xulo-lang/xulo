// 运行时失败：`panic` 终止程序并写出原因
//
// - `panic("文本")` 是表达式，可以在任意表达式位置终止当前程序
// - 诊断以 `error[E0006] runtime: ...` 写到 stderr，退出码为 1
// - 解释器把 `print` 的输出收集到程序正常结束才写出，所以失败路径上只有诊断
//
// @aot-failure-shape all: 两条路径的失败格式不同（解释器带源码片段并丢弃
// stdout，原生路径流式写出 stdout），差分只比较失败形态：都非零退出、运行时
// 消息一致；stdout 不比较（T13 选项 c）
// @panic cannot continue

fn check(ok: bool) {
    if ok {
        return
    }
    panic("cannot continue")
}

fn main() {
    print("before")
    check(false)
    print("never reached")
}
