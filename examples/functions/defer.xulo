// `defer`：把表达式或块登记到「离开当前块」时执行
//
// - `defer e` 与 `defer { ... }` 都合法；值被丢弃
// - 离开块时按登记顺序的逆序执行（后进先出）
// - 函数提前 `return`、循环里 `break`/`continue` 都会触发当前块的 defer

fn work(): int {
    defer print("defer 1")
    defer {
        print("defer 2")
    }
    print("body")
    7
}

fn early(flag: bool): int {
    defer print("early defer")
    if flag {
        print("returning early")
        return 1
    }
    print("falling through")
    2
}

fn main() {
    print(work())
    print(early(true))
    print(early(false))

    // 循环体是一个块：每次迭代结束都会跑一次 defer
    for i in 0..<3 {
        defer print(`iteration ${i} done`)
        print(`iteration ${i}`)
    }
}
