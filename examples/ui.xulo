// UI 组件示例：@State / @Effect / 组件块 / $ 绑定
import { Screen, VStack, HStack, Text, Button, Input } from "@xulo/ui"

fn Counter(): View {
    @State let count: number = 0
    @Effect fn() { print("mounted") }

    VStack(spacing: 8) {
        Text("Count: " + str(count), color: "#302d2d", fontSize: 20)
        HStack(spacing: 4) {
            Button(onClick: fn() { count = count + 1 }) {
                Text("+")
            }
            Button(onClick: fn() { count = count - 1 }) {
                Text("-")
            }
        }
    }
}

fn NameField(): View {
    @State let name: string = ""

    VStack {
        Input(value: $name)
        Text("Hello, " + name, color: "#333", fontSize: 16)
    }
}

fn main(): View {
    Screen(orientation: "portrait", backgroundColor: "#f0f0f0") {
        Counter()
        NameField()
        Text("Welcome!", color: "#ff6b6b")
    }
}
