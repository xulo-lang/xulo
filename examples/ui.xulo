// UI 组件示例：@State / @Effect / 组件块 / $ 绑定
import { Screen, VStack, HStack, Text, Button, Input } from "@xulo/ui"

fn Counter(): View {
    @State let count: number = 0
    @Effect fn() { print("mounted") }

    VStack(spacing: 1) {
        Text("Count: " + str(count))
        HStack(spacing: 2) {
            Button(onClick: fn() { count = count + 1 }) {
                Text("+")
            }
            Button(onClick: fn() { count = count - 1 }) {
                Text("-")
            }
        }
    }
}

fn NameField(): View {
    @State let name: string = ""

    VStack(spacing: 1) {
        Input(value: $name,width: 200, placeholder: "Enter your name")
        Text("Hello, " + name)
    }
}

fn main(): View {
    Screen(backgroundColor: "#101010") {
        Counter()
        NameField()
        Text("Welcome!", color: "#ff6b6b")
    }
}
