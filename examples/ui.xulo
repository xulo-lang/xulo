// UI 组件示例：样式系统 — Flex 布局 / Fill / justify / alignment
use ui::{Screen, VStack, HStack, Fill, Text, Button, Input};

fn Counter(): View {
    @State let count: Number = 0
    @Effect fn() { print("mounted") }

    VStack(spacing: 2, padding: 4, bg: "#1a1a2e", radius: 4) {
        Text("Counter", color: "#8892b0", size: 14)
        Text("Count: " + str(count), color: "#ccd6f6", size: 18)
        HStack(spacing: 3, alignment: "center") {
            Button(onClick: fn() { count = count + 1 }, bg: "#4a90d9", color: "#ffffff", radius: 3, padding: 2) {
                Text("+")
            }
            Button(onClick: fn() { count = count - 1 }, bg: "#d94a4a", color: "#ffffff", radius: 3, padding: 2) {
                Text("-")
            }
            Button(onClick: fn() { count = 0 }, bg: "#555555", color: "#aaaaaa", radius: 3, padding: 2) {
                Text("Reset")
            }
        }
    }
}

fn NameField(): View {
    @State let name: String = ""

    VStack(spacing: 2, padding: 4, bg: "#16213e", radius: 4) {
        Text("Name", color: "#8892b0", size: 14)
        Input(value: $name, width: 200, placeholder: "Enter your name", bg: "#0f3460", border: "#4a90d9", radius: 2, padding: 2)
        Text("Hello, " + name, color: "#e94560", size: 16)
    }
}

fn Header(): View {
    VStack(spacing: 1, padding: 6, bg: "#0a0a1a", alignment: "center") {
        Text("Xulo UI Demo", color: "#e94560", size: 20, weight: "bold")
        Text("Component Styling Showcase", color: "#533483", size: 12)
    }
}

fn Footer(): View {
    HStack(padding: 3, bg: "#0a0a1a", alignment: "center", justify: "center") {
        Text("Built with Xulo", color: "#555555", size: 10)
    }
}

fn main(): View {
    Screen(bg: "#0a0a1a") {
        VStack(height: 24, justify: "space-between") {
            Header()
            Fill {
                VStack(spacing: 4, padding: 4) {
                    Counter()
                    NameField()
                }
            }
            Footer()
        }
    }
}
