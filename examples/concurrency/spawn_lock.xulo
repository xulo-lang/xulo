// 并发：`spawn` 的五种形式、`shared` 绑定、`lock`、service
//
// - `spawn async { ... }`：默认调度；`spawn.thread` / `spawn.process` 指定模式
// - `spawn.on(目标) async { ... }` 交给给定目标
// - `spawn.process Type { 字段: 值 }` 启动一个 service，用 `.send` / `.stop` 交互
// - `shared` 只出现在绑定与参数位置；`lock` 保护对共享绑定的访问
// - `await` 取得任务结果；`Task::all` / `Task::race` 组合任务
//
// @no-aot all: AOT 后端尚未下降 `spawn` / `lock` / service

fn work(id: int): int {
    id * 2
}

fn bump(state: shared number) {
    lock state {
        print(state)
    }
}

struct Tally {
    total: number
}

impl Tally {
    fn on_message(mut self, cmd: number) {
        self.total = self.total + cmd
        reply(self.total)
    }
}

async fn main() {
    // 默认目标
    let job = spawn async { work(1) }
    print(await job)

    // 指定线程 / 进程
    let thread_job = spawn.thread async { work(2) }
    print(await thread_job)
    let process_job = spawn.process async { work(3) }
    print(await process_job)

    // 指定调度目标
    let on_job = spawn.on("worker") async { work(4) }
    print(await on_job)

    // 组合任务
    print(await Task::all([work(5), work(6)]))
    print(await Task::resolve("ready"))

    // 共享绑定与 lock
    let counter = shared 0
    lock counter {
        print(counter)
    }
    bump(counter)

    // service：状态由 service 自己持有，send 返回 handler 的 reply
    let worker = spawn.process Tally { total: 0 }
    print(await worker.send(10))
    print(await worker.send(5))
    worker.stop()
}
