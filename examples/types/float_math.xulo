// 浮点算术：`f32` 与 `f64` 标注的常量与混合运算
//
// - 定宽浮点标注可参与算术语，打印形态与 `number` 的浮点一致
// - 两个执行路径目前都按 double 计算，`f32` 的单精度语义尚未落地（见
//   `examples/README.md` 的已知缺口）

fn main() {
    let single: f32 = 0.5
    let double: f64 = 2.5
    print(single * 4.0)
    print(double * 2.0)
    print(single + single)
    print(double / 2.0)
    print(single < 1.0)
}
