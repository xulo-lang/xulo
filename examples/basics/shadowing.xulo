// 遮蔽（shadowing）：嵌套作用域里的同名绑定是新的绑定
//
// - 同一作用域重复声明同名绑定是 `E0003`；遮蔽只发生在嵌套块里
// - 内层块结束后，外层绑定恢复可见，值不受内层影响
//
// @no-aot all: AOT 下降把内层 `let` 写成对外层绑定的赋值，遮蔽会泄漏到外层（待修）

fn main() {
    let name = "xulo"
    print(name)

    // 内层块声明新的 `name`：只在这个块里可见
    if name == "xulo" {
        let name = name + "!"
        print(name)
    }

    // 外层绑定没有变
    print(name)

    // 值类型也遵循同样的规则
    let mut total = 1
    for _ in 0..<2 {
        let total = total + 10
        print(total)
    }
    print(total)
}
