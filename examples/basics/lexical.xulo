// 词法：注释、数字字面量、字符串与模板、绑定简写、连续赋值、下标赋值
//
// - `//` 行注释、`/* ... */` 块注释（不嵌套）、`///` 与 `//!` 文档注释都是
//   trivia，不属于语法树
// - 整数支持十进制、`0x` 十六进制、`0b` 二进制、`0o` 八进制；浮点必须带小数点
//   （`1.0`，没有指数形式）
// - 单引号与双引号字符串等价，转义序列相同；反引号是模板，`${...}` 插值，
//   `\${` 表示字面的 `${`
// - `let x := e` 是「按初始值推断类型」的简写
// - 赋值是右结合的：`a = b = c` 先给 `b` 赋值，再把 `b` 的值给 `a`

/* 块注释：可以跨行，但不支持嵌套。 */
/// 文档注释：描述紧随其后的声明（对运行没有影响）。
fn offset(base: int): int {
    base + 1
}

fn main() {
    print(offset(41))

    // 四种进制的整数字面量
    print(0xff, 0b1010, 0o17, 42)

    // 浮点字面量
    print(1.5, 2.0, 1000.0)

    // 单引号 / 双引号 / 引号转义
    print('single', "double", "it's", 'say "hi"')

    // 常用转义
    print("tab\there", "quote\"q", "backslash\\", "line\nbreak")

    // Unicode 转义：`\u{...}` 接受 1–6 位十六进制码位
    print("\u{41}\u{1F44B}")

    // 模板：插值可以是任意表达式，也可以嵌套模板
    print(`one ${1 + 1} two ${offset(1)}`)
    print(`nested ${`inner ${2 * 3}`}`)
    print(`escaped \${not_interpolated}`)

    // `:=` 简写
    let inferred := 7;
    print(inferred);

    // `;` 是可选的语句终止符：换行与 `;` 可以混用
    let mut a = 0;
    let mut b = 0;
    a = b = 3
    print(a, b)

    // 下标赋值需要一个可变 place
    let mut xs = [0, 0]
    xs[1] = 9
    print(xs)
}
