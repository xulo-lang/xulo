// for 的四种迭代：闭合/半开区间、列表、嵌套、break/continue
fn main() {
    // 闭合区间 1...5（两端都包含）
    for index in 1...5 {
        print(`${index} times 5 is ${index * 5}`)
    }

    // 半开区间 0..<3（不含右端）
    for i in 0..<3 {
        print(`half-open ${i}`)
    }

    // 迭代列表
    for word in ["a", "b", "c"] {
        print(word)
    }

    // 嵌套循环 + break/continue
    for row in 1...3 {
        for col in 1...3 {
            if row == col { continue }
            if row * col > 4 { break }
            print(`${row}x${col}`)
        }
    }
}
