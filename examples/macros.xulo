// 宏系统：函数宏 name!、派生宏 #[derive]、属性宏 #[name]
// （spec builtins/execution.md；宏体是普通 Xulo 代码，编译期在沙箱中运行）

#[macro(kind = "function", name = "answer")]
fn answer_macro(input: ast::FunctionInput): Result<ast::FunctionOutput, ast::MacroFailure> {
    return Result::Ok(ast::FunctionOutput(expr: (ast::quote! { 6 * 7 })[0]))
}

trait Model {
    fn model(self): int
}

#[macro(kind = "derive", target = Model)]
fn derive_model(input: ast::DeriveInput): Result<ast::DeriveOutput, ast::MacroFailure> {
    return Result::Ok(ast::DeriveOutput(items: ast::quote! {
        impl Model for ${input.target.name} {
            fn model(self): int { 99 }
        }
    }))
}

#[derive(Debug, Model)]
struct Widget {
    id: int
}

#[macro(kind = "attribute", name = "with_banner")]
fn banner_macro(input: ast::AttributeInput): Result<ast::AttributeOutput, ast::MacroFailure> {
    return Result::Ok(ast::AttributeOutput(
        item: input.target.node,
        extras: ast::quote! { fn banner(): string { "macro" } }
    ))
}

#[with_banner]
fn main() {
    print(answer!())
    print(Widget(id: 1).model())
    print(banner())
}
