// Stage 1 command line.
//
// Two ways to choose the input, because `xulo run <file>` does not forward
// script arguments:
//
//   * compiled binary:  xuloc tokens <file>
//                       xuloc parse  <file>
//   * under `xulo run`: set XULO_STAGE1_MODE=tokens|parse and
//                       XULO_STAGE1_FILE=<file>
//
// The default mode is `parse`. Diagnostics go to stderr in the stage 0 shape
// `<file>:<line>:<column>: error: <message>` and the process exits 1.

mod ast;
mod checker;
mod lexer;
mod parser;
mod backend;

use ast::{render};
use backend::{compile, BuildResult, base_of, dir_of, join_path, stem_of};
use checker::{check, CheckResult};
use lexer::{lex, LexResult, Token};
use parser::{parse, ParseResult};

struct CcRun {
    code: number,
    output: string,
}

fn make_dir(path: string) {
    match std::fs::mkdir(path) {
        Result::Ok(_) => {}
        Result::Err(error) => {
            std::io::eprintln("xuloc: cannot create " + path + ": " + error.message)
            std::process::exit(1)
        }
    }
}

fn cc_args(runtime_path: string, c_path: string, binary: string): List<string> {
    let mut args: List<string> = [
        "-std=c11",
        "-O1",
        "-w",
        "-I",
        dir_of(runtime_path),
        "-o",
        binary,
        c_path,
    ]
    if std::os::platform() != "windows" {
        args.push("-lm")
    }
    if std::os::platform() == "windows" {
        args.push("-Wl,/STACK:67108864")
    }
    return args
}

fn run_cc(compiler: string, runtime_path: string, c_path: string, binary: string): CcRun {
    match std::process::exec(compiler, cc_args(runtime_path, c_path, binary)) {
        Result::Ok(run) => {
            return CcRun(code: run.code, output: run.stdout + run.stderr)
        }
        Result::Err(error) => {
            return CcRun(code: -1, output: error.message)
        }
    }
}

fn run_build(file: string, source: string) {
    let lexed: LexResult = lex(source)
    if lexed.error != "" {
        fail(file, lexed.line, lexed.column, "E0001", lexed.error)
    }
    let parsed: ParseResult = parse(lexed.tokens)
    if parsed.error != "" {
        fail(file, parsed.line, parsed.column, "E0002", parsed.error)
    }
    let runtime_path = env_or("XULO_STAGE1_RUNTIME", "xuloc/runtime.c")
    let built: BuildResult = compile(parsed.root, file, base_of(runtime_path))
    if !built.ok {
        fail(file, 1, 1, "E0005", built.message)
    }
    let dir = dir_of(file)
    let work = join_path(join_path(dir, ".xupm"), "build")
    make_dir(join_path(dir, ".xupm"))
    make_dir(work)
    let mut c_path = env_or("XULO_STAGE1_C", "")
    if c_path == "" {
        c_path = join_path(work, stem_of(file) + ".c")
    }
    match std::fs::write(c_path, built.source) {
        Result::Ok(_) => {}
        Result::Err(error) => {
            fail(file, 1, 1, "E0005", "cannot write " + c_path + ": " + error.message)
        }
    }
    let mut binary = env_or("XULO_STAGE1_OUT", "")
    if binary == "" {
        binary = join_path(work, stem_of(file))
        if std::os::platform() == "windows" {
            binary = binary + ".exe"
        }
    }
    let mut compiler = env_or("XULO_CC", "")
    let explicit = compiler != ""
    if compiler == "" {
        compiler = "clang"
    }
    let mut candidates: List<string> = [compiler]
    if !explicit {
        if compiler == "clang" {
            candidates.push("cc")
        }
        if std::os::platform() == "windows" {
            candidates.push("C:\\Program Files\\LLVM\\bin\\clang.exe")
        }
    }
    let mut index = 0
    let mut chosen = compiler
    let mut compiled = CcRun(code: -1, output: "no C compiler was tried")
    while index < candidates.len {
        chosen = candidates[index]
        compiled = run_cc(chosen, runtime_path, c_path, binary)
        if compiled.code == 0 {
            break
        }
        index = index + 1
    }
    if compiled.code != 0 {
        fail(
            file,
            1,
            1,
            "E0005",
            "the C compiler `" + chosen + "` failed:\n" + compiled.output,
        )
    }
    print(binary)
}

fn env_or(name: string, fallback: string): string {
    match std::os::getenv(name) {
        Result::Ok(value) => {
            return value ?? fallback
        }
        Result::Err(_) => {
            return fallback
        }
    }
}

fn usage() {
    std::io::eprintln("usage: xuloc <tokens|parse|check|build> <file>")
    std::io::eprintln("   or: XULO_STAGE1_MODE=tokens|parse|check|build XULO_STAGE1_FILE=<file> xulo run xuloc/main.xulo")
}

fn kind_label(code: string): string {
    if code == "E0001" {
        return "lexical"
    }
    if code == "E0002" {
        return "syntax"
    }
    if code == "E0004" {
        return "io"
    }
    if code == "E0005" {
        return "codegen"
    }
    return "semantic"
}

fn fail(file: string, line: number, column: number, code: string, message: string) {
    std::io::eprintln(
        file + ":" + str(line) + ":" + str(column) + ": error[" + code + "] " + kind_label(code) + ": " + message,
    )
    std::process::exit(1)
}

fn print_tokens(tokens: List<Token>) {
    for token in tokens {
        let mut out = StringBuilder::new()
        out.append(str(token.line))
        out.append(":")
        out.append(str(token.column))
        out.append(" ")
        out.append(token.kind)
        out.append(" ")
        out.append(str(token.start))
        out.append(":")
        out.append(str(token.end))
        out.append(" ")
        out.append(token.text)
        print(out.build())
    }
}

fn run_tokens(file: string, source: string) {
    let result: LexResult = lex(source)
    if result.error != "" {
        fail(file, result.line, result.column, "E0001", result.error)
    }
    print_tokens(result.tokens)
}

fn run_check(file: string, source: string) {
    let lexed: LexResult = lex(source)
    if lexed.error != "" {
        fail(file, lexed.line, lexed.column, "E0001", lexed.error)
    }
    let parsed: ParseResult = parse(lexed.tokens)
    if parsed.error != "" {
        fail(file, parsed.line, parsed.column, "E0002", parsed.error)
    }
    let result: CheckResult = check(parsed.root)
    if !result.ok {
        fail(file, result.line, result.column, result.code, result.message)
    }
    print("no errors")
}

fn run_parse(file: string, source: string) {
    let lexed: LexResult = lex(source)
    if lexed.error != "" {
        fail(file, lexed.line, lexed.column, "E0001", lexed.error)
    }
    let result: ParseResult = parse(lexed.tokens)
    if result.error != "" {
        fail(file, result.line, result.column, "E0002", result.error)
    }
    print(render(result.root, 0))
}

fn main() {
    let args = std::process::args()
    let mut mode = env_or("XULO_STAGE1_MODE", "parse")
    let mut file = env_or("XULO_STAGE1_FILE", "")
    if args.len >= 3
        and (args[1] == "tokens" or args[1] == "parse" or args[1] == "check" or args[1] == "build")
    {
        mode = args[1]
        file = args[2]
    }
    if file == "" {
        usage()
        std::process::exit(1)
    }
    if mode != "tokens" and mode != "parse" and mode != "check" and mode != "build" {
        usage()
        std::process::exit(1)
    }
    match std::fs::read(file) {
        Result::Ok(source) => {
            if mode == "tokens" {
                run_tokens(file, source)
            } else if mode == "check" {
                run_check(file, source)
            } else if mode == "build" {
                run_build(file, source)
            } else {
                run_parse(file, source)
            }
        }
        Result::Err(error) => {
            fail(file, 1, 1, "E0004", "cannot read file: " + error.message)
        }
    }
}
