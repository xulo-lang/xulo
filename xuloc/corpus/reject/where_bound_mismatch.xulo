trait Area {
    fn area(self): number
}

struct Sq {
    side: number
}

impl Area for Sq {
    fn area(self): number { self.side * self.side }
}

struct Other {
    x: number
}

fn scaled<T>(v: T): number where T: Area {
    Area::area(v)
}

fn main() {
    print(scaled(Sq(side: 2)))
    print(scaled(Other(x: 1)))
}
