// Gate 3: `T: Trait` bounds are checked at generic call sites.
trait Area {
    fn area(self): number
}

struct Sq {
    side: number
}

impl Area for Sq {
    fn area(self): number { self.side * self.side }
}

fn measure<T: Area>(v: T): number {
    Area::area(v)
}

fn scaled<T>(v: T): number where T: Area {
    Area::area(v) * 2
}

fn main() {
    let n: number = measure(Sq(side: 2))
    let m: number = scaled(Sq(side: 3))
    print(n, m)
}
