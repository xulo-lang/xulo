// Gate 3: generic functions, generic structs, and trait declarations.
trait Area {
    fn area(self): number
}

fn identity<T>(value: T): T {
    value
}

fn first<T>(list: List<T>): T {
    list[0]
}

fn twice<T>(value: T): List<T> {
    [value, value]
}

struct Palette<T> {
    items: List<T>
}

fn main() {
    let n: number = first([10, 20])
    let word: string = identity("x")
    let pair: List<number> = twice(7)
    print(identity(42))
    print(word)
    print(n)
    print(pair)
    let p = Palette(items: [1, 2, 3])
    print(p.items.len)
}
