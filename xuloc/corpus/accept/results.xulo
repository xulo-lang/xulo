// Gate 3: builtin `Result`/`Error`, typed `?` propagation, and payload matching.
fn parse(v: int): Result<int, Error> {
    if v > 0 {
        Result::Ok(v)
    } else {
        Result::Err(Error("negative"))
    }
}

fn doubled(v: int): Result<int, Error> {
    let value = parse(v)?
    Result::Ok(value * 2)
}

fn shifted(v: int): Result<int, Error> {
    let value: int = parse(v)?
    Result::Ok(value + 10)
}

fn main() {
    match shifted(2) {
        Result::Ok(v) => print(v)
        Result::Err(e) => print(e.message)
    }
    match doubled(2) {
        Result::Ok(v) => print(v)
        Result::Err(e) => print(e.message)
    }
    match doubled(0) {
        Result::Ok(v) => print(v)
        Result::Err(e) => print(e.message)
    }
}
