// Checker: diagnostics and lexical scopes.

use ast::Node;
use super::{Checker, Binding};

pub fn fail(ck: mut Checker, node: Node, code: string, message: string) {
    if ck.error == "" {
        ck.error = message
        ck.code = code
        ck.line = node.line
        ck.column = node.column
    }
    if code == "E0003" {
        ck.complete = false
    }
}

pub fn enter_scope(ck: mut Checker) {
    ck.scopes.push(ck.next_scope)
    ck.next_scope = ck.next_scope + 1
    ck.active_scopes = ck.active_scopes + 1
}

pub fn leave_scope(ck: mut Checker) {
    if ck.active_scopes > 0 {
        ck.active_scopes = ck.active_scopes - 1
    }
}

pub fn scope_active(ck: Checker, scope: number): bool {
    let mut i = 0
    while i < ck.active_scopes {
        if ck.scopes[i] == scope {
            return true
        }
        i = i + 1
    }
    return false
}

pub fn bind(ck: mut Checker, name: string, ty: string) {
    if name == "" or name == "_" {
        return
    }
    let scope = ck.scopes[ck.active_scopes - 1]
    ck.bindings.push(Binding(name: name, ty: ty, scope: scope))
}

pub fn lookup(ck: Checker, name: string): string {
    let mut i = ck.bindings.len
    while i > 0 {
        i = i - 1
        let binding = ck.bindings[i]
        if binding.name == name and scope_active(ck, binding.scope) {
            return binding.ty
        }
    }
    return ""
}
