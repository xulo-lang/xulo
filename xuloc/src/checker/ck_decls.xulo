// Checker: declaration collection and signature resolution.

use ast::Node;
use super::{Checker, FuncSig, MethodSig, ConstSig, FieldSig, StructSig, VariantSig, EnumSig, AliasSig};
use super::ck_util;
use super::ck_diag;
use super::ck_module;
use super::ck_types;

pub fn find_function_in(ck: Checker, module_id: string, name: string): number {
    let mut i = ck.functions.len
    while i > 0 {
        i = i - 1
        let sig = ck.functions[i]
        if sig.module_id == module_id and sig.name == name {
            return i
        }
    }
    return -1
}

pub fn find_method(ck: Checker, owner: string, name: string): number {
    let head = ck_types::type_head(owner)
    let mut i = ck.methods.len
    while i > 0 {
        i = i - 1
        if ck.methods[i].name == name
            and (ck.methods[i].owner == owner or ck.methods[i].owner == head)
        {
            return i
        }
    }
    return -1
}

pub fn find_method_in(ck: Checker, module_id: string, name: string): number {
    let mut i = ck.methods.len
    while i > 0 {
        i = i - 1
        if ck.methods[i].module_id == module_id and ck.methods[i].name == name {
            return i
        }
    }
    return -1
}

pub fn find_const_in(ck: Checker, module_id: string, name: string): number {
    let index = ck_module::module_index(ck, module_id)
    if index < 0 {
        return -1
    }
    let mut i = 0
    while i < ck.modules[index].consts.len {
        if ck.modules[index].consts[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

pub fn find_struct_in(ck: Checker, module_id: string, name: string): number {
    let mut i = ck.structs.len
    while i > 0 {
        i = i - 1
        if ck.structs[i].module_id == module_id and ck.structs[i].name == name {
            return i
        }
    }
    return -1
}

pub fn struct_canonical(ck: Checker, index: number): string {
    if index < 0 or index >= ck.structs.len {
        return "unknown"
    }
    let sig = ck.structs[index]
    if sig.module_id == "" {
        return sig.name
    }
    return sig.module_id + "::" + sig.name
}

pub fn find_struct_by_type(ck: Checker, ty: string): number {
    let head = ck_types::type_head(ty)
    let mut i = 0
    while i < ck.structs.len {
        let canonical = struct_canonical(ck, i)
        if canonical == ty or canonical == head {
            return i
        }
        i = i + 1
    }
    return -1
}

/// Local view: this module's struct, then `use` imports and globs.
pub fn resolve_struct(ck: Checker, module_id: string, name: string, depth: number): number {
    if depth > 32 {
        return -1
    }
    let own = find_struct_in(ck, module_id, name)
    if own >= 0 {
        return own
    }
    let scope = ck_module::module_index(ck, module_id)
    if scope < 0 {
        return -1
    }
    let mut i = ck.modules[scope].imports.len - 1
    while i >= 0 {
        let import = ck.modules[scope].imports[i]
        if import.alias == name and import.member != "" {
            let found = export_struct(ck, import.target, import.member, depth + 1)
            if found != -1 {
                return found
            }
        }
        i = i - 1
    }
    i = ck.modules[scope].globs.len - 1
    while i >= 0 {
        let found = export_struct(ck, ck.modules[scope].globs[i].target, name, depth + 1)
        if found != -1 {
            return found
        }
        i = i - 1
    }
    if module_id != "" {
        return find_struct_in(ck, "", name)
    }
    return -1
}

pub fn export_struct(ck: Checker, module_id: string, name: string, depth: number): number {
    if depth > 32 {
        return -1
    }
    let index = ck_module::module_index(ck, module_id)
    if index < 0 or ck.modules[index].opaque {
        return -1
    }
    let own = find_struct_in(ck, module_id, name)
    if own >= 0 {
        if ck.structs[own].is_pub {
            return own
        }
        return -1
    }
    let mut i = ck.modules[index].imports.len - 1
    while i >= 0 {
        let import = ck.modules[index].imports[i]
        if import.alias == name and import.is_pub and import.member != "" {
            let found = export_struct(ck, import.target, import.member, depth + 1)
            if found != -1 {
                return found
            }
        }
        i = i - 1
    }
    i = ck.modules[index].globs.len - 1
    while i >= 0 {
        if ck.modules[index].globs[i].is_pub {
            let found = export_struct(ck, ck.modules[index].globs[i].target, name, depth + 1)
            if found != -1 {
                return found
            }
        }
        i = i - 1
    }
    return -1
}

pub fn find_enum_in(ck: Checker, module_id: string, name: string): number {
    let mut i = ck.enums.len
    while i > 0 {
        i = i - 1
        if ck.enums[i].module_id == module_id and ck.enums[i].name == name {
            return i
        }
    }
    return -1
}

pub fn enum_canonical(ck: Checker, index: number): string {
    if index < 0 or index >= ck.enums.len {
        return "unknown"
    }
    let sig = ck.enums[index]
    if sig.module_id == "" {
        return sig.name
    }
    return sig.module_id + "::" + sig.name
}

pub fn find_enum_by_type(ck: Checker, ty: string): number {
    let mut i = 0
    while i < ck.enums.len {
        if enum_canonical(ck, i) == ty {
            return i
        }
        i = i + 1
    }
    return -1
}

pub fn resolve_enum(ck: Checker, module_id: string, name: string, depth: number): number {
    if depth > 32 {
        return -1
    }
    let own = find_enum_in(ck, module_id, name)
    if own >= 0 {
        return own
    }
    let scope = ck_module::module_index(ck, module_id)
    if scope < 0 {
        return -1
    }
    let mut i = ck.modules[scope].imports.len - 1
    while i >= 0 {
        let import = ck.modules[scope].imports[i]
        if import.alias == name and import.member != "" {
            let found = export_enum(ck, import.target, import.member, depth + 1)
            if found != -1 {
                return found
            }
        }
        i = i - 1
    }
    i = ck.modules[scope].globs.len - 1
    while i >= 0 {
        let found = export_enum(ck, ck.modules[scope].globs[i].target, name, depth + 1)
        if found != -1 {
            return found
        }
        i = i - 1
    }
    if module_id != "" {
        return find_enum_in(ck, "", name)
    }
    return -1
}

pub fn export_enum(ck: Checker, module_id: string, name: string, depth: number): number {
    if depth > 32 {
        return -1
    }
    let index = ck_module::module_index(ck, module_id)
    if index < 0 or ck.modules[index].opaque {
        return -1
    }
    let own = find_enum_in(ck, module_id, name)
    if own >= 0 {
        if ck.enums[own].is_pub {
            return own
        }
        return -1
    }
    let mut i = ck.modules[index].imports.len - 1
    while i >= 0 {
        let import = ck.modules[index].imports[i]
        if import.alias == name and import.is_pub and import.member != "" {
            let found = export_enum(ck, import.target, import.member, depth + 1)
            if found != -1 {
                return found
            }
        }
        i = i - 1
    }
    i = ck.modules[index].globs.len - 1
    while i >= 0 {
        if ck.modules[index].globs[i].is_pub {
            let found = export_enum(ck, ck.modules[index].globs[i].target, name, depth + 1)
            if found != -1 {
                return found
            }
        }
        i = i - 1
    }
    return -1
}

pub fn find_alias_in(ck: Checker, module_id: string, name: string): number {
    let mut i = ck.aliases.len
    while i > 0 {
        i = i - 1
        if ck.aliases[i].module_id == module_id and ck.aliases[i].name == name {
            return i
        }
    }
    return -1
}

pub fn resolve_alias(ck: Checker, module_id: string, name: string, depth: number): number {
    if depth > 32 {
        return -1
    }
    let own = find_alias_in(ck, module_id, name)
    if own >= 0 {
        return own
    }
    let scope = ck_module::module_index(ck, module_id)
    if scope < 0 {
        return -1
    }
    let mut i = ck.modules[scope].imports.len - 1
    while i >= 0 {
        let import = ck.modules[scope].imports[i]
        if import.alias == name and import.member != "" {
            let found = export_alias(ck, import.target, import.member, depth + 1)
            if found != -1 {
                return found
            }
        }
        i = i - 1
    }
    i = ck.modules[scope].globs.len - 1
    while i >= 0 {
        let found = export_alias(ck, ck.modules[scope].globs[i].target, name, depth + 1)
        if found != -1 {
            return found
        }
        i = i - 1
    }
    return -1
}

pub fn export_alias(ck: Checker, module_id: string, name: string, depth: number): number {
    if depth > 32 {
        return -1
    }
    let index = ck_module::module_index(ck, module_id)
    if index < 0 or ck.modules[index].opaque {
        return -1
    }
    let own = find_alias_in(ck, module_id, name)
    if own >= 0 {
        if ck.aliases[own].is_pub {
            return own
        }
        return -1
    }
    let mut i = ck.modules[index].imports.len - 1
    while i >= 0 {
        let import = ck.modules[index].imports[i]
        if import.alias == name and import.is_pub and import.member != "" {
            let found = export_alias(ck, import.target, import.member, depth + 1)
            if found != -1 {
                return found
            }
        }
        i = i - 1
    }
    i = ck.modules[index].globs.len - 1
    while i >= 0 {
        if ck.modules[index].globs[i].is_pub {
            let found = export_alias(ck, ck.modules[index].globs[i].target, name, depth + 1)
            if found != -1 {
                return found
            }
        }
        i = i - 1
