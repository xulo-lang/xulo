// Stage 1 backend: top-level translation-unit emission.
//
// Procedural form of the old `impl Emitter` methods; `e` is the emitter state.

use ast::Node;
use super::bk_state;
use super::{Emitter};
use super::bk_expr;
use super::bk_stmt;
use super::bk_util;

pub fn em_probe(e: Emitter) {
}

pub fn em_emit(e: mut Emitter, runtime_path: string): string {
    e.program = StringBuilder::new()
    e.out = StringBuilder::new()
    e.indent = 0
    bk_state::co_line(e, "#define _CRT_SECURE_NO_WARNINGS")
    bk_state::co_line(e, "#if defined(_MSC_VER)")
    bk_state::co_line(e, "#pragma comment(linker, \"/STACK:67108864\")")
    bk_state::co_line(e, "#endif")
    bk_state::co_line(e, "#include " + bk_util::c_string(bk_util::normalize_path(bk_util::base_of(runtime_path))))
    bk_state::co_line(e, "")
    bk_state::co_line(e, "// Generated by xuloc stage 1. Do not edit.")
    let mut i = 0
    while i < e.funcs.len {
        let f = e.funcs[i]
        bk_state::co_line(e, "XVal " + f.cname + "(long long argc, XVal *argv);")
        i = i + 1
    }
    i = 0
    while i < e.methods.len {
        let m = e.methods[i]
        bk_state::co_line(e, "XVal " + m.cname + "(long long argc, XVal *argv);")
        i = i + 1
    }
    bk_state::co_line(e, "")
    i = 0
    while i < e.consts.len {
        let c = e.consts[i]
        bk_state::co_line(e, "static XVal " + c.cname + ";")
        i = i + 1
    }
    e.program.append(e.out.build())
    em_emit_method_registrations(e)
    em_emit_globals(e)
    i = 0
    while i < e.funcs.len {
        let f = e.funcs[i]
        em_emit_function(e, f.cname, f.params, f.body)
        i = i + 1
    }
    i = 0
    while i < e.methods.len {
        let m = e.methods[i]
        em_emit_function(e, m.cname, m.params, m.body)
        i = i + 1
    }
    em_emit_main(e)
    return e.program.build()
}

pub fn em_emit_method_registrations(e: mut Emitter) {
    e.out = StringBuilder::new()
    e.indent = 0
    bk_state::co_line(e, "static void xr_register_user_methods(void) {")
    e.indent = 1
    let mut i = 0
    while i < e.methods.len {
        let m = e.methods[i]
        bk_state::co_line(e, 
            "xr_register_method("
                + bk_util::c_string(m.owner)
                + ", "
                + bk_util::c_string(m.name)
                + ", "
                + m.cname
                + ");",
        )
        i = i + 1
    }
    e.indent = 0
    bk_state::co_line(e, "}")
    e.program.append(e.out.build())
    e.program.append("\n")
}

pub fn em_emit_globals(e: mut Emitter) {
    e.out = StringBuilder::new()
    e.local_names = []
    e.local_cnames = []
    e.local_depths = []
    e.depth = 0
    e.next_local = 0
    e.next_tmp = 0
    e.indent = 0
    bk_state::co_line(e, "static void xr_init_globals(void) {")
    e.indent = 1
    let mut i = 0
    while i < e.consts.len {
        let c = e.consts[i]
        let value = bk_expr::ex_emit_expr(e, c.expr)
        bk_state::co_line(e, c.cname + " = " + value + ";")
        i = i + 1
    }
    e.indent = 0
    bk_state::co_line(e, "}")
    e.program.append(e.out.build())
    e.program.append("\n")
}

pub fn em_emit_function(e: mut Emitter, cname: string, params: List<string>, body: Node) {
    e.out = StringBuilder::new()
    e.local_names = []
    e.local_cnames = []
    e.local_depths = []
    e.depth = 0
    e.next_local = 0
    e.next_tmp = 0
    e.indent = 1
    bk_state::co_line(e, "XVal " + cname + "(long long argc, XVal *argv) {")
    bk_state::co_line(e, "  (void)argc;")
    bk_state::co_line(e, "  (void)argv;")
    let mut i = 0
    while i < params.len {
        let c = bk_state::co_new_local(e, params[i])
        bk_state::co_line(e, 
            "  XVal "
                + c
                + " = argc > "
                + str(i)
                + " ? argv["
                + str(i)
                + "] : xr_nil();",
        )
        i = i + 1
    }
    em_emit_block_return(e, body)
    e.indent = 0
    bk_state::co_line(e, "}")
    e.program.append(e.out.build())
    e.program.append("\n")
}

pub fn em_emit_main(e: mut Emitter) {
    e.out = StringBuilder::new()
    e.local_names = []
    e.local_cnames = []
    e.local_depths = []
    e.depth = 0
    e.next_local = 0
    e.next_tmp = 0
    e.indent = 0
    bk_state::co_line(e, "int main(int argc, char **argv) {")
    bk_state::co_line(e, "  xr_set_argv(argc, argv);")
    bk_state::co_line(e, "  xr_register_user_methods();")
    bk_state::co_line(e, "  xr_init_globals();")
    let mut has_main = false
    let mut i = 0
    while i < e.funcs.len {
        if e.funcs[i].name == "main" {
            has_main = true
        }
        i = i + 1
    }
    if has_main {
        bk_state::co_line(e, "  (void)f_main(0, NULL);")
    }
    bk_state::co_line(e, "  return 0;")
    bk_state::co_line(e, "}")
    e.program.append(e.out.build())
    e.program.append("\n")
}

pub fn em_emit_block_return(e: mut Emitter, block: Node) {
    bk_state::co_enter(e)
    let kids = block.children
    if kids.len == 0 {
        bk_state::co_line(e, "return xr_nil();")
        bk_state::co_leave(e)
        return
    }
    let mut i = 0
    while i < kids.len - 1 {
        bk_stmt::st_emit_stmt(e, kids[i])
        i = i + 1
    }
    let last = kids[kids.len - 1]
    if last.kind == "ExprStmt" {
        let value = bk_expr::ex_emit_expr(e, last.children[0])
        bk_state::co_line(e, "return " + value + ";")
    } else {
        bk_stmt::st_emit_stmt(e, last)
        bk_state::co_line(e, "return xr_nil();")
    }
    bk_state::co_leave(e)
}

pub fn em_emit_block_value(e: mut Emitter, block: Node, target: string) {
    bk_state::co_enter(e)
    let kids = block.children
    if kids.len == 0 {
        if target != "" {
            bk_state::co_line(e, target + " = xr_nil();")
        }
        bk_state::co_leave(e)
        return
    }
    let mut i = 0
    while i < kids.len - 1 {
        bk_stmt::st_emit_stmt(e, kids[i])
        i = i + 1
    }
    let last = kids[kids.len - 1]
    if last.kind == "ExprStmt" {
        let expr = last.children[0]
        if target == "" {
            if expr.kind == "If" {
                bk_stmt::st_emit_if(e, expr, "")
            } else if expr.kind == "Match" {
                bk_stmt::st_emit_match(e, expr, "")
            } else {
                let value = bk_expr::ex_emit_expr(e, expr)
                bk_state::co_line(e, "(void)(" + value + ");")
            }
        } else {
            let value = bk_expr::ex_emit_expr(e, expr)
            bk_state::co_line(e, target + " = " + value + ";")
        }
    } else {
        bk_stmt::st_emit_stmt(e, last)
        if target != "" {
            bk_state::co_line(e, target + " = xr_nil();")
        }
    }
    bk_state::co_leave(e)
}
