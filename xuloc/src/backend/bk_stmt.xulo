// Stage 1 backend: statement emission.
//
// Procedural form of the old `impl Emitter` methods; `e` is the emitter state.

use ast::Node;
use super::bk_state;
use super::{Emitter};
use super::bk_emit;
use super::bk_expr;
use super::bk_pattern;
use super::bk_util;

pub fn st_emit_stmt(e: mut Emitter, node: Node) {
    let kind = node.kind
    if kind == "Let" or kind == "Const" {
        st_emit_let(e, node)
        return
    }
    if kind == "Assign" {
        st_emit_assign(e, node)
        return
    }
    if kind == "ExprStmt" {
        let expr = node.children[0]
        if expr.kind == "If" {
            st_emit_if(e, expr, "")
        } else if expr.kind == "Match" {
            st_emit_match(e, expr, "")
        } else {
            let value = bk_expr::ex_emit_expr(e, expr)
            bk_state::co_line(e, "(void)(" + value + ");")
        }
        return
    }
    if kind == "Return" {
        if node.children.len > 0 {
            let value = bk_expr::ex_emit_expr(e, node.children[0])
            // The operand is evaluated before the live blocks' defers run.
            let tmp = bk_state::co_new_tmp(e)
            bk_state::co_line(e, "XVal " + tmp + " = " + value + ";")
            if e.defer_emitting == 0 {
                st_emit_defers_to(e, 1)
            }
            bk_state::co_line(e, "return " + tmp + ";")
        } else {
            if e.defer_emitting == 0 {
                st_emit_defers_to(e, 1)
            }
            bk_state::co_line(e, "return xr_nil();")
        }
        return
    }
    if kind == "If" {
        st_emit_if(e, node, "")
        return
    }
    if kind == "While" {
        st_emit_while(e, node)
        return
    }
    if kind == "For" {
        st_emit_for(e, node)
        return
    }
    if kind == "Jump" {
        if e.defer_emitting == 0 and (node.value == "break" or node.value == "continue") {
            st_emit_defers_to(e, st_loop_floor(e))
        }
        bk_state::co_line(e, node.value + ";")
        return
    }
    if kind == "Block" {
        bk_state::co_enter(e)
        let block_depth = e.depth
        for child in node.children {
            st_emit_stmt(e, child)
        }
        st_emit_defers_to(e, block_depth)
        bk_state::co_leave(e)
        return
    }
    if kind == "Defer" {
        if node.children.len > 0 and e.defer_lists.len > 0 {
            let top = e.defer_lists[e.defer_lists.len - 1]
            top.push(node.children[0])
        }
        return
    }
    if kind == "Fn" {
        bk_state::co_fail(e, "nested functions are not lowered by the bootstrap backend")
        return
    }
    bk_state::co_fail(e, "unsupported statement `" + kind + "`")
}

/// Index of the live deferred list registered by the block at `depth`, or
/// `-1`. Closed scopes are marked `-1`, so a newer synthetic block at the same
/// depth (emitted while draining an outer block) wins.
fn st_defer_find(e: Emitter, depth: number): number {
    let mut i = e.defer_depths.len - 1
    while i >= 0 {
        if e.defer_depths[i] == depth {
            return i
        }
        i = i - 1
    }
    return -1
}

/// Depth of the innermost live loop body; a function body fallback keeps an
/// invalid `break`/`continue` from panicking the emitter.
fn st_loop_floor(e: Emitter): number {
    let mut i = e.loop_depths.len - 1
    while i >= 0 {
        if e.loop_depths[i] >= 0 {
            return e.loop_depths[i]
        }
        i = i - 1
    }
    return 1
}

/// Emit the operands deferred by the blocks from the current depth down to
/// `floor` (inclusive), innermost block first and each block in reverse
/// registration order. The lists stay registered so other exit paths still see
/// them; the generated C for this path runs once.
pub fn st_emit_defers_to(e: mut Emitter, floor: number) {
    let mut d = e.depth
    while d >= floor {
        let index = st_defer_find(e, d)
        if index >= 0 {
            let list = e.defer_lists[index]
            let mut i = list.len - 1
            while i >= 0 {
                st_emit_defer_operand(e, list[i], d)
                i = i - 1
            }
        }
        d = d - 1
    }
}

fn st_emit_defer_operand(e: mut Emitter, node: Node, depth: number) {
    let saved = e.depth
    e.depth = depth
    e.defer_emitting = e.defer_emitting + 1
    if node.kind == "Block" {
        bk_emit::em_emit_block_value(e, node, "")
    } else {
        let value = bk_expr::ex_emit_expr(e, node)
        bk_state::co_line(e, "(void)(" + value + ");")
    }
    e.defer_emitting = e.defer_emitting - 1
    e.depth = saved
}

pub fn st_emit_let(e: mut Emitter, node: Node) {
    let mut initializer = node
    let mut found = false
    let mut type_name = ""
    let mut destructure = node
    for child in node.children {
        if child.kind == "Destructure" {
            destructure = child
            continue
        }
        if child.kind == "TypeName" {
            type_name = child.value
            continue
        }
        if child.kind == "OptionalType" or child.kind == "TupleType" or child.kind == "FnType" {
            continue
        }
        if child.kind != "Mut" {
            initializer = child
            found = true
        }
    }
    if !found {
        bk_state::co_fail(e, "a binding needs an initializer")
        return
    }
    let mut value = ""
    let mut handled = false
    // `let p: Point = { x: 1, y: 2 }`: build the named struct so members,
    // methods, and patterns see the declared type.
    if initializer.kind == "Map" and type_name != "" {
        let index = bk_state::co_find_struct(e, type_name)
        if index >= 0 {
            value = bk_expr::ex_emit_struct_literal(e, initializer, index)
            handled = true
        }
    }
    if !handled {
        value = bk_expr::ex_emit_expr(e, initializer)
    }
    if destructure.kind == "Destructure" {
        st_emit_destructure(e, destructure, value)
        return
    }
    if node.value == "" or node.value == "_" {
        bk_state::co_line(e, "(void)(" + value + ");")
        return
    }
    let cname = bk_state::co_new_local(e, node.value)
    if e.box_locals {
        bk_state::co_line(e, "XVal *" + cname + " = xr_cell(" + value + ");")
    } else {
        bk_state::co_line(e, "XVal " + cname + " = " + value + ";")
    }
}

pub fn st_emit_destructure(e: mut Emitter, pattern: Node, value: string) {
    let tmp = bk_state::co_new_tmp(e)
    bk_state::co_line(e, "XVal " + tmp + " = " + value + ";")
    let mut i = 0
    for child in pattern.children {
        if child.kind == "NamePattern" and child.value != "_" {
            let cname = bk_state::co_new_local(e, child.value)
            let source = if pattern.value == "object" {
                "xr_get_field(" + tmp + ", " + bk_util::c_string(child.value) + ")"
            } else {
                "xr_index(" + tmp + ", xr_int(" + str(i) + "))"
            }
            if e.box_locals {
                bk_state::co_line(e, "XVal *" + cname + " = xr_cell(" + source + ");")
            } else {
                bk_state::co_line(e, "XVal " + cname + " = " + source + ";")
            }
        }
        i = i + 1
    }
}

pub fn st_emit_assign(e: mut Emitter, node: Node) {
    st_emit_assign_to(e, node.children[0], node.children[1])
}

pub fn st_emit_assign_to(e: mut Emitter, target: Node, value_node: Node) {
    if target.kind == "Name" {
        let cname = bk_state::co_lookup_local(e, target.value)
        if cname == "" {
            if e.in_closure {
                let capture = bk_state::co_lookup_capture(e, target.value)
                if capture >= 0 {
                    let value = bk_expr::ex_emit_expr(e, value_node)
                    bk_state::co_line(e, 
                        "xr_capture_set("
                            + e.self_name
                            + ", "
                            + str(capture)
                            + ", "
                            + value
                            + ");",
                    )
                    return
                }
            }
            bk_state::co_fail(e, "cannot assign to unknown name `" + target.value + "`")
            return
        }
        let value = bk_expr::ex_emit_expr(e, value_node)
        if e.box_locals {
            bk_state::co_line(e, "xr_cell_set(" + cname + ", " + value + ");")
        } else {
            bk_state::co_line(e, cname + " = " + value + ";")
        }
        return
    }
    if target.kind == "Member" {
        let recv = bk_expr::ex_emit_expr(e, target.children[0])
        let value = bk_expr::ex_emit_expr(e, value_node)
        bk_state::co_line(e, 
            "xr_set_field(" + recv + ", " + bk_util::c_string(target.value) + ", " + value + ");",
        )
        return
    }
    if target.kind == "Index" {
        let recv = bk_expr::ex_emit_expr(e, target.children[0])
        let index = bk_expr::ex_emit_expr(e, target.children[1])
        let value = bk_expr::ex_emit_expr(e, value_node)
        bk_state::co_line(e, "xr_set_index(" + recv + ", " + index + ", " + value + ");")
        return
    }
    if target.kind == "Group" {
        if target.children.len > 0 {
            st_emit_assign_to(e, target.children[0], value_node)
        }
        return
    }
    bk_state::co_fail(e, "unsupported assignment target `" + target.kind + "`")
}

pub fn st_emit_while(e: mut Emitter, node: Node) {
    bk_state::co_line(e, "while (1) {")
    e.indent = e.indent + 1
    let condition = bk_expr::ex_emit_expr(e, node.children[0])
    bk_state::co_line(e, "if (!xr_cond(" + condition + ")) { break; }")
    let body_depth = e.depth + 1
    e.loop_depths.push(body_depth)
    bk_emit::em_emit_block_value(e, node.children[1], "")
    if e.loop_depths.len > 0 {
        e.loop_depths[e.loop_depths.len - 1] = -1
    }
    e.indent = e.indent - 1
    bk_state::co_line(e, "}")
}

pub fn st_emit_for(e: mut Emitter, node: Node) {
    let iterable = bk_expr::ex_emit_expr(e, node.children[0])
    let it = bk_state::co_new_tmp(e)
    bk_state::co_line(e, "XVal " + it + " = " + iterable + ";")
    let index = bk_state::co_new_tmp(e)
    bk_state::co_line(e, "long long " + index + " = 0;")
    bk_state::co_line(e, "for (; " + index + " < xr_len(" + it + "); " + index + " += 1) {")
    e.indent = e.indent + 1
    bk_state::co_enter(e)
    let body_depth = e.depth
    e.loop_depths.push(body_depth)
    if node.value != "" and node.value != "_" {
        let cname = bk_state::co_new_local(e, node.value)
        let source = "xr_index(" + it + ", xr_int(" + index + "))"
        if e.box_locals {
            bk_state::co_line(e, "XVal *" + cname + " = xr_cell(" + source + ");")
        } else {
            bk_state::co_line(e, "XVal " + cname + " = " + source + ";")
        }
    }
    for child in node.children[1].children {
        st_emit_stmt(e, child)
    }
    st_emit_defers_to(e, body_depth)
    if e.loop_depths.len > 0 {
        e.loop_depths[e.loop_depths.len - 1] = -1
    }
    bk_state::co_leave(e)
    e.indent = e.indent - 1
    bk_state::co_line(e, "}")
}

pub fn st_emit_if(e: mut Emitter, node: Node, target: string) {
    let condition = bk_expr::ex_emit_expr(e, node.children[0])
    bk_state::co_line(e, "if (xr_cond(" + condition + ")) {")
    e.indent = e.indent + 1
    bk_emit::em_emit_block_value(e, node.children[1], target)
    e.indent = e.indent - 1
    if node.children.len > 2 {
        bk_state::co_line(e, "} else {")
        e.indent = e.indent + 1
        let alt = node.children[2]
        if alt.kind == "If" {
            st_emit_if(e, alt, target)
        } else {
            bk_emit::em_emit_block_value(e, alt, target)
        }
        e.indent = e.indent - 1
    }
    bk_state::co_line(e, "}")
}

pub fn st_emit_match(e: mut Emitter, node: Node, target: string) {
    let value = bk_expr::ex_emit_expr(e, node.children[0])
    let scrut = bk_state::co_new_tmp(e)
    bk_state::co_line(e, "XVal " + scrut + " = " + value + ";")
    // A guard is evaluated only after the pattern matched, so it can name
    // the pattern's bindings. Guards therefore need the fall-through form
    // (`if test { bind; if guard { … goto end } }`) instead of an
    // `else if` chain.
    let mut any_guard = false
    let mut g = 1
    while g < node.children.len {
        for child in node.children[g].children {
            if child.kind == "Guard" {
                any_guard = true
            }
        }
        g = g + 1
    }
    if any_guard {
        let label = bk_state::co_new_tmp(e)
        let mut i = 1
        while i < node.children.len {
            st_emit_guard_arm(e, node.children[i], scrut, target, label)
            i = i + 1
        }
        bk_state::co_line(e, "xr_fail(\"no matching arm\");")
        bk_state::co_line(e, label + ":;")
        return
    }
    let mut first = true
    let mut i = 1
    while i < node.children.len {
        let arm = node.children[i]
        let pattern = arm.children[0]
        let test = bk_pattern::pt_pattern_test(e, pattern, scrut)
        if first {
            bk_state::co_line(e, "if (" + test + ") {")
            first = false
        } else {
            bk_state::co_line(e, "} else if (" + test + ") {")
        }
        e.indent = e.indent + 1
        bk_state::co_enter(e)
        bk_pattern::pt_pattern_bind(e, pattern, scrut)
        st_emit_arm_body(e, arm, target)
        bk_state::co_leave(e)
        e.indent = e.indent - 1
        i = i + 1
    }
    if first {
        bk_state::co_line(e, "xr_fail(\"no match arms\");")
    } else {
        bk_state::co_line(e, "} else {")
        e.indent = e.indent + 1
        bk_state::co_line(e, "xr_fail(\"no matching arm\");")
        e.indent = e.indent - 1
        bk_state::co_line(e, "}")
    }
}

pub fn st_emit_arm_body(e: mut Emitter, arm: Node, target: string) {
    let body = arm.children[arm.children.len - 1]
    if body.kind == "Block" {
        bk_emit::em_emit_block_value(e, body, target)
        return
    }
    let value = bk_expr::ex_emit_expr(e, body)
    if target == "" {
        bk_state::co_line(e, "(void)(" + value + ");")
    } else {
        bk_state::co_line(e, target + " = " + value + ";")
    }
}

pub fn st_emit_guard_arm(e: mut Emitter, arm: Node, scrut: string, target: string, label: string) {
    let pattern = arm.children[0]
    let test = bk_pattern::pt_pattern_test(e, pattern, scrut)
    bk_state::co_line(e, "if (" + test + ") {")
    e.indent = e.indent + 1
    bk_state::co_enter(e)
    bk_pattern::pt_pattern_bind(e, pattern, scrut)
    let mut arm_guard = false
    for child in arm.children {
        if child.kind == "Guard" {
            arm_guard = true
            let condition = bk_expr::ex_emit_expr(e, child.children[0])
            bk_state::co_line(e, "if (xr_cond(" + condition + ")) {")
            e.indent = e.indent + 1
            st_emit_arm_body(e, arm, target)
            bk_state::co_line(e, "goto " + label + ";")
            e.indent = e.indent - 1
            bk_state::co_line(e, "}")
        }
    }
    if !arm_guard {
        st_emit_arm_body(e, arm, target)
        bk_state::co_line(e, "goto " + label + ";")
    }
    bk_state::co_leave(e)
    e.indent = e.indent - 1
    bk_state::co_line(e, "}")
}
