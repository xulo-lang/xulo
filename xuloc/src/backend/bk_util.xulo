// Stage 1 backend: pure path, string, number, and pattern-text helpers.
//
// These free functions hold no emitter state and are safe to call from any
// backend module.

use ast::Node;

pub fn dir_of(path: string): string {
    let mut i = path.len - 1
    while i >= 0 {
        let c = path.slice(i, i + 1)
        if c == "/" or c == "\\" {
            if i == 0 {
                return path.slice(0, 1)
            }
            return path.slice(0, i)
        }
        i = i - 1
    }
    return "."
}

pub fn stem_of(path: string): string {
    let mut at = path.len - 1
    while at >= 0 {
        let c = path.slice(at, at + 1)
        if c == "/" or c == "\\" {
            break
        }
        at = at - 1
    }
    let start = at + 1
    let mut dot = path.len
    let mut i = start
    while i < path.len {
        if path.slice(i, i + 1) == "." {
            dot = i
        }
        i = i + 1
    }
    return path.slice(start, dot)
}

pub fn base_of(path: string): string {
    let mut at = path.len - 1
    while at >= 0 {
        let c = path.slice(at, at + 1)
        if c == "/" or c == "\\" {
            return path.slice(at + 1, path.len)
        }
        at = at - 1
    }
    return path
}

pub fn join_path(dir: string, name: string): string {
    if dir == "" or dir == "." {
        return name
    }
    return dir + "/" + name
}

pub fn clean_number(text: string): string {
    let mut out = StringBuilder::new()
    for c in text.split("") {
        if c != "_" {
            out.append(c)
        }
    }
    return out.build()
}

pub fn is_float_text(text: string): bool {
    if text.len >= 2 {
        if text.slice(0, 2) == "0x" or text.slice(0, 2) == "0X" {
            return false
        }
    }
    for c in text.split("") {
        if c == "." or c == "e" or c == "E" {
            return true
        }
    }
    return false
}

fn all_zero_digits(text: string): bool {
    for c in text.split("") {
        if c != "0" {
            return false
        }
    }
    return true
}

/// `2^63` itself: the only value above `i64::MAX` that unary minus turns into a
/// valid `i64` (`i64::MIN`). The bootstrap backend recognizes it so
/// `-9223372036854775808` keeps working without a `u64` slot.
pub fn integer_is_i64_min_magnitude(text: string): bool {
    if text.len >= 2 {
        let head = text.slice(0, 2)
        if head == "0x" or head == "0X" {
            let digits = strip_leading_zeros(text.slice(2, text.len))
            return digits.len == 16
                and digits.slice(0, 1) == "8"
                and all_zero_digits(digits.slice(1, digits.len))
        }
        if head == "0b" or head == "0B" {
            let digits = strip_leading_zeros(text.slice(2, text.len))
            return digits.len == 64
                and digits.slice(0, 1) == "1"
                and all_zero_digits(digits.slice(1, digits.len))
        }
        if head == "0o" or head == "0O" {
            let digits = strip_leading_zeros(text.slice(2, text.len))
            return digits.len == 22
                and digits.slice(0, 1) == "1"
                and all_zero_digits(digits.slice(1, digits.len))
        }
    }
    return text == "9223372036854775808"
}

fn strip_leading_zeros(text: string): string {
    let mut at = 0
    while at + 1 < text.len and text.slice(at, at + 1) == "0" {
        at = at + 1
    }
    return text.slice(at, text.len)
}

fn integer_digits_within(text: string, limit: string): bool {
    let digits = strip_leading_zeros(text)
    if digits.len != limit.len {
        return digits.len < limit.len
    }
    let mut at = 0
    while at < digits.len {
        let left = digits.slice(at, at + 1).code_at(0)
        let right = limit.slice(at, at + 1).code_at(0)
        if left != right {
            return left < right
        }
        at = at + 1
    }
    return true
}

/// Whether a cleaned integer literal fits the signed 64-bit slot the bootstrap
/// runtime uses. `u64` is outside the bootstrap subset (drift D-04), so a
/// literal above `i64::MAX` is rejected before the C backend can mis-tag it.
pub fn integer_fits_i64(text: string): bool {
    if text.len >= 2 {
        let head = text.slice(0, 2)
        if head == "0x" or head == "0X" {
            return integer_digits_within(text.slice(2, text.len), "7fffffffffffffff")
        }
        if head == "0b" or head == "0B" {
            let digits = strip_leading_zeros(text.slice(2, text.len))
            return digits.len <= 63
        }
        if head == "0o" or head == "0O" {
            let digits = strip_leading_zeros(text.slice(2, text.len))
            return digits.len <= 21
        }
    }
    return integer_digits_within(text, "9223372036854775807")
}

pub fn hex_pad(n: number, width: number): string {
    let digits = "0123456789ABCDEF"
    let mut out = StringBuilder::new()
    let mut i = width - 1
    while i >= 0 {
        let value = (n >> (i * 4)) & 15
        out.append(digits.slice(value, value + 1))
        i = i - 1
    }
    return out.build()
}

pub fn pad_hex8(text: string): string {
    // `\u{1F44B}` carries a variable-width codepoint; C's `\U` needs eight.
    let mut out = StringBuilder::new()
    let mut pad = 8 - text.len
    while pad > 0 {
        out.append("0")
        pad = pad - 1
    }
    out.append(text)
    return out.build()
}

pub fn c_string(value: string): string {
    let mut out = StringBuilder::new()
    out.append("\"")
    out.append(value)
    out.append("\"")
    return out.build()
}

pub fn c_join(values: List<string>): string {
    let mut out = StringBuilder::new()
    let mut i = 0
    while i < values.len {
        if i > 0 {
            out.append(", ")
        }
        out.append(values[i])
        i = i + 1
    }
    return out.build()
}

pub fn normalize_path(path: string): string {
    let mut out = StringBuilder::new()
    for c in path.split("") {
        if c == "\\" {
            out.append("/")
        } else {
            out.append(c)
        }
    }
    return out.build()
}

pub fn split_path(path: string): List<string> {
    let mut parts: List<string> = []
    let mut part = StringBuilder::new()
    let chars = path.split("")
    let mut i = 0
    while i < chars.len {
        let c = chars[i]
        if c == ":" and i + 1 < chars.len and chars[i + 1] == ":" {
            parts.push(part.build())
            part = StringBuilder::new()
            i = i + 2
        } else {
            part.append(c)
            i = i + 1
        }
    }
    parts.push(part.build())
    return parts
}

/// Encode a module id into a C-identifier fragment. The package root is `""`;
/// a module id becomes a length-prefixed segment chain (`inner::detail` →
/// `5inner6detail`). Length prefixes make the encoding self-delimiting, so
/// `a::b` and an underscore-containing module name never collide. A non-root
/// fragment always starts with a digit, which no Xulo identifier can do, so a
/// root declaration (`f_main`) can never collide with a module-mangled one.
pub fn module_token(module_id: string): string {
    if module_id == "" {
        return ""
    }
    let mut out = StringBuilder::new()
    for part in split_path(module_id) {
        out.append(str(part.len))
        out.append(part)
    }
    return out.build()
}

/// C symbol for a module-level function or constant. Root declarations keep
/// their historical `f_`/`g_` names.
pub fn decl_cname(prefix: string, module_id: string, name: string): string {
    let token = module_token(module_id)
    if token == "" {
        return prefix + "_" + name
    }
    return prefix + "_" + token + "_" + name
}

pub fn has_child_kind(node: Node, kind: string): bool {
    for child in node.children {
        if child.kind == kind {
            return true
        }
    }
    return false
}

pub fn type_pattern_name(value: string): string {
    let words = value.split(" ")
    let mut i = words.len - 1
    while i >= 0 {
        if words[i] != "" {
            return words[i]
        }
        i = i - 1
    }
    return ""
}

pub fn type_pattern_type(value: string): string {
    let words = value.split(" ")
    let mut i = 0
    while i < words.len {
        if words[i] != "" {
            return words[i]
        }
        i = i + 1
    }
    return value
}
