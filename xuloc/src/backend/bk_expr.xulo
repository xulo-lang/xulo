// Stage 1 backend: expression emission.
//
// Procedural form of the old `impl Emitter` methods; `e` is the emitter state.

use ast::Node;
use super::bk_state;
use super::{Emitter};
use super::bk_call;
use super::bk_emit;
use super::bk_ns;
use super::bk_stmt;
use super::bk_util;

pub fn ex_emit_struct_literal(e: mut Emitter, map_node: Node, index: number): string {
    let info = e.structs[index]
    let fields = info.fields
    let mut values: List<string> = []
    let mut i = 0
    while i < fields.len {
        values.push("xr_nil()")
        i = i + 1
    }
    for child in map_node.children {
        if child.kind != "Entry" {
            bk_state::co_fail(e, "a typed object literal does not support spread")
            return "xr_nil()"
        }
        let mut target = -1
        let mut f = 0
        while f < fields.len {
            if fields[f] == child.value {
                target = f
            }
            f = f + 1
        }
        if target < 0 {
            bk_state::co_fail(e, "unknown field `" + child.value + "` in `" + info.name + "`")
            return "xr_nil()"
        }
        let value = ex_emit_expr(e, child.children[0])
        let tmp = bk_state::co_new_tmp(e)
        bk_state::co_line(e, "XVal " + tmp + " = " + value + ";")
        values[target] = tmp
    }
    let mut ctor = "xr_struct"
    if info.debug {
        ctor = "xr_struct_debug"
    }
    return ctor
        + "("
        + bk_util::c_string(info.name)
        + ", "
        + str(fields.len)
        + ", "
        + ex_name_array(e, fields)
        + ", "
        + ex_value_array(e, values)
        + ")"
}

pub fn ex_emit_expr(e: mut Emitter, node: Node): string {
    let kind = node.kind
    if kind == "Literal" {
        return bk_state::co_literal_expr(e, node.value)
    }
    if kind == "Template" {
        return ex_emit_template(e, node)
    }
    if kind == "TemplateText" {
        return "xr_str(" + ex_c_template_text(e, node.value) + ")"
    }
    if kind == "Name" {
        return ex_require_name(e, node.value)
    }
    if kind == "Path" {
        return ex_require_path(e, node.value)
    }
    if kind == "Group" {
        if node.children.len == 0 {
            return "xr_nil()"
        }
        return ex_emit_expr(e, node.children[0])
    }
    if kind == "TypeApply" {
        if node.children.len == 0 {
            return "xr_nil()"
        }
        return ex_emit_expr(e, node.children[0])
    }
    if kind == "Try" {
        if node.children.len == 0 {
            return "xr_nil()"
        }
        let value = ex_emit_expr(e, node.children[0])
        let tmp = bk_state::co_new_tmp(e)
        bk_state::co_line(e, "XVal " + tmp + " = " + value + ";")
        bk_state::co_line(e, "if (xr_is_variant(" + tmp + ", \"Result::Err\")) {")
        e.indent = e.indent + 1
        if e.defer_emitting == 0 {
            bk_stmt::st_emit_defers_to(e, 1)
        }
        bk_state::co_line(e, "return " + tmp + ";")
        e.indent = e.indent - 1
        bk_state::co_line(e, "}")
        return "xr_payload(" + tmp + ", 0)"
    }
    if kind == "Assign" {
        return ex_emit_assign(e, node)
    }
    if kind == "Unary" {
        return ex_emit_unary(e, node)
    }
    if kind == "Binary" {
        return ex_emit_binary(e, node)
    }
    if kind == "Ternary" {
        return ex_emit_ternary(e, node)
    }
    if kind == "Is" {
        return ex_emit_is(e, node)
    }
    if kind == "Call" {
        return bk_call::ca_emit_call(e, node)
    }
    if kind == "Member" {
        return ex_emit_member(e, node)
    }
    if kind == "OptionalMember" {
        return ex_emit_optional_member(e, node)
    }
    if kind == "Index" {
        let recv = ex_emit_expr(e, node.children[0])
        let index = ex_emit_expr(e, node.children[1])
        return "xr_index(" + recv + ", " + index + ")"
    }
    if kind == "List" {
        return ex_emit_list(e, node)
    }
    if kind == "Tuple" {
        return ex_emit_list(e, node)
    }
    if kind == "If" {
        let tmp = bk_state::co_new_tmp(e)
        bk_state::co_line(e, "XVal " + tmp + " = xr_nil();")
        bk_stmt::st_emit_if(e, node, tmp)
        return tmp
    }
    if kind == "Match" {
        let tmp = bk_state::co_new_tmp(e)
        bk_state::co_line(e, "XVal " + tmp + " = xr_nil();")
        bk_stmt::st_emit_match(e, node, tmp)
        return tmp
    }
    if kind == "Spread" {
        bk_state::co_fail(e, "a spread is only valid inside a list literal")
        return "xr_nil()"
    }
    if kind == "Map" {
        return ex_emit_map(e, node)
    }
    if kind == "Lock" {
        return ex_emit_lock(e, node)
    }
    if kind == "Spawn" {
        return ex_emit_spawn(e, node)
    }
    if kind == "Closure" or kind == "ArrowClosure" {
        return ex_emit_closure(e, node)
    }
    bk_state::co_fail(e, "unsupported expression `" + kind + "`")
    return "xr_nil()"
}

/// Whether a function body contains a closure literal. A function that does is
/// the one whose locals must be boxed so closures can capture them by reference.
pub fn ex_contains_closure(node: Node): bool {
    if node.kind == "Closure" or node.kind == "ArrowClosure" {
        return true
    }
    for child in node.children {
        if ex_contains_closure(child) {
            return true
        }
    }
    return false
}

fn ex_has_name(names: List<string>, name: string): bool {
    let mut i = 0
    while i < names.len {
        if names[i] == name {
            return true
        }
        i = i + 1
    }
    return false
}

/// Lower a closure or arrow literal to a generated C function plus a runtime
/// value that carries its captured cells. The function body is emitted into a
/// saved emitter state, so nested closures work without disturbing the
/// enclosing function.
pub fn ex_emit_closure(e: mut Emitter, node: Node): string {
    let id = e.next_closure
    e.next_closure = e.next_closure + 1
    let cname = "c_" + str(id)

    let mut params: List<string> = []
    let mut body = node
    if node.children.len > 0 {
        body = node.children[node.children.len - 1]
    }
    for child in node.children {
        if child.kind == "Param" {
            params.push(child.value)
        }
    }

    // Capture every visible binding, innermost first so shadowed names win.
    // A function that contains a closure boxes all of its locals, so a normal
    // binding is already a cell pointer.
    let mut cap_names: List<string> = []
    let mut cap_cells: List<string> = []
    if e.box_locals {
        let mut i = e.local_names.len - 1
        while i >= 0 {
            if e.local_active[i] and e.local_depths[i] <= e.depth {
                let name = e.local_names[i]
                if !ex_has_name(cap_names, name) {
                    cap_names.push(name)
                    cap_cells.push(e.local_cnames[i])
                }
            }
            i = i - 1
        }
    }
    if e.in_closure {
        let mut i = 0
        while i < e.capture_names.len {
            let name = e.capture_names[i]
            if !ex_has_name(cap_names, name) {
                cap_names.push(name)
                cap_cells.push(
                    "xr_capture_cell(" + e.self_name + ", " + str(i) + ")",
                )
            }
            i = i + 1
        }
    }

    let saved_out = e.out
    let saved_names = e.local_names
    let saved_cnames = e.local_cnames
    let saved_depths = e.local_depths
    let saved_active = e.local_active
    let saved_marks = e.local_marks
    let saved_defer_depths = e.defer_depths
    let saved_defer_lists = e.defer_lists
    let saved_loop_depths = e.loop_depths
    let saved_defer_emitting = e.defer_emitting
    let saved_depth = e.depth
    let saved_local = e.next_local
    let saved_tmp = e.next_tmp
    let saved_indent = e.indent
    let saved_box = e.box_locals
    let saved_in_closure = e.in_closure
    let saved_captures = e.capture_names
    let saved_self = e.self_name

    e.out = StringBuilder::new()
    e.local_names = []
    e.local_cnames = []
    e.local_depths = []
    e.local_active = []
    e.local_marks = []
    e.defer_depths = []
    e.defer_lists = []
    e.loop_depths = []
    e.defer_emitting = 0
    e.depth = 0
    e.next_local = 0
    e.next_tmp = 0
    e.indent = 1
    e.box_locals = ex_contains_closure(body)
    e.in_closure = true
    e.capture_names = cap_names
    e.self_name = "self"

    bk_state::co_line(e, "static XVal " + cname + "(XVal self, long long argc, XVal *argv) {")
    bk_state::co_line(e, "  (void)self;")
    bk_state::co_line(e, "  (void)argc;")
    bk_state::co_line(e, "  (void)argv;")
    let mut i = 0
    while i < params.len {
        let c = bk_state::co_new_local(e, params[i])
        if e.box_locals {
            bk_state::co_line(e, 
                "  XVal *"
                    + c
                    + " = xr_cell(argc > "
                    + str(i)
                    + " ? argv["
                    + str(i)
                    + "] : xr_nil());",
            )
        } else {
            bk_state::co_line(e, 
                "  XVal "
                    + c
                    + " = argc > "
                    + str(i)
                    + " ? argv["
                    + str(i)
                    + "] : xr_nil();",
            )
        }
        i = i + 1
    }
    if body.kind == "Block" {
        bk_emit::em_emit_block_return(e, body)
    } else {
        let value = ex_emit_expr(e, body)
        bk_state::co_line(e, "return " + value + ";")
    }
    e.indent = 0
    bk_state::co_line(e, "}")
    e.closure_funcs.push(e.out.build())
    e.closure_ids.push(id)

    e.out = saved_out
    e.local_names = saved_names
    e.local_cnames = saved_cnames
    e.local_depths = saved_depths
    e.local_active = saved_active
    e.local_marks = saved_marks
    e.defer_depths = saved_defer_depths
    e.defer_lists = saved_defer_lists
    e.loop_depths = saved_loop_depths
    e.defer_emitting = saved_defer_emitting
    e.depth = saved_depth
    e.next_local = saved_local
    e.next_tmp = saved_tmp
    e.indent = saved_indent
    e.box_locals = saved_box
    e.in_closure = saved_in_closure
    e.capture_names = saved_captures
    e.self_name = saved_self

    let mut cells = "NULL"
    if cap_cells.len > 0 {
        cells = "(XVal*[]){" + bk_util::c_join(cap_cells) + "}"
    }
    return "xr_closure_new(" + str(id) + ", " + str(cap_cells.len) + ", " + cells + ")"
}

/// `lock target { … }` evaluates its block. The compiled concurrency model is
/// synchronous, so the shared target is only read for effect.
pub fn ex_emit_lock(e: mut Emitter, node: Node): string {
    if node.children.len > 0 {
        let target = ex_emit_expr(e, node.children[0])
        bk_state::co_line(e, "(void)(" + target + ");")
    }
    let tmp = bk_state::co_new_tmp(e)
    bk_state::co_line(e, "XVal " + tmp + " = xr_nil();")
    if node.children.len > 1 {
        bk_emit::em_emit_block_value(e, node.children[1], tmp)
    }
    return tmp
}

/// `spawn` runs its block immediately in the compiled model. A
/// `spawn.process Type { … }` service becomes an instance of `Type`; `send`
/// dispatches to its `on_message` through the runtime.
pub fn ex_emit_spawn(e: mut Emitter, node: Node): string {
    if node.value == "process" and node.children.len >= 2
        and node.children[0].kind == "TypeName" and node.children[1].kind == "Map"
    {
        let index = bk_state::co_find_struct(e, node.children[0].value)
        if index < 0 {
            bk_state::co_fail(e, "unknown service type `" + node.children[0].value + "`")
            return "xr_nil()"
        }
        return ex_emit_struct_literal(e, node.children[1], index)
    }
    let mut block = node
    let mut found = false
    for child in node.children {
        if child.kind == "Block" {
            block = child
            found = true
        }
    }
    // `spawn.on(expr)` names a scheduling target; evaluate it for effect.
    for child in node.children {
        if child.kind != "Block" and child.kind != "TypeName" {
            let value = ex_emit_expr(e, child)
            bk_state::co_line(e, "(void)(" + value + ");")
        }
    }
    let tmp = bk_state::co_new_tmp(e)
    bk_state::co_line(e, "XVal " + tmp + " = xr_nil();")
    if found {
        bk_emit::em_emit_block_value(e, block, tmp)
    }
    return tmp
}

pub fn ex_emit_template(e: mut Emitter, node: Node): string {
    // Templates are string concatenation: a text chunk is already a
    // string, an interpolation renders through `xr_str_of`.
    let mut expr = "xr_str(\"\")"
    for child in node.children {
        if child.kind == "TemplateText" {
            if child.value != "" {
                expr = "xr_add("
                    + expr
                    + ", xr_str("
                    + ex_c_template_text(e, child.value)
                    + "))"
            }
            continue
        }
        let value = ex_emit_expr(e, child)
        expr = "xr_add(" + expr + ", xr_str_of(" + value + "))"
    }
    return expr
}

pub fn ex_c_template_text(e: Emitter, text: string): string {
    // Escape a template text chunk into a C string literal. `\u{…}` is
    // not a C escape, so it becomes `\UXXXXXXXX`; other escapes
    // (`\n`, `\t`, `\uXXXX`, `\xNN`, `\\`) already match C.
    let chars = text.split("")
    let mut lit = StringBuilder::new()
    lit.append("\"")
    let mut i = 0
    while i < chars.len {
        let c = chars[i]
        if c == "\\" and i + 1 < chars.len {
            let next = chars[i + 1]
            if next == "u" and i + 2 < chars.len and chars[i + 2] == "{" {
                let mut j = i + 3
                let mut hex = StringBuilder::new()
                while j < chars.len and chars[j] != "}" {
                    hex.append(chars[j])
                    j = j + 1
                }
                lit.append("\\U")
                lit.append(bk_util::pad_hex8(hex.build()))
                i = j + 1
                continue
            }
            lit.append("\\")
            lit.append(next)
            i = i + 2
            continue
        }
        if c == "\"" {
            lit.append("\\\"")
            i = i + 1
            continue
        }
        if c == "\n" {
            lit.append("\\n")
            i = i + 1
            continue
        }
        if c == "\r" {
            lit.append("\\r")
            i = i + 1
            continue
        }
        if c == "\t" {
            lit.append("\\t")
            i = i + 1
            continue
        }
        let code = c.code_at(0)
        if code < 32 {
            lit.append("\" \"\\x")
            lit.append(bk_util::hex_pad(code, 2))
            lit.append("\" \"")
            i = i + 1
            continue
        }
        lit.append(c)
        i = i + 1
    }
    lit.append("\"")
    return lit.build()
}

pub fn ex_emit_name(e: mut Emitter, name: string): string {
    let binding = bk_state::co_lookup_local(e, name)
    if binding != "" {
        if e.box_locals {
            return "xr_cell_get(" + binding + ")"
        }
        return binding
    }
    if e.in_closure {
        let capture = bk_state::co_lookup_capture(e, name)
        if capture >= 0 {
            return "xr_capture_get(" + e.self_name + ", " + str(capture) + ")"
        }
    }
    let kind = bk_ns::ns_lookup_kind(e, e.current_module, name, 0)
    let cname = bk_ns::ns_lookup_cname(e, e.current_module, name, 0)
    if kind == "const" {
        return cname
    }
    if kind == "fn" and cname != "" {
        let index = bk_state::co_find_function_index_by_cname(e, cname)
        if index >= 0 {
            return ex_function_value(e, index)
        }
    }
    let constant = bk_state::co_lookup_const(e, name)
    if constant != "" {
        return constant
    }
    if bk_state::co_find_function_index(e, name) >= 0 {
        return ex_function_value(e, bk_state::co_find_function_index(e, name))
    }
    return ""
}

/// A named function used as a value gets a generated closure that forwards
/// its arguments, so `map(xs, double)` and `logging(route)` work.
fn ex_function_value(e: mut Emitter, index: number): string {
    let fn_cname = e.funcs[index].cname
    let mut i = 0
    while i < e.function_value_names.len {
        if e.function_value_names[i] == fn_cname {
            return "xr_closure_new(" + str(e.function_value_ids[i]) + ", 0, NULL)"
        }
        i = i + 1
    }
    let id = e.next_closure
    e.next_closure = e.next_closure + 1
    let cname = "c_" + str(id)
    let text = "static XVal " + cname + "(XVal self, long long argc, XVal *argv) {\n"
        + "  (void)self;\n  (void)argc;\n  (void)argv;\n  return " + fn_cname
        + "(argc, argv);\n}\n"
    e.closure_funcs.push(text)
    e.closure_ids.push(id)
    e.function_value_names.push(fn_cname)
    e.function_value_ids.push(id)
    return "xr_closure_new(" + str(id) + ", 0, NULL)"
}

pub fn ex_require_name(e: mut Emitter, name: string): string {
    let value = ex_emit_name(e, name)
    if value == "" {
        bk_state::co_fail(e, "cannot lower value `" + name + "`; functions are not first-class in the bootstrap backend")
        return "xr_nil()"
    }
    return value
}

pub fn ex_emit_path(e: mut Emitter, value: string): string {
    let constant = bk_state::co_lookup_const(e, value)
    if constant != "" {
        return constant
    }
    if value == "std::math::PI" {
        return "xr_float(3.141592653589793)"
    }
    if value == "std::math::E" {
        return "xr_float(2.718281828459045)"
    }
    if value == "std::math::TAU" {
        return "xr_float(6.283185307179586)"
    }
    if value == "std::math::INFINITY" {
        return "xr_float(INFINITY)"
    }
    if value == "std::math::NAN" {
        return "xr_float(NAN)"
    }
    // Resolve through this package's module tree first: `mod::CONST`,
    // `alias::CONST`, and a module-qualified function used as a value.
    let kind = bk_ns::ns_path_kind(e, e.current_module, value, 0)
    let cname = bk_ns::ns_path_cname(e, e.current_module, value, 0)
    if kind == "const" and cname != "" {
        return cname
    }
    if kind == "fn" and cname != "" {
        let index = bk_state::co_find_function_index_by_cname(e, cname)
        if index >= 0 {
            return ex_function_value(e, index)
        }
    }
    // External aliases (`use std::fmt as f`) fall back to the flattened name.
    let parts = bk_util::split_path(value)
    if parts.len > 1 {
        let last = parts[parts.len - 1]
        let constant = bk_state::co_lookup_const(e, last)
        if constant != "" {
            return constant
        }
        let bound = bk_state::co_lookup_local(e, last)
        if bound != "" {
            return bound
        }
        let callee = bk_state::co_find_function(e, last)
        if callee != "" {
            return callee
        }
    }
    // A payload-free enum variant is a value: `Direction::East`.
    if parts.len == 2 and bk_state::co_enum_has_variant(e, parts[0], parts[1]) {
        return "xr_variant("
            + bk_util::c_string(parts[0])
            + ", "
            + bk_util::c_string(parts[1])
            + ", 0, NULL)"
    }
    return ""
}

pub fn ex_require_path(e: mut Emitter, value: string): string {
    let path = ex_emit_path(e, value)
    if path == "" {
        bk_state::co_fail(e, "path `" + value + "` is not a value in the bootstrap backend")
        return "xr_nil()"
    }
    return path
}

/// Assignment in expression position (`a = b = 3`) stores the value and yields
/// it, so the outer assignment sees the same result.
fn ex_emit_assign(e: mut Emitter, node: Node): string {
    if node.children.len < 2 {
        return "xr_nil()"
    }
    return ex_emit_assign_parts(e, node.children[0], node.children[1])
}

fn ex_emit_assign_parts(e: mut Emitter, target: Node, value_node: Node): string {
    if target.kind == "Group" and target.children.len > 0 {
        return ex_emit_assign_parts(e, target.children[0], value_node)
    }
    if target.kind == "Name" {
        let cname = bk_state::co_lookup_local(e, target.value)
        if cname == "" {
            if e.in_closure {
                let capture = bk_state::co_lookup_capture(e, target.value)
                if capture >= 0 {
                    let value = ex_emit_expr(e, value_node)
                    let tmp = bk_state::co_new_tmp(e)
                    bk_state::co_line(e, "XVal " + tmp + " = " + value + ";")
                    bk_state::co_line(e, 
                        "xr_capture_set("
                            + e.self_name
                            + ", "
                            + str(capture)
                            + ", "
                            + tmp
                            + ");",
                    )
                    return tmp
                }
            }
            bk_state::co_fail(e, "cannot assign to unknown name `" + target.value + "`")
            return "xr_nil()"
        }
        let value = ex_emit_expr(e, value_node)
        let tmp = bk_state::co_new_tmp(e)
        bk_state::co_line(e, "XVal " + tmp + " = " + value + ";")
        if e.box_locals {
            bk_state::co_line(e, "xr_cell_set(" + cname + ", " + tmp + ");")
        } else {
            bk_state::co_line(e, cname + " = " + tmp + ";")
        }
        return tmp
    }
    if target.kind == "Member" {
        let recv = ex_emit_expr(e, target.children[0])
        let value = ex_emit_expr(e, value_node)
        let tmp = bk_state::co_new_tmp(e)
        bk_state::co_line(e, "XVal " + tmp + " = " + value + ";")
        bk_state::co_line(
            e,
            "xr_set_field(" + recv + ", " + bk_util::c_string(target.value) + ", " + tmp + ");",
        )
        return tmp
    }
    if target.kind == "Index" {
        let recv = ex_emit_expr(e, target.children[0])
        let index = ex_emit_expr(e, target.children[1])
        let value = ex_emit_expr(e, value_node)
        let tmp = bk_state::co_new_tmp(e)
        bk_state::co_line(e, "XVal " + tmp + " = " + value + ";")
        bk_state::co_line(e, "xr_set_index(" + recv + ", " + index + ", " + tmp + ");")
        return tmp
    }
    bk_state::co_fail(e, "unsupported assignment target `" + target.kind + "`")
    return "xr_nil()"
}

pub fn ex_emit_unary(e: mut Emitter, node: Node): string {
    if node.children.len == 0 {
        return "xr_nil()"
    }
    // `-9223372036854775808` is `i64::MIN`, whose magnitude is one above
    // `i64::MAX`. Fold it here so the literal check does not reject the only
    // negated value the bootstrap slot can represent.
    if node.value == "-" and node.children[0].kind == "Literal" {
        let digits = bk_util::clean_number(node.children[0].value)
        if !bk_util::integer_fits_i64(digits) and bk_util::integer_is_i64_min_magnitude(digits) {
            return "xr_int(LLONG_MIN)"
        }
    }
    let operand = ex_emit_expr(e, node.children[0])
    if node.value == "!" {
        return "xr_not(" + operand + ")"
    }
    if node.value == "-" {
        return "xr_neg(" + operand + ")"
    }
    if node.value == "~" {
        return "xr_bitnot(" + operand + ")"
    }
    if node.value == "await"
        or node.value == "move"
        or node.value == "copy"
        or node.value == "shared"
    {
        return operand
    }
    bk_state::co_fail(e, "unsupported unary operator `" + node.value + "`")
    return "xr_nil()"
}

pub fn ex_emit_binary(e: mut Emitter, node: Node): string {
    if node.children.len < 2 {
        return "xr_nil()"
    }
    let op = node.value
    if op == "and" or op == "or" or op == "??" {
        return ex_emit_short_circuit(e, op, node)
    }
    let left = ex_emit_expr(e, node.children[0])
    let right = ex_emit_expr(e, node.children[1])
    if op == "+" {
        return "xr_add(" + left + ", " + right + ")"
    }
    if op == "-" {
        return "xr_sub(" + left + ", " + right + ")"
    }
    if op == "*" {
        return "xr_mul(" + left + ", " + right + ")"
    }
    if op == "/" {
        return "xr_div(" + left + ", " + right + ")"
    }
    if op == "%" {
        return "xr_mod(" + left + ", " + right + ")"
    }
    if op == "**" {
        return "xr_pow(" + left + ", " + right + ")"
    }
    if op == "&" {
        return "xr_band(" + left + ", " + right + ")"
    }
    if op == "|" {
        return "xr_bor(" + left + ", " + right + ")"
    }
    if op == "^" {
        return "xr_bxor(" + left + ", " + right + ")"
    }
    if op == "<<" {
        return "xr_shl(" + left + ", " + right + ")"
    }
    if op == ">>" {
        return "xr_shr(" + left + ", " + right + ")"
    }
    if op == "==" {
        return "xr_bool(xr_eq(" + left + ", " + right + "))"
    }
    if op == "!=" {
        return "xr_bool(!xr_eq(" + left + ", " + right + "))"
    }
    if op == "<" {
        return "xr_lt(" + left + ", " + right + ")"
    }
    if op == "<=" {
        return "xr_le(" + left + ", " + right + ")"
    }
    if op == ">" {
        return "xr_gt(" + left + ", " + right + ")"
    }
    if op == ">=" {
        return "xr_ge(" + left + ", " + right + ")"
    }
    if op == "..<" {
        return "xr_range(" + left + ", " + right + ", 0)"
    }
    if op == "..=" {
        return "xr_range(" + left + ", " + right + ", 1)"
    }
    bk_state::co_fail(e, "unsupported binary operator `" + op + "`")
    return "xr_nil()"
}

pub fn ex_emit_short_circuit(e: mut Emitter, op: string, node: Node): string {
    let left = ex_emit_expr(e, node.children[0])
    if op == "and" {
        // No temp statement: the operand appears once, so the C ternary
        // itself short-circuits. A statement here would be emitted
        // unconditionally and would defeat nesting (`a and (b or c)`).
        let right = ex_emit_expr(e, node.children[1])
        return "(xr_cond(" + left + ") ? " + right + " : xr_bool(0))"
    }
    if op == "or" {
        let right = ex_emit_expr(e, node.children[1])
        return "(xr_cond(" + left + ") ? xr_bool(1) : " + right + ")"
    }
    // `??` reads the left operand twice, so it needs a temp.
    let tmp = bk_state::co_new_tmp(e)
    bk_state::co_line(e, "XVal " + tmp + " = " + left + ";")
    let right = ex_emit_expr(e, node.children[1])
    return "((" + tmp + ").tag == XT_NIL ? " + right + " : " + tmp + ")"
}

pub fn ex_emit_ternary(e: mut Emitter, node: Node): string {
    if node.children.len < 3 {
        return "xr_nil()"
    }
    let condition = ex_emit_expr(e, node.children[0])
    let tmp = bk_state::co_new_tmp(e)
    bk_state::co_line(e, "XVal " + tmp + " = " + condition + ";")
    let then_value = ex_emit_expr(e, node.children[1])
    let else_value = ex_emit_expr(e, node.children[2])
    return "(xr_cond(" + tmp + ") ? " + then_value + " : " + else_value + ")"
}

pub fn ex_emit_is(e: mut Emitter, node: Node): string {
    if node.children.len < 2 {
        return "xr_bool(0)"
    }
    let value = ex_emit_expr(e, node.children[0])
    let ty = ex_type_text(e, node.children[1])
    if node.value == "is not" {
        return "xr_bool(!xr_is(" + value + ", " + bk_util::c_string(ty) + "))"
    }
    return "xr_bool(xr_is(" + value + ", " + bk_util::c_string(ty) + "))"
}

pub fn ex_type_text(e: Emitter, node: Node): string {
    if node.kind == "TypeName" {
        return node.value
    }
    if node.kind == "FnType" or node.kind == "FunctionType" {
        return "fn"
    }
    if node.kind == "OptionalType" or node.kind == "ListType" {
        if node.children.len > 0 {
            return ex_type_text(e, node.children[0])
        }
    }
    if node.kind == "TupleType" {
        let mut out = StringBuilder::new()
        out.append("(")
        let mut i = 0
        while i < node.children.len {
            if i > 0 {
                out.append(", ")
            }
            out.append(ex_type_text(e, node.children[i]))
            i = i + 1
        }
        out.append(")")
        return out.build()
    }
    return node.value
}

pub fn ex_emit_member(e: mut Emitter, node: Node): string {
    let recv = ex_emit_expr(e, node.children[0])
    if node.value == "len" {
        return "xr_int(xr_len(" + recv + "))"
    }
    if node.value == "byte_len" {
        return "xr_int(xr_byte_len(" + recv + "))"
    }
    return "xr_get_field(" + recv + ", " + bk_util::c_string(node.value) + ")"
}

pub fn ex_emit_optional_member(e: mut Emitter, node: Node): string {
    let recv = ex_emit_expr(e, node.children[0])
    if node.value == "len" {
        return "xr_int(xr_len(" + recv + "))"
    }
    return "xr_get_field_opt(" + recv + ", " + bk_util::c_string(node.value) + ")"
}

pub fn ex_emit_map(e: mut Emitter, node: Node): string {
    // Object literals lower to a runtime object: members are field
    // entries, and `{ ...base, k: v }` merges base's fields first.
    let tmp = bk_state::co_new_tmp(e)
    bk_state::co_line(e, "XVal " + tmp + " = xr_map_new();")
    for child in node.children {
        if child.kind == "Spread" {
            let value = ex_emit_expr(e, child.children[0])
            bk_state::co_line(e, "xr_map_merge(" + tmp + ", " + value + ");")
            continue
        }
        if child.children.len == 0 {
            bk_state::co_fail(e, "a map entry needs a value")
            return "xr_nil()"
        }
        if child.value == "" {
            // Typed map literal: the key is an expression, so the entry
            // holds `[key, value]` and any hashable key reaches the
            // runtime, which stringifies non-string keys.
            if child.children.len < 2 {
                bk_state::co_fail(e, "a map entry needs a key and a value")
                return "xr_nil()"
            }
            let key = ex_emit_expr(e, child.children[0])
            let value = ex_emit_expr(e, child.children[1])
            bk_state::co_line(e, "xr_map_set(" + tmp + ", " + key + ", " + value + ");")
            continue
        }
        let value = ex_emit_expr(e, child.children[0])
        bk_state::co_line(e, 
            "xr_map_set(" + tmp + ", xr_str(" + bk_util::c_string(child.value) + "), " + value + ");",
        )
    }
    return tmp
}

pub fn ex_emit_list(e: mut Emitter, node: Node): string {
    let tmp = bk_state::co_new_tmp(e)
    bk_state::co_line(e, "XVal " + tmp + " = xr_list_new();")
    let mut i = 0
    while i < node.children.len {
        let child = node.children[i]
        if child.kind == "Spread" {
            let value = ex_emit_expr(e, child.children[0])
            bk_state::co_line(e, "xr_list_extend(" + tmp + ", " + value + ");")
        } else {
            let value = ex_emit_expr(e, child)
            bk_state::co_line(e, "xr_list_push(" + tmp + ", " + value + ");")
        }
        i = i + 1
    }
    return tmp
}

pub fn ex_arg_expr(e: mut Emitter, node: Node): string {
    if node.kind == "Arg" {
        if node.children.len == 0 {
            return "xr_nil()"
        }
        return ex_emit_expr(e, node.children[0])
    }
    return ex_emit_expr(e, node)
}

pub fn ex_one_arg(e: mut Emitter, node: Node, name: string): string {
    if node.children.len != 2 {
        bk_state::co_fail(e, "`" + name + "` expects one argument")
        return "xr_nil()"
    }
    return ex_arg_expr(e, node.children[1])
}

pub fn ex_eval_args(e: mut Emitter, children: List<Node>, start: number): List<string> {
    let values: List<string> = []
    let mut i = start
    while i < children.len {
        let value = ex_arg_expr(e, children[i])
        let tmp = bk_state::co_new_tmp(e)
        bk_state::co_line(e, "XVal " + tmp + " = " + value + ";")
        values.push(tmp)
        i = i + 1
    }
    return values
}

pub fn ex_value_array(e: Emitter, values: List<string>): string {
    if values.len == 0 {
        return "NULL"
    }
    return "(XVal[]){" + bk_util::c_join(values) + "}"
}

pub fn ex_name_array(e: Emitter, names: List<string>): string {
    if names.len == 0 {
        return "NULL"
    }
    let mut out = StringBuilder::new()
    out.append("(const char*[]){")
    let mut i = 0
    while i < names.len {
        if i > 0 {
            out.append(", ")
        }
        out.append(bk_util::c_string(names[i]))
        i = i + 1
    }
    out.append("}")
    return out.build()
}
