// Stage 1's own tests. Run from the repository root:
//
//     xulo test xuloc/src/tests.xulo
//     xupm test xuloc/src/tests.xulo
//
// They exercise the lexer and parser directly and parse every stage 1 source
// file, which is the T5b smoke test in executable form.

mod ast;
mod checker;
mod lexer;
mod parser;

use ast::{render, Node};
use checker::{check, CheckResult};
use lexer::{lex, LexResult, Token};
use parser::{parse, ParseResult};

fn parse_source(source: string): ParseResult {
    let lexed: LexResult = lex(source)
    return parse(lexed.tokens)
}

fn contains(text: string, needle: string): bool {
    return text.split(needle).len > 1
}

#[test]
fn lexes_keywords_identifiers_and_spans() {
    let result: LexResult = lex("fn main() { let x = 1 + 2 }")
    assert(result.error == "", "a simple function must lex")
    assert(result.tokens.len == 13, "twelve tokens plus EOF")
    assert(result.tokens[0].kind == "keyword", "fn is a keyword")
    assert(result.tokens[0].text == "fn", "keyword text")
    assert(result.tokens[0].start == 0, "fn starts at offset 0")
    assert(result.tokens[0].end == 2, "fn ends at offset 2")
    assert(result.tokens[1].kind == "ident", "main is an identifier")
    assert(result.tokens[1].line == 1, "line is 1-based")
    assert(result.tokens[1].column == 4, "column is 1-based")
}

#[test]
fn lexes_lines_comments_and_longest_operator() {
    let result: LexResult = lex("let a = 1\nlet b = 2 // tail\nc /* mid */ ?.d")
    assert(result.error == "", "comments are skipped")
    assert(result.tokens[4].text == "let", "second let")
    assert(result.tokens[4].line == 2, "second line")
    assert(result.tokens[4].column == 1, "column resets after LF")
    assert(result.tokens[4].start == 10, "second line starts at offset 10")
    let mut found = false
    for token in result.tokens {
        if token.text == "?." {
            found = true
        }
    }
    assert(found, "`?.` is one longest-match token")
}

#[test]
fn rejects_unterminated_lexical_forms() {
    let comment: LexResult = lex("/* left open")
    assert(comment.error == "unterminated block comment", "block comment error")
    let text: LexResult = lex("\"left open")
    assert(text.error == "unterminated string literal", "string error")
}

#[test]
fn parses_a_recursive_function() {
    let source = "fn fib(n: number): number {\n    if n <= 1 {\n        return n\n    }\n    return fib(n - 1) + fib(n - 2)\n}\n"
    let result: ParseResult = parse_source(source)
    assert(result.error == "", "fib must parse")
    assert(result.root.kind == "Program", "root is Program")
    assert(result.root.children.len == 1, "one top-level declaration")
    let fn_node: Node = result.root.children[0]
    assert(fn_node.kind == "Fn", "the declaration is a function")
    assert(fn_node.value == "fib", "function name")
    assert(fn_node.children.len == 3, "param, return type, body")
    assert(fn_node.children[0].kind == "Param", "parameter")
    assert(fn_node.children[1].kind == "TypeName", "return type")
    assert(fn_node.children[2].kind == "Block", "body block")
    assert(fn_node.end == source.len - 1, "the span reaches the closing brace")
}

#[test]
fn reports_the_error_position() {
    let result: ParseResult = parse_source("fn main( {\n}\n")
    assert(result.error != "", "malformed parameters must fail")
    assert(result.line == 1, "error is on the first line")
    assert(result.column > 0, "error carries a column")
}

#[test]
fn renders_the_tree() {
    let result: ParseResult = parse_source("let x = 1 + 2")
    let text = render(result.root, 0)
    assert(text.slice(0, 7) == "Program", "render starts with Program")
    assert(text.len > 20, "render includes children")
}

#[test]
fn parses_its_own_source() {
    let files = [
        "xuloc/src/ast.xulo",
        "xuloc/src/lexer.xulo",
        "xuloc/src/parser.xulo",
        "xuloc/src/checker.xulo",
        "xuloc/src/main.xulo",
        "xuloc/src/tests.xulo",
    ]
    for path in files {
        match std::fs::read(path) {
            Result::Ok(source) => {
                let lexed: LexResult = lex(source)
                assert(lexed.error == "", path + ": lex failed: " + lexed.error)
                let result: ParseResult = parse(lexed.tokens)
                assert(result.error == "", path + ": parse failed: " + result.error)
                assert(result.root.children.len > 0, path + ": empty tree")
            }
            Result::Err(error) => {
                assert(false, path + ": cannot read: " + error.message)
            }
        }
    }
}

#[test]
fn checker_accepts_the_bootstrap_corpus() {
    let files = [
        "xuloc/corpus/accept/fibonacci.xulo",
        "xuloc/corpus/accept/basics.xulo",
        "xuloc/corpus/accept/modules.xulo",
        "xuloc/corpus/accept/enums.xulo",
        "xuloc/corpus/accept/aliases.xulo",
        "xuloc/corpus/accept/methods.xulo",
        "xuloc/corpus/accept/results.xulo",
        "xuloc/corpus/accept/collections.xulo",
        "xuloc/corpus/accept/closures.xulo",
        "xuloc/corpus/accept/unions.xulo",
        "xuloc/corpus/accept/concurrency.xulo",
        "xuloc/corpus/accept/extern.xulo",
        "xuloc/corpus/accept/generics.xulo",
        "xuloc/corpus/accept/imports.xulo",
    ]
    for path in files {
        match std::fs::read(path) {
            Result::Ok(source) => {
                let lexed: LexResult = lex(source)
                assert(lexed.error == "", path + ": lex failed: " + lexed.error)
                let parsed: ParseResult = parse(lexed.tokens)
                assert(parsed.error == "", path + ": parse failed: " + parsed.error)
                let result: CheckResult = check(parsed.root)
                assert(
                    result.ok,
                    path + ": " + result.code + ": " + result.message,
                )
            }
            Result::Err(error) => {
                assert(false, path + ": cannot read: " + error.message)
            }
        }
    }
}

#[test]
fn checker_rejects_the_bad_corpus() {
    let files = [
        "xuloc/corpus/reject/undefined_name.xulo",
        "xuloc/corpus/reject/type_mismatch.xulo",
        "xuloc/corpus/reject/arity.xulo",
        "xuloc/corpus/reject/condition.xulo",
        "xuloc/corpus/reject/not_iterable.xulo",
        "xuloc/corpus/reject/return_mismatch.xulo",
        "xuloc/corpus/reject/module_return_mismatch.xulo",
        "xuloc/corpus/reject/struct_field_mismatch.xulo",
        "xuloc/corpus/reject/alias_mismatch.xulo",
    ]
    for path in files {
        match std::fs::read(path) {
            Result::Ok(source) => {
                let lexed: LexResult = lex(source)
                assert(lexed.error == "", path + ": lex failed: " + lexed.error)
                let parsed: ParseResult = parse(lexed.tokens)
                assert(parsed.error == "", path + ": parse failed: " + parsed.error)
                let result: CheckResult = check(parsed.root)
                assert(!result.ok, path + ": was accepted")
                assert(result.code.slice(0, 1) == "E", path + ": no error code")
                assert(result.line > 0, path + ": no line")
                assert(result.column > 0, path + ": no column")
            }
            Result::Err(error) => {
                assert(false, path + ": cannot read: " + error.message)
            }
        }
    }
}

#[test]
fn checker_reports_code_and_position() {
    let parsed: ParseResult = parse_source("fn main() { print(total) }\n")
    let result: CheckResult = check(parsed.root)
    assert(!result.ok, "an undefined name must fail")
    assert(result.code == "E0101", "error code")
    assert(result.line == 1, "error line")
    assert(result.column == 19, "error column")
}

#[test]
fn parses_template_interpolation() {
    let parsed: ParseResult = parse_source("fn main() { print(`a ${1 + 2} b`) }\n")
    assert(parsed.error == "", "a template literal must parse")
    let mut body: Node = parsed.root.children[0]
    for child in parsed.root.children[0].children {
        if child.kind == "Block" {
            body = child
        }
    }
    let call: Node = body.children[0].children[0]
    let template: Node = call.children[1]
    assert(template.kind == "Template", "the argument is a template")
    assert(template.children.len == 3, "text, expression, text")
    assert(template.children[0].kind == "TemplateText", "leading text")
    assert(template.children[0].value == "a ", "leading text value")
    assert(template.children[1].kind == "Binary", "interpolation is an expression")
    assert(template.children[2].value == " b", "trailing text value")
}

#[test]
fn parses_postfix_propagation_beside_ternary() {
    let source = "fn f(): Result<int, Error> { Result::Ok(1) }\nfn main() {\n    let x = f()?\n    let y = x > 0 ? 1 : 2\n}\n"
    let result: ParseResult = parse_source(source)
    assert(result.error == "", "postfix `?` and ternary must parse: " + result.error)
    let text = render(result.root, 0)
    assert(contains(text, "Try ?"), "the propagation is a Try node")
    assert(contains(text, "Ternary ?"), "the ternary keeps its own node")
}

#[test]
fn parses_arrow_closures_and_call_type_arguments() {
    let source = "fn main() {\n    let triple = (x: number): number => x * 3\n    let square = x => x * x\n    let block = (a: string) => { a }\n    let filled = Array::filled<int, 3>(7)\n}\n"
    let result: ParseResult = parse_source(source)
    assert(result.error == "", "arrow closures and type arguments must parse: " + result.error)
    let text = render(result.root, 0)
    assert(contains(text, "ArrowClosure"), "arrow closures have their own node")
    assert(contains(text, "TypeApply"), "call-site type arguments are recorded")
}

#[test]
fn parses_tuple_position_chains_and_chained_assignment() {
    let source = "fn main() {\n    let p = ((1, 2), \"x\")\n    let nested = p.0.1\n    let mut a = 0\n    let mut b = 0\n    a = b = 3\n    print(nested, a, b)\n}\n"
    let result: ParseResult = parse_source(source)
    assert(result.error == "", "tuple chains and chained assignment must parse: " + result.error)
    let text = render(result.root, 0)
    assert(contains(text, "Member 1"), "the chained tuple position is a member")
    assert(contains(text, "Assign"), "the assignment is recorded")
}

#[test]
fn parses_literal_types_macros_spawn_and_lock() {
    let source = "type Version = \"v1\" | \"v2\"\nfn main() {\n    let answer = six!()\n    let job = spawn async { 1 }\n    let counter = shared 0\n    lock counter { print(counter) }\n    let version: Version = \"v1\"\n}\n"
    let result: ParseResult = parse_source(source)
    assert(result.error == "", "the remaining corpus forms must parse: " + result.error)
    let text = render(result.root, 0)
    assert(contains(text, "LiteralType"), "a literal type is recorded")
    assert(contains(text, "MacroCall"), "a function-macro call is recorded")
    assert(contains(text, "Spawn"), "spawn has its own node")
    assert(contains(text, "Lock"), "lock has its own node")
}

#[test]
fn checker_accepts_an_inner_type_for_an_optional() {
    let parsed: ParseResult = parse_source("fn main() { let x: string? = \"a\" }\n")
    let result: CheckResult = check(parsed.root)
    assert(result.ok, "a string fits a string? binding")
    assert(result.complete, "the checker modeled the whole program")
}

#[test]
fn checker_marks_partial_analysis() {
    let unsupported: ParseResult = parse_source("trait Area {\n    fn area(self): number;\n}\nfn main() {}\n")
    let partial: CheckResult = check(unsupported.root)
    assert(!partial.complete, "an unsupported construct is not a verdict")

    let wrong: ParseResult = parse_source("fn main() { let x: int = \"a\" }\n")
    let confirmed: CheckResult = check(wrong.root)
    assert(!confirmed.ok, "the mismatch must fail")
    assert(confirmed.complete, "the mismatch is a confirmed error")
    assert(confirmed.code == "E0201", "type mismatch code")
}
