// xuloc's first semantic pass.
//
// The checker works on the generic AST and covers the front-end subset stage 1
// needs for Gate 3: functions, parameters, primitive types, `List<T>`, `T?`,
// `let`/`const`, assignment, `return`, `if`/`else`, `while`, `for`, calls,
// arithmetic/comparison/logical operators, indexing, and the `print`/`str`/
// `assert`/`panic` intrinsics.
//
// It deliberately reports "not supported yet" (E0003) for declarations it does
// not understand instead of silently accepting them. Inline modules, their
// `use` paths (aliases, groups, globs), and `pub use` re-exports are modeled;
// a file-backed module is opaque because the checker has no loader. Simple
// structs are modeled too: field types, constructors, and member reads.
// Enums, traits, impls, generics, closures, and `match` arrive in later WP6
// slices.
//
// Types are canonical strings (`number`, `string`, `bool`, `unit`, `unknown`,
// `null`, `List<T>`, `T?`) so comparisons never depend on structural equality.
// Scopes are a flat binding list plus a scope-id stack; leaving a block only
// decrements the active scope count, so the checker avoids list `pop`/
// `truncate`, which the AOT runtime does not lower yet.

use ast::{Node};

pub struct CheckResult {
    pub ok: bool,
    /// Whether the checker saw the whole program with constructs it models.
    /// `false` means it reached a declaration, type, or call it cannot judge
    /// (E0003, an unknown type name, a std/module function, a method call), so
    /// a failure is "not checked", not a confirmed error.
    pub complete: bool,
    pub code: string,
    pub message: string,
    pub line: number,
    pub column: number,
}

pub struct Binding {
    name: string,
    ty: string,
    scope: number,
}

pub struct FuncSig {
    name: string,
    module_id: string,
    is_pub: bool,
    params: List<string>,
    ret: string,
    /// The declaration, kept so parameter and return types are resolved after
    /// every module and struct name is known.
    decl: Node,
}

pub struct ConstSig {
    name: string,
    ty: string,
    is_pub: bool,
}

pub struct FieldSig {
    name: string,
    ty: string,
}

pub struct StructSig {
    name: string,
    module_id: string,
    is_pub: bool,
    /// Field type annotations, resolved after every struct name is known.
    field_nodes: List<Node>,
    fields: List<FieldSig>,
}

pub struct ImportSig {
    alias: string,
    target: string,
    member: string,
    is_pub: bool,
}

pub struct GlobSig {
    target: string,
    is_pub: bool,
}

/// One module's namespace: its declarations and the `use` statements that
/// name other modules. A file-backed module is `opaque`: the checker has no
/// loader, so a call into it is "not modeled" rather than an error.
pub struct ModuleSig {
    id: string,
    parent: string,
    opaque: bool,
    consts: List<ConstSig>,
    imports: List<ImportSig>,
    globs: List<GlobSig>,
    uses: List<Node>,
    /// Type names imported from an opaque module or `std`: the checker cannot
    /// inspect their shape, so uses are "unknown", not errors.
    foreign_types: List<string>,
}

pub struct Checker {
    functions: List<FuncSig>,
    structs: List<StructSig>,
    modules: List<ModuleSig>,
    current_module: string,
    bindings: List<Binding>,
    scopes: List<number>,
    active_scopes: number,
    next_scope: number,
    current_return: string,
    complete: bool,
    error: string,
    code: string,
    line: number,
    column: number,
}

pub fn check(root: Node): CheckResult {
    let mut checker = Checker(
        functions: [],
        structs: [],
        modules: [],
        current_module: "",
        bindings: [],
        scopes: [],
        active_scopes: 0,
        next_scope: 1,
        current_return: "unit",
        complete: true,
        error: "",
        code: "",
        line: 1,
        column: 1,
    )
    checker.enter_scope()
    checker.add_module("", "#", false)
    checker.collect_structs(root, "")
    checker.collect_functions(root, "")
    checker.resolve_uses()
    checker.resolve_structs()
    checker.resolve_function_signatures()
    if checker.error == "" {
        checker.check_program(root)
    }
    return CheckResult(
        ok: checker.error == "",
        complete: checker.complete,
        code: checker.code,
        message: checker.error,
        line: checker.line,
        column: checker.column,
    )
}

impl Checker {
    // ── diagnostics and scopes ───────────────────────────────────────────

    fn fail(mut self, node: Node, code: string, message: string) {
        if self.error == "" {
            self.error = message
            self.code = code
            self.line = node.line
            self.column = node.column
        }
        if code == "E0003" {
            self.complete = false
        }
    }

    fn enter_scope(mut self) {
        self.scopes.push(self.next_scope)
        self.next_scope = self.next_scope + 1
        self.active_scopes = self.active_scopes + 1
    }

    fn leave_scope(mut self) {
        if self.active_scopes > 0 {
            self.active_scopes = self.active_scopes - 1
        }
    }

    fn scope_active(self, scope: number): bool {
        let mut i = 0
        while i < self.active_scopes {
            if self.scopes[i] == scope {
                return true
            }
            i = i + 1
        }
        return false
    }

    fn bind(mut self, name: string, ty: string) {
        if name == "" or name == "_" {
            return
        }
        let scope = self.scopes[self.active_scopes - 1]
        self.bindings.push(Binding(name: name, ty: ty, scope: scope))
    }

    fn lookup(self, name: string): string {
        let mut i = self.bindings.len
        while i > 0 {
            i = i - 1
            let binding = self.bindings[i]
            if binding.name == name and self.scope_active(binding.scope) {
                return binding.ty
            }
        }
        return ""
    }

    fn module_index(self, module_id: string): number {
        let mut i = 0
        while i < self.modules.len {
            if self.modules[i].id == module_id {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn add_module(mut self, module_id: string, parent: string, opaque: bool) {
        if self.module_index(module_id) >= 0 {
            return
        }
        self.modules.push(
            ModuleSig(
                id: module_id,
                parent: parent,
                opaque: opaque,
                consts: [],
                imports: [],
                globs: [],
                uses: [],
                foreign_types: [],
            ),
        )
    }

    fn child_module(self, parent: string, name: string): string {
        let id = if parent == "" { name } else { parent + "::" + name }
        if self.module_index(id) >= 0 {
            return id
        }
        return "#"
    }

    fn module_parent(self, module_id: string): string {
        let index = self.module_index(module_id)
        if index < 0 {
            return "#"
        }
        return self.modules[index].parent
    }

    fn import_module(self, module_id: string, name: string): string {
        let index = self.module_index(module_id)
        if index < 0 {
            return "#"
        }
        let mut i = self.modules[index].imports.len - 1
        while i >= 0 {
            let import = self.modules[index].imports[i]
            if import.alias == name and import.member == "" {
                return import.target
            }
            i = i - 1
        }
        return "#"
    }

    /// Walk a module path from `from`; `"#"` means the path leaves the
    /// package (or names a module that is not in this file).
    fn resolve_module(self, from: string, head: string, segments: List<string>): string {
        let mut current = ""
        if head == "self" {
            current = from
        } else if head == "super" {
            current = self.module_parent(from)
            if current == "#" {
                return "#"
            }
        } else {
            current = self.child_module(from, head)
            if current == "#" {
                current = self.import_module(from, head)
            }
            if current == "#" {
                current = self.child_module("", head)
            }
            if current == "#" {
                return "#"
            }
        }
        let mut i = 0
        while i < segments.len {
            let segment = segments[i]
            if segment == "self" {
                i = i + 1
                continue
            }
            if segment == "super" {
                let parent = self.module_parent(current)
                if parent == "#" {
                    return "#"
                }
                current = parent
                i = i + 1
                continue
            }
            let child = self.child_module(current, segment)
            if child != "#" {
                current = child
            } else {
                let aliased = self.import_module(current, segment)
                if aliased == "#" {
                    return "#"
                }
                current = aliased
            }
            i = i + 1
        }
        return current
    }

    fn find_function_in(self, module_id: string, name: string): number {
        let mut i = self.functions.len
        while i > 0 {
            i = i - 1
            let sig = self.functions[i]
            if sig.module_id == module_id and sig.name == name {
                return i
            }
        }
        return -1
    }

    fn find_const_in(self, module_id: string, name: string): number {
        let index = self.module_index(module_id)
        if index < 0 {
            return -1
        }
        let mut i = 0
        while i < self.modules[index].consts.len {
            if self.modules[index].consts[i].name == name {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn find_struct_in(self, module_id: string, name: string): number {
        let mut i = self.structs.len
        while i > 0 {
            i = i - 1
            if self.structs[i].module_id == module_id and self.structs[i].name == name {
                return i
            }
        }
        return -1
    }

    fn struct_canonical(self, index: number): string {
        if index < 0 or index >= self.structs.len {
            return "unknown"
        }
        let sig = self.structs[index]
        if sig.module_id == "" {
            return sig.name
        }
        return sig.module_id + "::" + sig.name
    }

    fn find_struct_by_type(self, ty: string): number {
        let mut i = 0
        while i < self.structs.len {
            if self.struct_canonical(i) == ty {
                return i
            }
            i = i + 1
        }
        return -1
    }

    /// Local view: this module's struct, then `use` imports and globs.
    fn resolve_struct(self, module_id: string, name: string, depth: number): number {
        if depth > 32 {
            return -1
        }
        let own = self.find_struct_in(module_id, name)
        if own >= 0 {
            return own
        }
        let scope = self.module_index(module_id)
        if scope < 0 {
            return -1
        }
        let mut i = self.modules[scope].imports.len - 1
        while i >= 0 {
            let import = self.modules[scope].imports[i]
            if import.alias == name and import.member != "" {
                let found = self.export_struct(import.target, import.member, depth + 1)
                if found != -1 {
                    return found
                }
            }
            i = i - 1
        }
        i = self.modules[scope].globs.len - 1
        while i >= 0 {
            let found = self.export_struct(self.modules[scope].globs[i].target, name, depth + 1)
            if found != -1 {
                return found
            }
            i = i - 1
        }
        return -1
    }

    fn export_struct(self, module_id: string, name: string, depth: number): number {
        if depth > 32 {
            return -1
        }
        let index = self.module_index(module_id)
        if index < 0 or self.modules[index].opaque {
            return -1
        }
        let own = self.find_struct_in(module_id, name)
        if own >= 0 {
            if self.structs[own].is_pub {
                return own
            }
            return -1
        }
        let mut i = self.modules[index].imports.len - 1
        while i >= 0 {
            let import = self.modules[index].imports[i]
            if import.alias == name and import.is_pub and import.member != "" {
                let found = self.export_struct(import.target, import.member, depth + 1)
                if found != -1 {
                    return found
                }
            }
            i = i - 1
        }
        i = self.modules[index].globs.len - 1
        while i >= 0 {
            if self.modules[index].globs[i].is_pub {
                let found = self.export_struct(self.modules[index].globs[i].target, name, depth + 1)
                if found != -1 {
                    return found
                }
            }
            i = i - 1
        }
        return -1
    }

    /// Resolve a name used as a value in `module_id`: a module constant, or a
    /// constant reached through `use`. Returns `""` when it is not a value.
    fn value_type(self, module_id: string, name: string, depth: number): string {
        if depth > 32 {
            return ""
        }
        let index = self.find_const_in(module_id, name)
        if index >= 0 {
            let ty = self.modules[self.module_index(module_id)].consts[index].ty
            if ty != "" {
                return ty
            }
            return "unknown"
        }
        let scope = self.module_index(module_id)
        if scope < 0 {
            return ""
        }
        let mut i = self.modules[scope].imports.len - 1
        while i >= 0 {
            let import = self.modules[scope].imports[i]
            if import.alias == name and import.member != "" {
                let ty = self.export_value_type(import.target, import.member, depth + 1)
                if ty != "" {
                    return ty
                }
            }
            i = i - 1
        }
        i = self.modules[scope].globs.len - 1
        while i >= 0 {
            let ty = self.export_value_type(self.modules[scope].globs[i].target, name, depth + 1)
            if ty != "" {
                return ty
            }
            i = i - 1
        }
        return ""
    }

    fn path_value_type(self, path: string): string {
        let parts = split_path(path)
        if parts.len < 2 {
            return ""
        }
        let mut segments: List<string> = []
        let mut i = 1
        while i + 1 < parts.len {
            segments.push(parts[i])
            i = i + 1
        }
        let target = self.resolve_module(self.current_module, parts[0], segments)
        if target == "#" {
            return ""
        }
        return self.export_value_type(target, parts[parts.len - 1], 0)
    }

    fn export_value_type(self, module_id: string, name: string, depth: number): string {
        if depth > 32 {
            return ""
        }
        let index = self.module_index(module_id)
        if index < 0 {
            return ""
        }
        if self.modules[index].opaque {
            return "unknown"
        }
        let c = self.find_const_in(module_id, name)
        if c >= 0 and self.modules[index].consts[c].is_pub {
            let ty = self.modules[index].consts[c].ty
            if ty != "" {
                return ty
            }
            return "unknown"
        }
        let mut i = self.modules[index].imports.len - 1
        while i >= 0 {
            let import = self.modules[index].imports[i]
            if import.alias == name and import.is_pub and import.member != "" {
                let ty = self.export_value_type(import.target, import.member, depth + 1)
                if ty != "" {
                    return ty
                }
            }
            i = i - 1
        }
        i = self.modules[index].globs.len - 1
        while i >= 0 {
            if self.modules[index].globs[i].is_pub {
                let ty = self.export_value_type(self.modules[index].globs[i].target, name, depth + 1)
                if ty != "" {
                    return ty
                }
            }
            i = i - 1
        }
        return ""
    }

    /// Function index (`>= 0`), `-1` for a name this package does not define,
    /// or `-2` when the answer is hidden behind an opaque/file-backed module.
    fn resolve_function(self, from: string, path: string, depth: number): number {
        if depth > 32 {
            return -1
        }
        let parts = split_path(path)
        if parts.len == 1 {
            let own = self.find_function_in(from, parts[0])
            if own >= 0 {
                return own
            }
            let scope = self.module_index(from)
            if scope < 0 {
                return -1
            }
            let mut i = self.modules[scope].imports.len - 1
            while i >= 0 {
                let import = self.modules[scope].imports[i]
                if import.alias == parts[0] and import.member != "" {
                    let found = self.export_function(import.target, import.member, depth + 1)
                    if found != -1 {
                        return found
                    }
                }
                i = i - 1
            }
            i = self.modules[scope].globs.len - 1
            while i >= 0 {
                let found = self.export_function(self.modules[scope].globs[i].target, parts[0], depth + 1)
                if found != -1 {
                    return found
                }
                i = i - 1
            }
            return -1
        }
        let head = parts[0]
        let mut segments: List<string> = []
        let mut i = 1
        while i + 1 < parts.len {
            segments.push(parts[i])
            i = i + 1
        }
        let target = self.resolve_module(from, head, segments)
        if target == "#" {
            return -2
        }
        return self.export_function(target, parts[parts.len - 1], depth + 1)
    }

    fn export_function(self, module_id: string, name: string, depth: number): number {
        if depth > 32 {
            return -1
        }
        let index = self.module_index(module_id)
        if index < 0 {
            return -1
        }
        if self.modules[index].opaque {
            return -2
        }
        let own = self.find_function_in(module_id, name)
        if own >= 0 {
            if self.functions[own].is_pub {
                return own
            }
            return -1
        }
        let mut i = self.modules[index].imports.len - 1
        while i >= 0 {
            let import = self.modules[index].imports[i]
            if import.alias == name and import.is_pub and import.member != "" {
                let found = self.export_function(import.target, import.member, depth + 1)
                if found != -1 {
                    return found
                }
            }
            i = i - 1
        }
        i = self.modules[index].globs.len - 1
        while i >= 0 {
            if self.modules[index].globs[i].is_pub {
                let found = self.export_function(self.modules[index].globs[i].target, name, depth + 1)
                if found != -1 {
                    return found
                }
            }
            i = i - 1
        }
        return -1
    }

    // ── types ────────────────────────────────────────────────────────────

    fn is_type_node(self, node: Node): bool {
        return node.kind == "TypeName"
            or node.kind == "OptionalType"
            or node.kind == "TupleType"
            or node.kind == "FnType"
    }

    fn type_of(mut self, node: Node): string {
        if self.error != "" {
            return "unknown"
        }
        if node.kind == "OptionalType" {
            if node.children.len == 0 {
                self.complete = false
                self.fail(node, "E0101", "an optional type needs an inner type")
                return "unknown"
            }
            return self.type_of(node.children[0]) + "?"
        }
        if node.kind != "TypeName" {
            self.fail(node, "E0003", "stage 1 checker does not support this type yet")
            return "unknown"
        }
        let name = node.value
        if name == "int"
            or name == "i8"
            or name == "i16"
            or name == "i32"
            or name == "i64"
            or name == "u8"
            or name == "u16"
            or name == "u32"
            or name == "u64"
            or name == "usize"
            or name == "isize"
            or name == "float"
            or name == "f32"
            or name == "f64"
            or name == "number"
        {
            return "number"
        }
        if name == "bool" {
            return "bool"
        }
        if name == "string" {
            return "string"
        }
        if name == "unit" {
            return "unit"
        }
        if name == "unknown" {
            return "unknown"
        }
        if name == "List" or name == "Array" {
            let mut i = 0
            while i < node.children.len {
                let child = node.children[i]
                if child.kind == "TypeArgs" and child.children.len > 0 {
                    let elem = self.type_of(child.children[0])
                    return "List<" + elem + ">"
                }
                i = i + 1
            }
            self.complete = false
            self.fail(node, "E0101", "`" + name + "` needs a type argument")
            return "unknown"
        }
        let struct_index = self.resolve_struct(self.current_module, name, 0)
        if struct_index >= 0 {
            return self.struct_canonical(struct_index)
        }
        if self.is_foreign_type(self.current_module, name) {
            // `use type opaque::Meters`: the name is a type by declaration,
            // but its definition is outside this checker's input.
            self.complete = false
            return "unknown"
        }
        // Enum, alias, generic parameter, and opaque imported types are not
        // modeled here; the name is unknown to the checker, not necessarily
        // wrong, so `build` must not reject on this alone.
        self.complete = false
        self.fail(node, "E0101", "unknown type `" + name + "`")
        return "unknown"
    }

    fn is_number(self, ty: string): bool {
        return ty == "number"
    }

    fn is_optional(self, ty: string): bool {
        if ty.len == 0 {
            return false
        }
        return ty.slice(ty.len - 1, ty.len) == "?"
    }

    fn optional_inner(self, ty: string): string {
        if !self.is_optional(ty) {
            return ty
        }
        return ty.slice(0, ty.len - 1)
    }

    fn is_list(self, ty: string): bool {
        if ty.len < 6 {
            return false
        }
        return ty.slice(0, 5) == "List<"
    }

    fn list_element(self, ty: string): string {
        if !self.is_list(ty) {
            return "unknown"
        }
        return ty.slice(5, ty.len - 1)
    }

    fn assignable(self, expected: string, actual: string): bool {
        if expected == actual {
            return true
        }
        if expected == "unknown" {
            return true
        }
        if actual == "unknown" {
            return false
        }
        if self.is_number(expected) and self.is_number(actual) {
            return true
        }
        if actual == "null" {
            return self.is_optional(expected)
        }
        if self.is_optional(expected) {
            // `T` fits `T?`: the optional adds null to the domain.
            return self.assignable(self.optional_inner(expected), actual)
        }
        if self.is_optional(actual) and self.is_optional(expected) {
            return self.assignable(self.optional_inner(expected), self.optional_inner(actual))
        }
        if self.is_list(expected) and self.is_list(actual) {
            return self.assignable(self.list_element(expected), self.list_element(actual))
        }
        return false
    }

    fn unify(mut self, node: Node, left: string, right: string): string {
        if left == right {
            return left
        }
        if self.assignable(left, right) {
            return left
        }
        if self.assignable(right, left) {
            return right
        }
        if self.is_optional(left) and right == "null" {
            return left
        }
        if self.is_optional(right) and left == "null" {
            return right
        }
        self.fail(
            node,
            "E0211",
            "`" + left + "` and `" + right + "` have no common type",
        )
        return "unknown"
    }

    // ── declarations ─────────────────────────────────────────────────────

    fn collect_functions(mut self, root: Node, module_id: string) {
        for item in root.children {
            if item.kind == "Fn" {
                self.add_function(item, module_id)
            } else if item.kind == "Const" {
                self.add_const_sig(item, module_id)
            } else if item.kind == "Mod" {
                self.collect_mod(item, module_id)
            } else if item.kind == "Use" {
                self.add_module_use(module_id, item)
            } else if item.kind == "Struct" {
                self.add_struct(item, module_id)
            }
        }
    }

    /// Register struct names before function signatures are read, so a
    /// parameter or return type may name a struct declared later.
    fn collect_structs(mut self, items: Node, module_id: string) {
        for item in items.children {
            if item.kind == "Struct" {
                self.add_struct(item, module_id)
            } else if item.kind == "Mod" and has_child_kind(item, "ModBody") {
                let child = if module_id == "" {
                    item.value
                } else {
                    module_id + "::" + item.value
                }
                self.collect_structs(item, child)
            }
        }
    }

    fn add_struct(mut self, item: Node, module_id: string) {
        if self.find_struct_in(module_id, item.value) >= 0 {
            return
        }
        let mut field_nodes: List<Node> = []
        for child in item.children {
            if child.kind == "Field" {
                field_nodes.push(child)
            }
        }
        self.structs.push(
            StructSig(
                name: item.value,
                module_id: module_id,
                is_pub: has_child_kind(item, "Pub"),
                field_nodes: field_nodes,
                fields: [],
            ),
        )
    }

    /// Fill struct field types after every struct name exists, so a field may
    /// name a struct declared later in the same module.
    fn resolve_structs(mut self) {
        let saved_module = self.current_module
        let mut i = 0
        while i < self.structs.len and self.error == "" {
            self.current_module = self.structs[i].module_id
            let mut f = 0
            while f < self.structs[i].field_nodes.len and self.error == "" {
                let field = self.structs[i].field_nodes[f]
                let mut ty = "unknown"
                for child in field.children {
                    if self.is_type_node(child) {
                        ty = self.type_of(child)
                    }
                }
                self.structs[i].fields.push(FieldSig(name: field.value, ty: ty))
                f = f + 1
            }
            i = i + 1
        }
        self.current_module = saved_module
    }

    fn collect_mod(mut self, item: Node, parent: string) {
        let module_id = if parent == "" { item.value } else { parent + "::" + item.value }
        let inline = has_child_kind(item, "ModBody")
        // A file-backed module lives in another file; the checker has no
        // loader, so its interface is opaque rather than "not found".
        self.add_module(module_id, parent, !inline)
        if !inline {
            return
        }
        for child in item.children {
            if child.kind == "Fn" {
                self.add_function(child, module_id)
            } else if child.kind == "Const" {
                self.add_const_sig(child, module_id)
            } else if child.kind == "Mod" {
                self.collect_mod(child, module_id)
            } else if child.kind == "Use" {
                self.add_module_use(module_id, child)
            } else if child.kind == "Struct" {
                self.add_struct(child, module_id)
            }
        }
    }

    fn add_function(mut self, item: Node, module_id: string) {
        if self.error != "" {
            return
        }
        self.functions.push(
            FuncSig(
                name: item.value,
                module_id: module_id,
                is_pub: has_child_kind(item, "Pub"),
                params: [],
                ret: "unit",
                decl: item,
            ),
        )
    }

    /// Resolve parameter and return types after `use` and struct names are
    /// known, so a signature may name an imported or forward-declared type.
    fn resolve_function_signatures(mut self) {
        let saved_module = self.current_module
        let mut i = 0
        while i < self.functions.len and self.error == "" {
            let sig = self.functions[i]
            self.current_module = sig.module_id
            let item = sig.decl
            let mut params: List<string> = []
            let mut ret = "unit"
            for child in item.children {
                if child.kind == "Param" {
                    if child.value == "self" or child.value == "mut self" {
                        self.fail(child, "E0003", "stage 1 checker does not support methods yet")
                        break
                    }
                    let mut ty = "unknown"
                    for part in child.children {
                        if self.is_type_node(part) {
                            ty = self.type_of(part)
                        }
                    }
                    params.push(ty)
                } else if self.is_type_node(child) {
                    ret = self.type_of(child)
                }
            }
            if self.error == "" {
                self.functions[i].params = params
                self.functions[i].ret = ret
            }
            i = i + 1
        }
        self.current_module = saved_module
    }

    fn add_const_sig(mut self, item: Node, module_id: string) {
        if self.error != "" {
            return
        }
        self.current_module = module_id
        let mut ty = ""
        for child in item.children {
            if self.is_type_node(child) {
                ty = self.type_of(child)
            }
        }
        let index = self.module_index(module_id)
        if index >= 0 and self.error == "" {
            self.modules[index].consts.push(
                ConstSig(name: item.value, ty: ty, is_pub: has_child_kind(item, "Pub")),
            )
        }
    }

    fn add_module_use(mut self, module_id: string, item: Node) {
        let index = self.module_index(module_id)
        if index >= 0 {
            self.modules[index].uses.push(item)
        }
    }

    fn resolve_uses(mut self) {
        let mut m = 0
        while m < self.modules.len {
            let module_id = self.modules[m].id
            let mut u = 0
            while u < self.modules[m].uses.len {
                let node = self.modules[m].uses[u]
                self.resolve_use(module_id, node)
                u = u + 1
            }
            m = m + 1
        }
    }

    fn resolve_use(mut self, module_id: string, node: Node) {
        let type_only = has_child_kind(node, "UseType")
        let is_pub = has_child_kind(node, "Pub")
        let head = node.value
        let mut segments: List<string> = []
        let mut alias = ""
        let mut group = node
        let mut has_group = false
        let mut glob = false
        for child in node.children {
            if child.kind == "UseSegment" {
                segments.push(child.value)
            } else if child.kind == "UseAlias" {
                alias = child.value
            } else if child.kind == "UseGroup" {
                group = child
                has_group = true
            } else if child.kind == "UseGlob" {
                glob = true
            }
        }
        if has_group {
            if head == "" {
                for entry in group.children {
                    self.mark_export(module_id, entry.value)
                }
                return
            }
            let prefix = self.resolve_module(module_id, head, segments)
            if prefix == "#" {
                return
            }
            for entry in group.children {
                let mut rel: List<string> = []
                let mut entry_alias = ""
                for child in entry.children {
                    if child.kind == "UseSegment" {
                        rel.push(child.value)
                    } else if child.kind == "UseAlias" {
                        entry_alias = child.value
                    }
                }
                let mut target = prefix
                let mut i = 0
                while i + 1 < rel.len {
                    let child = self.child_module(target, rel[i])
                    if child != "#" {
                        target = child
                    } else {
                        let aliased = self.import_module(target, rel[i])
                        if aliased == "#" {
                            target = "#"
                            break
                        }
                        target = aliased
                    }
                    i = i + 1
                }
                if target == "#" {
                    continue
                }
                let bound = if entry_alias == "" { entry.value } else { entry_alias }
                if type_only {
                    self.note_foreign_type(module_id, bound, target)
                }
                let child = self.child_module(target, entry.value)
                if child != "#" {
                    self.add_import(module_id, bound, child, "", is_pub)
                } else {
                    self.add_import(module_id, bound, target, entry.value, is_pub)
                }
            }
            return
        }
        if glob {
            let target = self.resolve_module(module_id, head, segments)
            if target != "#" {
                self.add_glob(module_id, target, is_pub)
            }
            return
        }
        if head == "" {
            return
        }
        if segments.len == 0 {
            let target = self.resolve_module(module_id, head, [])
            if target != "#" {
                let bound = if alias == "" { head } else { alias }
                self.add_import(module_id, bound, target, "", is_pub)
            }
            return
        }
        let member = segments[segments.len - 1]
        let mut prefix: List<string> = []
        let mut i = 0
        while i + 1 < segments.len {
            prefix.push(segments[i])
            i = i + 1
        }
        let target = self.resolve_module(module_id, head, prefix)
        if target == "#" {
            return
        }
        let bound = if alias == "" { member } else { alias }
        if type_only {
            self.note_foreign_type(module_id, bound, target)
        }
        let child = self.child_module(target, member)
        if child != "#" {
            self.add_import(module_id, bound, child, "", is_pub)
            return
        }
        self.add_import(module_id, bound, target, member, is_pub)
    }

    fn note_foreign_type(mut self, module_id: string, name: string, target: string) {
        let index = self.module_index(module_id)
        if index < 0 {
            return
        }
        if target == "#" {
            self.modules[index].foreign_types.push(name)
            return
        }
        let target_index = self.module_index(target)
        if target_index >= 0 and self.modules[target_index].opaque {
            self.modules[index].foreign_types.push(name)
        }
    }

    fn is_foreign_type(self, module_id: string, name: string): bool {
        let index = self.module_index(module_id)
        if index < 0 {
            return false
        }
        let mut i = 0
        while i < self.modules[index].foreign_types.len {
            if self.modules[index].foreign_types[i] == name {
                return true
            }
            i = i + 1
        }
        return false
    }

    fn add_import(mut self, module_id: string, bound: string,
                  target: string, member: string, is_pub: bool) {
        let index = self.module_index(module_id)
        if index >= 0 {
            self.modules[index].imports.push(
                ImportSig(alias: bound, target: target, member: member, is_pub: is_pub),
            )
        }
    }

    fn add_glob(mut self, module_id: string, target: string, is_pub: bool) {
        let index = self.module_index(module_id)
        if index >= 0 {
            self.modules[index].globs.push(GlobSig(target: target, is_pub: is_pub))
        }
    }

    fn mark_export(mut self, module_id: string, name: string) {
        let mut f = 0
        while f < self.functions.len {
            if self.functions[f].module_id == module_id and self.functions[f].name == name {
                self.functions[f].is_pub = true
            }
            f = f + 1
        }
        let index = self.module_index(module_id)
        if index < 0 {
            return
        }
        let mut c = 0
        while c < self.modules[index].consts.len {
            if self.modules[index].consts[c].name == name {
                self.modules[index].consts[c].is_pub = true
            }
            c = c + 1
        }
        let mut i = 0
        while i < self.modules[index].imports.len {
            if self.modules[index].imports[i].alias == name {
                self.modules[index].imports[i].is_pub = true
            }
            i = i + 1
        }
    }

    fn check_program(mut self, root: Node) {
        self.check_module_items(root, "", false)
    }

    fn check_module_items(mut self, items: Node, module_id: string, nested: bool) {
        let saved_module = self.current_module
        self.current_module = module_id
        if nested {
            self.enter_scope()
        }
        for item in items.children {
            if self.error != "" {
                break
            }
            if item.kind == "Fn" {
                self.check_function(item)
            } else if item.kind == "Let" {
                self.check_let(item)
            } else if item.kind == "Const" {
                self.check_const(item)
            } else if item.kind == "Mod" {
                if has_child_kind(item, "ModBody") {
                    let child = if module_id == "" {
                        item.value
                    } else {
                        module_id + "::" + item.value
                    }
                    self.check_module_items(item, child, true)
                }
                // A file-backed module's body is not in this buffer; calls
                // into it resolve as opaque instead of producing a false
                // "not found".
            } else if item.kind == "Attribute" or item.kind == "Use"
                or item.kind == "Pub" or item.kind == "Async" or item.kind == "ModBody"
            {
                // Attributes are attached to their declaration, imports were
                // resolved before checking, and the markers are not
                // declarations.
            } else if item.kind == "Struct" {
                // Struct fields were collected and resolved before checking;
                // methods and `impl` blocks are still outside this pass.
            } else {
                self.fail(
                    item,
                    "E0003",
                    "stage 1 checker does not support `" + item.kind + "` declarations yet",
                )
            }
        }
        if nested {
            self.leave_scope()
        }
        self.current_module = saved_module
    }

    fn check_function(mut self, item: Node) {
        let index = self.find_function_in(self.current_module, item.value)
        if index < 0 {
            self.fail(item, "E0101", "cannot find function `" + item.value + "`")
            return
        }
        let sig = self.functions[index]
        self.current_return = sig.ret
        self.enter_scope()
        let mut p = 0
        while p < sig.params.len {
            let name = self.param_name(item, p)
            self.bind(name, sig.params[p])
            p = p + 1
        }
        let mut body = item
        let mut found = false
        for child in item.children {
            if child.kind == "Block" {
                body = child
                found = true
            }
        }
        if !found {
            self.fail(item, "E0003", "a function needs a body")
        } else {
            self.check_block(body)
        }
        self.leave_scope()
    }

    // The parser stores parameter names on the direct `Param` children.
    fn param_name(self, item: Node, index: number): string {
        let mut seen = 0
        for child in item.children {
            if child.kind == "Param" {
                if seen == index {
                    return child.value
                }
                seen = seen + 1
            }
        }
        return "_"
    }

    fn check_const(mut self, item: Node) {
        let mut ty = ""
        let mut initializer = item
        let mut found = false
        for child in item.children {
            if child.kind == "Pub" or child.kind == "Async" {
                continue
            }
            if self.is_type_node(child) {
                ty = self.type_of(child)
            } else {
                initializer = child
                found = true
            }
        }
        if !found {
            self.fail(item, "E0003", "a constant needs an initializer")
            return
        }
        let actual = self.check_expr(initializer)
        if ty == "" {
            ty = actual
        } else if !self.assignable(ty, actual) {
            self.fail(
                initializer,
                "E0201",
                "expected `" + ty + "`, found `" + actual + "`",
            )
        }
        self.bind(item.value, ty)
    }

    fn check_let(mut self, item: Node) {
        let mut ty = ""
        let mut initializer = item
        let mut found = false
        for child in item.children {
            if child.kind == "Mut" or child.kind == "Pub" or child.kind == "Async" {
                // Mutability is tracked when the checker grows assignment rules.
            } else if self.is_type_node(child) {
                ty = self.type_of(child)
            } else {
                initializer = child
                found = true
            }
        }
        if !found {
            self.fail(item, "E0003", "a binding needs an initializer")
            return
        }
        let actual = self.check_expr(initializer)
        if ty == "" {
            ty = actual
        } else if !self.assignable(ty, actual) {
            self.fail(
                initializer,
                "E0201",
                "expected `" + ty + "`, found `" + actual + "`",
            )
        }
        self.bind(item.value, ty)
    }

    // ── statements ───────────────────────────────────────────────────────

    fn check_block(mut self, block: Node): string {
        self.enter_scope()
        let mut value = "unit"
        for stmt in block.children {
            if self.error != "" {
                break
            }
            value = self.check_statement(stmt)
        }
        self.leave_scope()
        return value
    }

    fn check_statement(mut self, stmt: Node): string {
        if stmt.kind == "Let" {
            self.check_let(stmt)
            return "unit"
        }
        if stmt.kind == "Const" {
            self.check_const(stmt)
            return "unit"
        }
        if stmt.kind == "Assign" {
            self.check_assign(stmt)
            return "unit"
        }
        if stmt.kind == "ExprStmt" {
            if stmt.children.len == 0 {
                return "unit"
            }
            return self.check_expr(stmt.children[0])
        }
        if stmt.kind == "Return" {
            self.check_return(stmt)
            return "unit"
        }
        if stmt.kind == "Jump" {
            return "unit"
        }
        if stmt.kind == "Defer" {
            if stmt.children.len > 0 {
                self.check_expr(stmt.children[0])
            }
            return "unit"
        }
        if stmt.kind == "While" {
            self.check_while(stmt)
            return "unit"
        }
        if stmt.kind == "For" {
            self.check_for(stmt)
            return "unit"
        }
        if stmt.kind == "Fn" {
            self.fail(stmt, "E0003", "nested functions are not supported yet")
            return "unit"
        }
        self.fail(
            stmt,
            "E0003",
            "stage 1 checker does not support `" + stmt.kind + "` statements yet",
        )
        return "unit"
    }

    fn check_assign(mut self, stmt: Node) {
        if stmt.children.len < 2 {
            self.fail(stmt, "E0003", "an assignment needs two operands")
            return
        }
        let lhs = self.place_type(stmt.children[0])
        let rhs = self.check_expr(stmt.children[1])
        if self.error == "" and (lhs == "unknown" or rhs == "unknown") {
            self.complete = false
            return
        }
        if self.error == "" and !self.assignable(lhs, rhs) {
            self.fail(
                stmt,
                "E0201",
                "expected `" + lhs + "`, found `" + rhs + "`",
            )
        }
    }

    fn place_type(mut self, node: Node): string {
        if node.kind == "Name" {
            let ty = self.lookup(node.value)
            if ty == "" {
                self.fail(node, "E0101", "cannot find value `" + node.value + "` in this scope")
                return "unknown"
            }
            return ty
        }
        if node.kind == "Index" {
            return self.check_index(node)
        }
        self.fail(node, "E0003", "stage 1 checker does not support this assignment target yet")
        return "unknown"
    }

    fn check_return(mut self, stmt: Node) {
        let mut actual = "unit"
        if stmt.children.len > 0 {
            actual = self.check_expr(stmt.children[0])
        }
        if self.error != "" {
            return
        }
        if !self.assignable(self.current_return, actual) {
            self.fail(
                stmt,
                "E0203",
                "expected `" + self.current_return + "`, found `" + actual + "`",
            )
        }
    }

    fn check_while(mut self, stmt: Node) {
        if stmt.children.len == 0 {
            self.fail(stmt, "E0003", "a loop needs a condition")
            return
        }
        let cond = self.check_expr(stmt.children[0])
        if self.error == "" and cond != "bool" {
            self.fail(
                stmt.children[0],
                "E0201",
                "expected `bool`, found `" + cond + "`",
            )
            return
        }
        if stmt.children.len > 1 {
            self.check_block(stmt.children[1])
        }
    }

    fn check_for(mut self, stmt: Node) {
        if stmt.children.len == 0 {
            self.fail(stmt, "E0003", "a for loop needs an iterable")
            return
        }
        let iterable = self.check_expr(stmt.children[0])
        if self.error != "" {
            return
        }
        if !self.is_list(iterable) {
            self.fail(
                stmt.children[0],
                "E0213",
                "`" + iterable + "` is not iterable",
            )
            return
        }
        self.enter_scope()
        self.bind(stmt.value, self.list_element(iterable))
        if stmt.children.len > 1 {
            self.check_block(stmt.children[1])
        }
        self.leave_scope()
    }

    // ── expressions ──────────────────────────────────────────────────────

    fn check_expr(mut self, node: Node): string {
        if self.error != "" {
            return "unknown"
        }
        if node.kind == "Literal" {
            return self.literal_type(node.value)
        }
        if node.kind == "Name" {
            let mut ty = self.lookup(node.value)
            if ty == "" {
                ty = self.value_type(self.current_module, node.value, 0)
                if ty == "unknown" {
                    // A module constant whose type is hidden (opaque module,
                    // missing annotation, or unknown import).
                    self.complete = false
                }
            }
            if ty == "" {
                self.fail(node, "E0101", "cannot find value `" + node.value + "` in this scope")
                return "unknown"
            }
            return ty
        }
        if node.kind == "Path" {
            let ty = self.path_value_type(node.value)
            if ty == "" or ty == "unknown" {
                // A std path, a function value, or a module the checker does
                // not model.
                self.complete = false
                return "unknown"
            }
            return ty
        }
        if node.kind == "Group" {
            if node.children.len == 0 {
                return "unit"
            }
            return self.check_expr(node.children[0])
        }
        if node.kind == "Binary" {
            return self.check_binary(node)
        }
        if node.kind == "Unary" {
            return self.check_unary(node)
        }
        if node.kind == "Call" {
            return self.check_call(node)
        }
        if node.kind == "Member" {
            return self.check_member(node)
        }
        if node.kind == "Index" {
            return self.check_index(node)
        }
        if node.kind == "If" {
            return self.check_if(node)
        }
        if node.kind == "Ternary" {
            return self.check_ternary(node)
        }
        if node.kind == "List" {
            return self.check_list(node)
        }
        self.fail(
            node,
            "E0003",
            "stage 1 checker does not support `" + node.kind + "` expressions yet",
        )
        return "unknown"
    }

    fn literal_type(self, text: string): string {
        if text == "true" or text == "false" {
            return "bool"
        }
        if text == "null" {
            return "null"
        }
        if text.len == 0 {
            return "unknown"
        }
        let first = text.slice(0, 1)
        if first == "\"" or first == "'" or first == "`" {
            return "string"
        }
        return "number"
    }

    fn check_unary(mut self, node: Node): string {
        if node.children.len == 0 {
            return "unit"
        }
        let ty = self.check_expr(node.children[0])
        if self.error != "" {
            return "unknown"
        }
        if ty == "unknown" {
            self.complete = false
            return "unknown"
        }
        if node.value == "!" {
            if ty != "bool" {
                self.fail(node, "E0201", "expected `bool`, found `" + ty + "`")
                return "unknown"
            }
            return "bool"
        }
        if node.value == "-" or node.value == "~" {
            if !self.is_number(ty) {
                self.fail(node, "E0201", "expected `number`, found `" + ty + "`")
                return "unknown"
            }
            return "number"
        }
        self.fail(node, "E0003", "stage 1 checker does not support `" + node.value + "` yet")
        return "unknown"
    }

    fn check_binary(mut self, node: Node): string {
        if node.children.len < 2 {
            return "unit"
        }
        let left = self.check_expr(node.children[0])
        let right = self.check_expr(node.children[1])
        if self.error != "" {
            return "unknown"
        }
        if left == "unknown" or right == "unknown" {
            self.complete = false
            return "unknown"
        }
        let op = node.value
        if op == "+" {
            if self.is_number(left) and self.is_number(right) {
                return "number"
            }
            if left == "string" and right == "string" {
                return "string"
            }
            if self.is_list(left) and left == right {
                return left
            }
            self.fail(
                node,
                "E0201",
                "operator `+` cannot combine `" + left + "` and `" + right + "`",
            )
            return "unknown"
        }
        if op == "-"
            or op == "*"
            or op == "/"
            or op == "%"
            or op == "**"
            or op == "&"
            or op == "|"
            or op == "^"
            or op == "<<"
            or op == ">>"
        {
            if self.is_number(left) and self.is_number(right) {
                return "number"
            }
            self.fail(
                node,
                "E0201",
                "operator `" + op + "` needs `number` operands, found `" + left + "` and `" + right + "`",
            )
            return "unknown"
        }
        if op == "<" or op == ">" or op == "<=" or op == ">=" {
            if self.is_number(left) and self.is_number(right) {
                return "bool"
            }
            self.fail(
                node,
                "E0201",
                "operator `" + op + "` needs `number` operands",
            )
            return "unknown"
        }
        if op == "and" or op == "or" {
            if left == "bool" and right == "bool" {
                return "bool"
            }
            self.fail(node, "E0201", "operator `" + op + "` needs `bool` operands")
            return "unknown"
        }
        if op == "==" or op == "!=" {
            if self.assignable(left, right) or self.assignable(right, left) {
                return "bool"
            }
            self.fail(
                node,
                "E0201",
                "`" + left + "` and `" + right + "` cannot be compared",
            )
            return "unknown"
        }
        if op == "??" {
            if left == "null" {
                return right
            }
            if self.is_optional(left) {
                return self.unify(node, self.optional_inner(left), right)
            }
            if left == "unknown" {
                return right
            }
            self.fail(node, "E0201", "`??` needs an optional or null left operand")
            return "unknown"
        }
        self.fail(node, "E0003", "stage 1 checker does not support `" + op + "` yet")
        return "unknown"
    }

    fn check_call(mut self, node: Node): string {
        if node.children.len == 0 {
            return "unit"
        }
        let callee = node.children[0]
        if callee.kind != "Name" and callee.kind != "Path" {
            // Method calls are outside the checker's subset.
            self.complete = false
            self.fail(callee, "E0204", "this expression is not callable")
            return "unknown"
        }
        let name = callee.value
        let mut arg_types: List<string> = []
        let mut arg_names: List<string> = []
        let mut i = 1
        while i < node.children.len {
            let mut arg = node.children[i]
            if arg.kind == "Arg" {
                arg_names.push(arg.value)
                if arg.children.len > 0 {
                    arg = arg.children[0]
                }
            } else {
                arg_names.push("")
            }
            arg_types.push(self.check_expr(arg))
            i = i + 1
        }
        if self.error != "" {
            return "unknown"
        }
        if name == "print" or name == "println" {
            return "unit"
        }
        if name == "str" {
            if arg_types.len != 1 {
                self.fail(node, "E0207", "`str` expects 1 argument")
            }
            return "string"
        }
        if name == "assert" {
            if arg_types.len != 2 {
                self.fail(node, "E0207", "`assert` expects 2 arguments")
                return "unit"
            }
            if arg_types[0] != "bool" {
                self.fail(node, "E0202", "`assert` expects a `bool` condition")
            }
            if arg_types[1] != "string" {
                self.fail(node, "E0202", "`assert` expects a `string` message")
            }
            return "unit"
        }
        if name == "panic" {
            return "unit"
        }
        let struct_index = self.resolve_struct(self.current_module, name, 0)
        if struct_index >= 0 {
            return self.check_struct_constructor(node, struct_index, arg_names, arg_types)
        }
        let index = self.resolve_function(self.current_module, name, 0)
        if index == -2 {
            // A file-backed module or an external/std path: its interface is
            // outside the checker's input, so this is not a confirmed error.
            self.complete = false
            return "unknown"
        }
        if index < 0 {
            if callee.kind == "Path" {
                self.complete = false
                return "unknown"
            }
            if self.lookup(name) != "" {
                self.fail(node, "E0204", "`" + name + "` is not callable")
            } else {
                self.complete = false
                self.fail(node, "E0101", "cannot find function `" + name + "`")
            }
            return "unknown"
        }
        let sig = self.functions[index]
        if arg_types.len != sig.params.len {
            self.fail(
                node,
                "E0207",
                "`" + name + "` expects " + str(sig.params.len) + " arguments, found " + str(arg_types.len),
            )
            return sig.ret
        }
        let mut p = 0
        while p < sig.params.len {
            if !self.assignable(sig.params[p], arg_types[p]) {
                self.fail(
                node,
                    "E0202",
                    "argument " + str(p + 1) + " to `" + name + "` expects `" + sig.params[p] + "`, found `" + arg_types[p] + "`",
                )
                return sig.ret
            }
            p = p + 1
        }
        return sig.ret
    }

    fn check_struct_constructor(mut self, node: Node, index: number,
                                labels: List<string>, types: List<string>): string {
        let sig = self.structs[index]
        let mut used: List<bool> = []
        let mut f = 0
        while f < sig.fields.len {
            used.push(false)
            f = f + 1
        }
        let mut seen_named = false
        let mut a = 0
        while a < types.len {
            let label = labels[a]
            let mut target = -1
            if label == "" {
                if seen_named {
                    self.fail(node, "E0208", "a positional argument follows a named argument")
                    return self.struct_canonical(index)
                }
                target = a
                if target >= sig.fields.len {
                    self.fail(
                        node,
                        "E0205",
                        "too many fields in initializer of `" + sig.name + "`",
                    )
                    return self.struct_canonical(index)
                }
            } else {
                seen_named = true
                target = self.struct_field_index(index, label)
                if target < 0 {
                    self.fail(
                        node,
                        "E0206",
                        "`" + sig.name + "` has no field `" + label + "`",
                    )
                    return self.struct_canonical(index)
                }
            }
            if used[target] {
                self.fail(
                    node,
                    "E0208",
                    "field `" + sig.fields[target].name + "` is initialized twice",
                )
                return self.struct_canonical(index)
            }
            used[target] = true
            if !self.assignable(sig.fields[target].ty, types[a]) {
                self.fail(
                    node,
                    "E0202",
                    "field `" + sig.fields[target].name + "` expects `"
                        + sig.fields[target].ty + "`, found `" + types[a] + "`",
                )
                return self.struct_canonical(index)
            }
            a = a + 1
        }
        f = 0
        while f < used.len {
            if !used[f] {
                self.fail(
                    node,
                    "E0205",
                    "missing field `" + sig.fields[f].name + "` in initializer of `"
                        + sig.name + "`",
                )
                return self.struct_canonical(index)
            }
            f = f + 1
        }
        return self.struct_canonical(index)
    }

    fn struct_field_index(self, index: number, name: string): number {
        if index < 0 or index >= self.structs.len {
            return -1
        }
        let mut i = 0
        while i < self.structs[index].fields.len {
            if self.structs[index].fields[i].name == name {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn check_member(mut self, node: Node): string {
        if node.children.len == 0 {
            return "unknown"
        }
        let recv = self.check_expr(node.children[0])
        if self.error != "" {
            return "unknown"
        }
        if recv == "unknown" {
            self.complete = false
            return "unknown"
        }
        if node.value == "len" or node.value == "byte_len" {
            if recv == "string" or self.is_list(recv) {
                return "number"
            }
        }
        let struct_index = self.find_struct_by_type(recv)
        if struct_index >= 0 {
            let field = self.struct_field_index(struct_index, node.value)
            if field >= 0 {
                return self.structs[struct_index].fields[field].ty
            }
            self.fail(
                node,
                "E0206",
                "`" + self.structs[struct_index].name + "` has no field `"
                    + node.value + "`",
            )
            return "unknown"
        }
        self.fail(
            node,
            "E0102",
            "no member `" + node.value + "` on `" + recv + "`",
        )
        return "unknown"
    }

    fn check_index(mut self, node: Node): string {
        if node.children.len < 2 {
            return "unknown"
        }
        let recv = self.check_expr(node.children[0])
        let index = self.check_expr(node.children[1])
        if self.error != "" {
            return "unknown"
        }
        if recv == "unknown" or index == "unknown" {
            self.complete = false
            return "unknown"
        }
        if !self.is_number(index) {
            self.fail(
                node.children[1],
                "E0201",
                "an index must be `number`, found `" + index + "`",
            )
            return "unknown"
        }
        if self.is_list(recv) {
            return self.list_element(recv)
        }
        self.fail(node, "E0215", "`" + recv + "` cannot be indexed")
        return "unknown"
    }

    fn check_if(mut self, node: Node): string {
        if node.children.len < 2 {
            return "unit"
        }
        let cond = self.check_expr(node.children[0])
        if self.error != "" {
            return "unknown"
        }
        if cond == "unknown" {
            self.complete = false
            return "unknown"
        }
        if cond != "bool" {
            self.fail(
                node.children[0],
                "E0201",
                "expected `bool`, found `" + cond + "`",
            )
            return "unknown"
        }
        let then_ty = self.check_block(node.children[1])
        if node.children.len < 3 {
            return "unit"
        }
        let else_node = node.children[2]
        let else_ty = if else_node.kind == "If" {
            self.check_expr(else_node)
        } else {
            self.check_block(else_node)
        }
        return self.unify(node, then_ty, else_ty)
    }

    fn check_ternary(mut self, node: Node): string {
        if node.children.len < 3 {
            return "unknown"
        }
        let cond = self.check_expr(node.children[0])
        if self.error != "" {
            return "unknown"
        }
        if cond != "bool" {
            self.fail(node.children[0], "E0201", "a ternary condition must be `bool`")
            return "unknown"
        }
        let then_ty = self.check_expr(node.children[1])
        let else_ty = self.check_expr(node.children[2])
        return self.unify(node, then_ty, else_ty)
    }

    fn check_list(mut self, node: Node): string {
        if node.children.len == 0 {
            return "List<unknown>"
        }
        let first = self.check_expr(node.children[0])
        let mut elem = first
        let mut i = 1
        while i < node.children.len {
            let ty = self.check_expr(node.children[i])
            elem = self.unify(node.children[i], elem, ty)
            i = i + 1
        }
        return "List<" + elem + ">"
    }
}

fn split_path(path: string): List<string> {
    let mut parts: List<string> = []
    let mut part = StringBuilder::new()
    let chars = path.split("")
    let mut i = 0
    while i < chars.len {
        let c = chars[i]
        if c == ":" and i + 1 < chars.len and chars[i + 1] == ":" {
            parts.push(part.build())
            part = StringBuilder::new()
            i = i + 2
        } else {
            part.append(c)
            i = i + 1
        }
    }
    parts.push(part.build())
    return parts
}

fn has_child_kind(node: Node, kind: string): bool {
    for child in node.children {
        if child.kind == kind {
            return true
        }
    }
    return false
}
