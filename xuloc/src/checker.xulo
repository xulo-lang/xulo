// xuloc's first semantic pass.
//
// The checker works on the generic AST and covers the front-end subset stage 1
// needs for Gate 3: functions, parameters, primitive types, `List<T>`, `T?`,
// `let`/`const`, assignment, `return`, `if`/`else`, `while`, `for`, calls,
// arithmetic/comparison/logical operators, indexing, and the `print`/`str`/
// `assert`/`panic` intrinsics.
//
// It deliberately reports "not supported yet" (E0003) for declarations it does
// not understand instead of silently accepting them. Inline modules, their
// `use` paths (aliases, groups, globs), and `pub use` re-exports are modeled;
// a file-backed module is opaque because the checker has no loader. Simple
// structs are modeled too: field types, constructors, and member reads.
// Non-generic enums are modeled with payload constructors and `match` arms
// (variant, literal, type, binder, wildcard, and guard patterns). Template
// strings check their interpolated expressions, and an untyped object literal
// gets an anonymous shape so its member reads and object destructuring are
// checked. Tuple types, literals, positional reads, writes, and destructuring
// are modeled as `(T1,T2)` strings, `type` aliases expand on demand, and an
// inherent `impl Type` exposes methods with `self`, default parameters relax a
// call's minimum arity, `Result`/`Error` are prelude types, `Map<K, V>`,
// `Set<T>`, and `Array<T, N>` carry their element types through literals,
// constructors, members, iteration, and spread, function types `fn(A)->R` and
// closures (block and arrow bodies, captured locals) are checked, union types
// `A|B` and `is` narrowing are modeled, a heterogeneous literal is
// `List<unknown>`, an external `use path::*` keeps bare names opaque,
// `await` yields its operand's task type, `spawn`/`lock`/`shared` are
// modeled, `extern "C"` declarations bind their `as` alias with `Ptr` as an
// opaque address, generic type/const parameters are `unknown` (so `T`
// signatures and bodies check as far as they can), a `trait` declaration is
// accepted with dispatch left opaque, macro definition bodies are skipped and
// a macro invocation is `unknown` (a declared macro also makes unresolved
// names opaque), names imported from an external module are opaque, a named
// function used as a value has its `fn(...)->...` type, and ranges, optional
// chaining, `try`, and null narrowing are checked. Generic instantiation and
// the remaining pattern forms arrive in later WP6 slices.
//
// Types are canonical strings (`number`, `string`, `bool`, `unit`, `unknown`,
// `null`, `List<T>`, `T?`) so comparisons never depend on structural equality.
// Scopes are a flat binding list plus a scope-id stack; leaving a block only
// decrements the active scope count, so the checker avoids list `pop`/
// `truncate`, which the AOT runtime does not lower yet.

use ast::{Node};

pub struct CheckResult {
    pub ok: bool,
    /// Whether the checker saw the whole program with constructs it models.
    /// `false` means it reached a declaration, type, or call it cannot judge
    /// (E0003, an unknown type name, a std/module function, a method call), so
    /// a failure is "not checked", not a confirmed error.
    pub complete: bool,
    pub code: string,
    pub message: string,
    pub line: number,
    pub column: number,
}

pub struct Binding {
    name: string,
    ty: string,
    scope: number,
}

pub struct FuncSig {
    name: string,
    module_id: string,
    is_pub: bool,
    min_params: number,
    params: List<string>,
    /// `unknown` when the declaration omits the return type: the checker does
    /// not infer it, so a call must not claim a narrower type.
    ret: string,
    /// The declaration, kept so parameter and return types are resolved after
    /// every module and struct name is known.
    decl: Node,
}

pub struct MethodSig {
    owner: string,
    name: string,
    module_id: string,
    param_names: List<string>,
    min_params: number,
    params: List<string>,
    ret: string,
    decl: Node,
}

pub struct ConstSig {
    name: string,
    ty: string,
    is_pub: bool,
}

pub struct FieldSig {
    name: string,
    ty: string,
}

pub struct StructSig {
    name: string,
    module_id: string,
    is_pub: bool,
    /// Field type annotations, resolved after every struct name is known.
    field_nodes: List<Node>,
    fields: List<FieldSig>,
}

pub struct VariantSig {
    name: string,
    field_nodes: List<Node>,
    fields: List<FieldSig>,
}

pub struct EnumSig {
    name: string,
    module_id: string,
    is_pub: bool,
    is_generic: bool,
    variant_nodes: List<Node>,
    variants: List<VariantSig>,
}

/// The shape of an untyped object literal (`{ name: "a", age: 1 }`). Type
/// strings name it as `@objN`, so member reads can recover the fields.
pub struct AnonSig {
    id: number,
    fields: List<FieldSig>,
}

/// A `type Name = Target` alias. The target is expanded on demand, so aliases
/// may name aliases declared later.
pub struct AliasSig {
    name: string,
    module_id: string,
    is_pub: bool,
    is_generic: bool,
    type_node: Node,
    target: string,
}

pub struct ImportSig {
    alias: string,
    target: string,
    member: string,
    is_pub: bool,
}

pub struct GlobSig {
    target: string,
    is_pub: bool,
}

/// One module's namespace: its declarations and the `use` statements that
/// name other modules. A file-backed module is `opaque`: the checker has no
/// loader, so a call into it is "not modeled" rather than an error.
pub struct ModuleSig {
    id: string,
    parent: string,
    opaque: bool,
    consts: List<ConstSig>,
    imports: List<ImportSig>,
    globs: List<GlobSig>,
    uses: List<Node>,
    /// Type names imported from an opaque module or `std`: the checker cannot
    /// inspect their shape, so uses are "unknown", not errors.
    foreign_types: List<string>,
}

pub struct Checker {
    functions: List<FuncSig>,
    methods: List<MethodSig>,
    structs: List<StructSig>,
    enums: List<EnumSig>,
    aliases: List<AliasSig>,
    alias_depth: number,
    anon_objects: List<AnonSig>,
    next_anon: number,
    modules: List<ModuleSig>,
    current_module: string,
    bindings: List<Binding>,
    scopes: List<number>,
    active_scopes: number,
    next_scope: number,
    current_return: string,
    /// Type and const parameter names (`T`, `N`) declared by any generic
    /// item in the program. They are not concrete types, so `type_of` maps
    /// them to `unknown` instead of reporting E0101.
    generic_names: List<string>,
    /// Whether the program declares a macro. A macro can generate items the
    /// checker cannot see, so an unresolved name is "not modeled" rather than
    /// a confirmed error.
    has_macros: bool,
    /// Bare names bound by a `use` whose target is outside this buffer
    /// (`use std::http::{Request, Response}`). They may be types, functions,
    /// or constants, so every lookup treats them as opaque.
    external_imports: List<string>,
    complete: bool,
    error: string,
    code: string,
    line: number,
    column: number,
}

pub fn check(root: Node): CheckResult {
    let mut checker = Checker(
        functions: [],
        methods: [],
        structs: [],
        enums: [],
        aliases: [],
        alias_depth: 0,
        anon_objects: [],
        next_anon: 0,
        modules: [],
        current_module: "",
        bindings: [],
        scopes: [],
        active_scopes: 0,
        next_scope: 1,
        current_return: "unit",
        generic_names: [],
        has_macros: false,
        external_imports: [],
        complete: true,
        error: "",
        code: "",
        line: 1,
        column: 1,
    )
    checker.enter_scope()
    checker.add_module("", "#", false)
    checker.collect_structs(root, "")
    checker.add_builtin_types()
    checker.collect_functions(root, "")
    checker.resolve_uses()
    checker.resolve_structs()
    checker.resolve_enums()
    checker.resolve_function_signatures()
    checker.resolve_method_signatures()
    if checker.error == "" {
        checker.check_program(root)
    }
    return CheckResult(
        ok: checker.error == "",
        complete: checker.complete,
        code: checker.code,
        message: checker.error,
        line: checker.line,
        column: checker.column,
    )
}

impl Checker {
    // ── diagnostics and scopes ───────────────────────────────────────────

    fn fail(mut self, node: Node, code: string, message: string) {
        if self.error == "" {
            self.error = message
            self.code = code
            self.line = node.line
            self.column = node.column
        }
        if code == "E0003" {
            self.complete = false
        }
    }

    fn enter_scope(mut self) {
        self.scopes.push(self.next_scope)
        self.next_scope = self.next_scope + 1
        self.active_scopes = self.active_scopes + 1
    }

    fn leave_scope(mut self) {
        if self.active_scopes > 0 {
            self.active_scopes = self.active_scopes - 1
        }
    }

    fn scope_active(self, scope: number): bool {
        let mut i = 0
        while i < self.active_scopes {
            if self.scopes[i] == scope {
                return true
            }
            i = i + 1
        }
        return false
    }

    fn bind(mut self, name: string, ty: string) {
        if name == "" or name == "_" {
            return
        }
        let scope = self.scopes[self.active_scopes - 1]
        self.bindings.push(Binding(name: name, ty: ty, scope: scope))
    }

    fn lookup(self, name: string): string {
        let mut i = self.bindings.len
        while i > 0 {
            i = i - 1
            let binding = self.bindings[i]
            if binding.name == name and self.scope_active(binding.scope) {
                return binding.ty
            }
        }
        return ""
    }

    fn module_index(self, module_id: string): number {
        let mut i = 0
        while i < self.modules.len {
            if self.modules[i].id == module_id {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn add_module(mut self, module_id: string, parent: string, opaque: bool) {
        if self.module_index(module_id) >= 0 {
            return
        }
        self.modules.push(
            ModuleSig(
                id: module_id,
                parent: parent,
                opaque: opaque,
                consts: [],
                imports: [],
                globs: [],
                uses: [],
                foreign_types: [],
            ),
        )
    }

    fn child_module(self, parent: string, name: string): string {
        let id = if parent == "" { name } else { parent + "::" + name }
        if self.module_index(id) >= 0 {
            return id
        }
        return "#"
    }

    fn module_parent(self, module_id: string): string {
        let index = self.module_index(module_id)
        if index < 0 {
            return "#"
        }
        return self.modules[index].parent
    }

    fn import_module(self, module_id: string, name: string): string {
        let index = self.module_index(module_id)
        if index < 0 {
            return "#"
        }
        let mut i = self.modules[index].imports.len - 1
        while i >= 0 {
            let import = self.modules[index].imports[i]
            if import.alias == name and import.member == "" {
                return import.target
            }
            i = i - 1
        }
        return "#"
    }

    /// Walk a module path from `from`; `"#"` means the path leaves the
    /// package (or names a module that is not in this file).
    fn resolve_module(self, from: string, head: string, segments: List<string>): string {
        let mut current = ""
        if head == "self" {
            current = from
        } else if head == "super" {
            current = self.module_parent(from)
            if current == "#" {
                return "#"
            }
        } else {
            current = self.child_module(from, head)
            if current == "#" {
                current = self.import_module(from, head)
            }
            if current == "#" {
                current = self.child_module("", head)
            }
            if current == "#" {
                return "#"
            }
        }
        let mut i = 0
        while i < segments.len {
            let segment = segments[i]
            if segment == "self" {
                i = i + 1
                continue
            }
            if segment == "super" {
                let parent = self.module_parent(current)
                if parent == "#" {
                    return "#"
                }
                current = parent
                i = i + 1
                continue
            }
            let child = self.child_module(current, segment)
            if child != "#" {
                current = child
            } else {
                let aliased = self.import_module(current, segment)
                if aliased == "#" {
                    return "#"
                }
                current = aliased
            }
            i = i + 1
        }
        return current
    }

    fn find_function_in(self, module_id: string, name: string): number {
        let mut i = self.functions.len
        while i > 0 {
            i = i - 1
            let sig = self.functions[i]
            if sig.module_id == module_id and sig.name == name {
                return i
            }
        }
        return -1
    }

    fn find_method(self, owner: string, name: string): number {
        let mut i = self.methods.len
        while i > 0 {
            i = i - 1
            if self.methods[i].owner == owner and self.methods[i].name == name {
                return i
            }
        }
        return -1
    }

    fn find_method_in(self, module_id: string, name: string): number {
        let mut i = self.methods.len
        while i > 0 {
            i = i - 1
            if self.methods[i].module_id == module_id and self.methods[i].name == name {
                return i
            }
        }
        return -1
    }

    fn find_const_in(self, module_id: string, name: string): number {
        let index = self.module_index(module_id)
        if index < 0 {
            return -1
        }
        let mut i = 0
        while i < self.modules[index].consts.len {
            if self.modules[index].consts[i].name == name {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn find_struct_in(self, module_id: string, name: string): number {
        let mut i = self.structs.len
        while i > 0 {
            i = i - 1
            if self.structs[i].module_id == module_id and self.structs[i].name == name {
                return i
            }
        }
        return -1
    }

    fn struct_canonical(self, index: number): string {
        if index < 0 or index >= self.structs.len {
            return "unknown"
        }
        let sig = self.structs[index]
        if sig.module_id == "" {
            return sig.name
        }
        return sig.module_id + "::" + sig.name
    }

    fn find_struct_by_type(self, ty: string): number {
        let mut i = 0
        while i < self.structs.len {
            if self.struct_canonical(i) == ty {
                return i
            }
            i = i + 1
        }
        return -1
    }

    /// Local view: this module's struct, then `use` imports and globs.
    fn resolve_struct(self, module_id: string, name: string, depth: number): number {
        if depth > 32 {
            return -1
        }
        let own = self.find_struct_in(module_id, name)
        if own >= 0 {
            return own
        }
        let scope = self.module_index(module_id)
        if scope < 0 {
            return -1
        }
        let mut i = self.modules[scope].imports.len - 1
        while i >= 0 {
            let import = self.modules[scope].imports[i]
            if import.alias == name and import.member != "" {
                let found = self.export_struct(import.target, import.member, depth + 1)
                if found != -1 {
                    return found
                }
            }
            i = i - 1
        }
        i = self.modules[scope].globs.len - 1
        while i >= 0 {
            let found = self.export_struct(self.modules[scope].globs[i].target, name, depth + 1)
            if found != -1 {
                return found
            }
            i = i - 1
        }
        if module_id != "" {
            return self.find_struct_in("", name)
        }
        return -1
    }

    fn export_struct(self, module_id: string, name: string, depth: number): number {
        if depth > 32 {
            return -1
        }
        let index = self.module_index(module_id)
        if index < 0 or self.modules[index].opaque {
            return -1
        }
        let own = self.find_struct_in(module_id, name)
        if own >= 0 {
            if self.structs[own].is_pub {
                return own
            }
            return -1
        }
        let mut i = self.modules[index].imports.len - 1
        while i >= 0 {
            let import = self.modules[index].imports[i]
            if import.alias == name and import.is_pub and import.member != "" {
                let found = self.export_struct(import.target, import.member, depth + 1)
                if found != -1 {
                    return found
                }
            }
            i = i - 1
        }
        i = self.modules[index].globs.len - 1
        while i >= 0 {
            if self.modules[index].globs[i].is_pub {
                let found = self.export_struct(self.modules[index].globs[i].target, name, depth + 1)
                if found != -1 {
                    return found
                }
            }
            i = i - 1
        }
        return -1
    }

    fn find_enum_in(self, module_id: string, name: string): number {
        let mut i = self.enums.len
        while i > 0 {
            i = i - 1
            if self.enums[i].module_id == module_id and self.enums[i].name == name {
                return i
            }
        }
        return -1
    }

    fn enum_canonical(self, index: number): string {
        if index < 0 or index >= self.enums.len {
            return "unknown"
        }
        let sig = self.enums[index]
        if sig.module_id == "" {
            return sig.name
        }
        return sig.module_id + "::" + sig.name
    }

    fn find_enum_by_type(self, ty: string): number {
        let mut i = 0
        while i < self.enums.len {
            if self.enum_canonical(i) == ty {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn resolve_enum(self, module_id: string, name: string, depth: number): number {
        if depth > 32 {
            return -1
        }
        let own = self.find_enum_in(module_id, name)
        if own >= 0 {
            return own
        }
        let scope = self.module_index(module_id)
        if scope < 0 {
            return -1
        }
        let mut i = self.modules[scope].imports.len - 1
        while i >= 0 {
            let import = self.modules[scope].imports[i]
            if import.alias == name and import.member != "" {
                let found = self.export_enum(import.target, import.member, depth + 1)
                if found != -1 {
                    return found
                }
            }
            i = i - 1
        }
        i = self.modules[scope].globs.len - 1
        while i >= 0 {
            let found = self.export_enum(self.modules[scope].globs[i].target, name, depth + 1)
            if found != -1 {
                return found
            }
            i = i - 1
        }
        if module_id != "" {
            return self.find_enum_in("", name)
        }
        return -1
    }

    fn export_enum(self, module_id: string, name: string, depth: number): number {
        if depth > 32 {
            return -1
        }
        let index = self.module_index(module_id)
        if index < 0 or self.modules[index].opaque {
            return -1
        }
        let own = self.find_enum_in(module_id, name)
        if own >= 0 {
            if self.enums[own].is_pub {
                return own
            }
            return -1
        }
        let mut i = self.modules[index].imports.len - 1
        while i >= 0 {
            let import = self.modules[index].imports[i]
            if import.alias == name and import.is_pub and import.member != "" {
                let found = self.export_enum(import.target, import.member, depth + 1)
                if found != -1 {
                    return found
                }
            }
            i = i - 1
        }
        i = self.modules[index].globs.len - 1
        while i >= 0 {
            if self.modules[index].globs[i].is_pub {
                let found = self.export_enum(self.modules[index].globs[i].target, name, depth + 1)
                if found != -1 {
                    return found
                }
            }
            i = i - 1
        }
        return -1
    }

    fn find_alias_in(self, module_id: string, name: string): number {
        let mut i = self.aliases.len
        while i > 0 {
            i = i - 1
            if self.aliases[i].module_id == module_id and self.aliases[i].name == name {
                return i
            }
        }
        return -1
    }

    fn resolve_alias(self, module_id: string, name: string, depth: number): number {
        if depth > 32 {
            return -1
        }
        let own = self.find_alias_in(module_id, name)
        if own >= 0 {
            return own
        }
        let scope = self.module_index(module_id)
        if scope < 0 {
            return -1
        }
        let mut i = self.modules[scope].imports.len - 1
        while i >= 0 {
            let import = self.modules[scope].imports[i]
            if import.alias == name and import.member != "" {
                let found = self.export_alias(import.target, import.member, depth + 1)
                if found != -1 {
                    return found
                }
            }
            i = i - 1
        }
        i = self.modules[scope].globs.len - 1
        while i >= 0 {
            let found = self.export_alias(self.modules[scope].globs[i].target, name, depth + 1)
            if found != -1 {
                return found
            }
            i = i - 1
        }
        return -1
    }

    fn export_alias(self, module_id: string, name: string, depth: number): number {
        if depth > 32 {
            return -1
        }
        let index = self.module_index(module_id)
        if index < 0 or self.modules[index].opaque {
            return -1
        }
        let own = self.find_alias_in(module_id, name)
        if own >= 0 {
            if self.aliases[own].is_pub {
                return own
            }
            return -1
        }
        let mut i = self.modules[index].imports.len - 1
        while i >= 0 {
            let import = self.modules[index].imports[i]
            if import.alias == name and import.is_pub and import.member != "" {
                let found = self.export_alias(import.target, import.member, depth + 1)
                if found != -1 {
                    return found
                }
            }
            i = i - 1
        }
        i = self.modules[index].globs.len - 1
        while i >= 0 {
            if self.modules[index].globs[i].is_pub {
                let found = self.export_alias(self.modules[index].globs[i].target, name, depth + 1)
                if found != -1 {
                    return found
                }
            }
            i = i - 1
        }
        return -1
    }

    /// Expand an alias to its target type, caching the result. `alias_depth`
    /// breaks `type A = B` / `type B = A` cycles.
    fn expand_alias(mut self, index: number, depth: number): string {
        if index < 0 or index >= self.aliases.len {
            return "unknown"
        }
        if self.aliases[index].target != "" {
            return self.aliases[index].target
        }
        if self.aliases[index].is_generic or depth > 32 or self.alias_depth > 32 {
            self.complete = false
            return "unknown"
        }
        self.alias_depth = self.alias_depth + 1
        let saved_module = self.current_module
        self.current_module = self.aliases[index].module_id
        let type_node = self.aliases[index].type_node
        let target = self.type_of(type_node)
        self.current_module = saved_module
        self.alias_depth = self.alias_depth - 1
        if self.error != "" {
            return "unknown"
        }
        self.aliases[index].target = target
        return target
    }

    fn variant_index(self, enum_index: number, name: string): number {
        if enum_index < 0 or enum_index >= self.enums.len {
            return -1
        }
        let mut i = 0
        while i < self.enums[enum_index].variants.len {
            if self.enums[enum_index].variants[i].name == name {
                return i
            }
            i = i + 1
        }
        return -1
    }

    /// `Enum::Variant` in the current module: returns the enum index, or -1.
    fn resolve_variant_path(self, path: string): number {
        let parts = split_path(path)
        if parts.len != 2 {
            return -1
        }
        return self.resolve_enum(self.current_module, parts[0], 0)
    }

    /// Resolve a name used as a value in `module_id`: a module constant, or a
    /// constant reached through `use`. Returns `""` when it is not a value.
    fn value_type(self, module_id: string, name: string, depth: number): string {
        if depth > 32 {
            return ""
        }
        let index = self.find_const_in(module_id, name)
        if index >= 0 {
            let ty = self.modules[self.module_index(module_id)].consts[index].ty
            if ty != "" {
                return ty
            }
            return "unknown"
        }
        let scope = self.module_index(module_id)
        if scope < 0 {
            return ""
        }
        let mut i = self.modules[scope].imports.len - 1
        while i >= 0 {
            let import = self.modules[scope].imports[i]
            if import.alias == name and import.member != "" {
                let ty = self.export_value_type(import.target, import.member, depth + 1)
                if ty != "" {
                    return ty
                }
            }
            i = i - 1
        }
        i = self.modules[scope].globs.len - 1
        while i >= 0 {
            let ty = self.export_value_type(self.modules[scope].globs[i].target, name, depth + 1)
            if ty != "" {
                return ty
            }
            i = i - 1
        }
        return ""
    }

    fn path_value_type(self, path: string): string {
        let parts = split_path(path)
        if parts.len < 2 {
            return ""
        }
        let mut segments: List<string> = []
        let mut i = 1
        while i + 1 < parts.len {
            segments.push(parts[i])
            i = i + 1
        }
        let target = self.resolve_module(self.current_module, parts[0], segments)
        if target == "#" {
            return ""
        }
        return self.export_value_type(target, parts[parts.len - 1], 0)
    }

    fn export_value_type(self, module_id: string, name: string, depth: number): string {
        if depth > 32 {
            return ""
        }
        let index = self.module_index(module_id)
        if index < 0 {
            return ""
        }
        if self.modules[index].opaque {
            return "unknown"
        }
        let c = self.find_const_in(module_id, name)
        if c >= 0 and self.modules[index].consts[c].is_pub {
            let ty = self.modules[index].consts[c].ty
            if ty != "" {
                return ty
            }
            return "unknown"
        }
        let mut i = self.modules[index].imports.len - 1
        while i >= 0 {
            let import = self.modules[index].imports[i]
            if import.alias == name and import.is_pub and import.member != "" {
                let ty = self.export_value_type(import.target, import.member, depth + 1)
                if ty != "" {
                    return ty
                }
            }
            i = i - 1
        }
        i = self.modules[index].globs.len - 1
        while i >= 0 {
            if self.modules[index].globs[i].is_pub {
                let ty = self.export_value_type(self.modules[index].globs[i].target, name, depth + 1)
                if ty != "" {
                    return ty
                }
            }
            i = i - 1
        }
        return ""
    }

    /// Function index (`>= 0`), `-1` for a name this package does not define,
    /// or `-2` when the answer is hidden behind an opaque/file-backed module.
    fn resolve_function(self, from: string, path: string, depth: number): number {
        if depth > 32 {
            return -1
        }
        let parts = split_path(path)
        if parts.len == 1 {
            let own = self.find_function_in(from, parts[0])
            if own >= 0 {
                return own
            }
            let scope = self.module_index(from)
            if scope < 0 {
                return -1
            }
            let mut i = self.modules[scope].imports.len - 1
            while i >= 0 {
                let import = self.modules[scope].imports[i]
                if import.alias == parts[0] and import.member != "" {
                    let found = self.export_function(import.target, import.member, depth + 1)
                    if found != -1 {
                        return found
                    }
                }
                i = i - 1
            }
            i = self.modules[scope].globs.len - 1
            let mut external = false
            while i >= 0 {
                let target = self.modules[scope].globs[i].target
                if target == "#" {
                    external = true
                } else {
                    let found = self.export_function(target, parts[0], depth + 1)
                    if found != -1 {
                        return found
                    }
                }
                i = i - 1
            }
            if external {
                return -2
            }
            if self.is_external_import(parts[0]) {
                return -2
            }
            return -1
        }
        let head = parts[0]
        let mut segments: List<string> = []
        let mut i = 1
        while i + 1 < parts.len {
            segments.push(parts[i])
            i = i + 1
        }
        let target = self.resolve_module(from, head, segments)
        if target == "#" {
            return -2
        }
        return self.export_function(target, parts[parts.len - 1], depth + 1)
    }

    fn export_function(self, module_id: string, name: string, depth: number): number {
        if depth > 32 {
            return -1
        }
        let index = self.module_index(module_id)
        if index < 0 {
            return -1
        }
        if self.modules[index].opaque {
            return -2
        }
        let own = self.find_function_in(module_id, name)
        if own >= 0 {
            if self.functions[own].is_pub {
                return own
            }
            return -1
        }
        let mut i = self.modules[index].imports.len - 1
        while i >= 0 {
            let import = self.modules[index].imports[i]
            if import.alias == name and import.is_pub and import.member != "" {
                let found = self.export_function(import.target, import.member, depth + 1)
                if found != -1 {
                    return found
                }
            }
            i = i - 1
        }
        i = self.modules[index].globs.len - 1
        while i >= 0 {
            if self.modules[index].globs[i].is_pub {
                let found = self.export_function(self.modules[index].globs[i].target, name, depth + 1)
                if found != -1 {
                    return found
                }
            }
            i = i - 1
        }
        return -1
    }

    // ── types ────────────────────────────────────────────────────────────

    fn is_type_node(self, node: Node): bool {
        return node.kind == "TypeName"
            or node.kind == "OptionalType"
            or node.kind == "TupleType"
            or node.kind == "FnType"
            or node.kind == "|"
            or node.kind == "&"
    }

    fn note_external_import(mut self, name: string) {
        if name == "" {
            return
        }
        let mut i = 0
        while i < self.external_imports.len {
            if self.external_imports[i] == name {
                return
            }
            i = i + 1
        }
        self.external_imports.push(name)
    }

    fn is_external_import(self, name: string): bool {
        let mut i = 0
        while i < self.external_imports.len {
            if self.external_imports[i] == name {
                return true
            }
            i = i + 1
        }
        return false
    }

    fn is_generic_name(self, name: string): bool {
        let mut i = 0
        while i < self.generic_names.len {
            if self.generic_names[i] == name {
                return true
            }
            i = i + 1
        }
        return false
    }

    fn note_generic_params(mut self, item: Node) {
        for child in item.children {
            if child.kind == "GenericParams" {
                for param in child.children {
                    if param.kind == "GenericParam" or param.kind == "ConstGenericParam" {
                        self.generic_names.push(param.value)
                    }
                }
            }
        }
    }

    /// `#[macro]`, `#[macro_attr]`, and `#[macro_derive(Target)]` mark a
    /// module-level function as a compile-time macro definition.
    fn is_macro_decl(self, item: Node): bool {
        for child in item.children {
            if child.kind == "Attribute" {
                if child.value == "macro" or child.value == "macro_attr"
                    or child.value == "macro_derive"
                {
                    return true
                }
            }
        }
        return false
    }

    /// Bind a `const N: int` parameter so the body can use `N` as a value.
    fn bind_const_params(mut self, item: Node) {
        for child in item.children {
            if child.kind == "GenericParams" {
                for param in child.children {
                    if param.kind == "ConstGenericParam" {
                        self.bind(param.value, "number")
                    }
                }
            }
        }
    }

    /// Collect the type arguments written on a `TypeName` or `TypeApply`.
    fn type_arguments(mut self, node: Node): List<string> {
        let mut out: List<string> = []
        let mut i = 0
        while i < node.children.len {
            let child = node.children[i]
            if child.kind == "TypeArgs" {
                for arg in child.children {
                    out.push(self.type_of(arg))
                }
            }
            i = i + 1
        }
        return out
    }

    fn type_of(mut self, node: Node): string {
        if self.error != "" {
            return "unknown"
        }
        if node.kind == "LiteralType" {
            // `Array<int, 3>`: the length is a value, not a type, but the
            // checker only needs the element type.
            return self.literal_type(node.value)
        }
        if node.kind == "|" {
            let mut out = ""
            for child in node.children {
                let member = self.type_of(child)
                if self.error != "" {
                    return "unknown"
                }
                if member == "unknown" {
                    self.complete = false
                }
                if out == "" {
                    out = member
                } else if !self.union_has_member(out, member) {
                    out = out + "|" + member
                }
            }
            if out == "" {
                return "unknown"
            }
            return out
        }
        if node.kind == "&" {
            // Intersection values are outside the bootstrap subset; a
            // declaration alone is accepted and does not constrain anything.
            self.complete = false
            return "unknown"
        }
        if node.kind == "OptionalType" {
            if node.children.len == 0 {
                self.complete = false
                self.fail(node, "E0101", "an optional type needs an inner type")
                return "unknown"
            }
            return self.type_of(node.children[0]) + "?"
        }
        if node.kind == "TupleType" {
            let mut text = "("
            let mut i = 0
            while i < node.children.len {
                if i > 0 {
                    text = text + ","
                }
                text = text + self.type_of(node.children[i])
                i = i + 1
            }
            return text + ")"
        }
        if node.kind == "FnType" {
            if node.children.len == 0 {
                return self.make_fn_type([], "unknown")
            }
            let ret = self.type_of(node.children[node.children.len - 1])
            let mut params: List<string> = []
            let mut i = 0
            while i < node.children.len - 1 {
                params.push(self.type_of(node.children[i]))
                i = i + 1
            }
            return self.make_fn_type(params, ret)
        }
        if node.kind != "TypeName" {
            self.fail(node, "E0003", "stage 1 checker does not support this type yet")
            return "unknown"
        }
        let name = node.value
        if name == "int"
            or name == "i8"
            or name == "i16"
            or name == "i32"
            or name == "i64"
            or name == "u8"
            or name == "u16"
            or name == "u32"
            or name == "u64"
            or name == "usize"
            or name == "isize"
            or name == "float"
            or name == "f32"
            or name == "f64"
            or name == "number"
        {
            return "number"
        }
        if name == "bool" {
            return "bool"
        }
        if name == "string" {
            return "string"
        }
        if name == "unit" {
            return "unit"
        }
        if name == "unknown" {
            return "unknown"
        }
        if self.is_generic_name(name) {
            // A type parameter has no concrete definition; its operations are
            // checked as far as `unknown` allows.
            return "unknown"
        }
        if name == "Ptr" {
            // An opaque FFI address. Equality and optional narrowing are the
            // only operations the checker models.
            return "Ptr"
        }
        if name == "Map" or name == "Set" {
            let args = self.type_arguments(node)
            if name == "Map" {
                if args.len < 2 {
                    self.complete = false
                    self.fail(node, "E0101", "`Map` needs key and value type arguments")
                    return "unknown"
                }
                return "Map<" + args[0] + "," + args[1] + ">"
            }
            if args.len < 1 {
                self.complete = false
                self.fail(node, "E0101", "`Set` needs an element type argument")
                return "unknown"
            }
            return "Set<" + args[0] + ">"
        }
        if name == "List" or name == "Array" {
            let mut i = 0
            while i < node.children.len {
                let child = node.children[i]
                if child.kind == "TypeArgs" and child.children.len > 0 {
                    let elem = self.type_of(child.children[0])
                    return "List<" + elem + ">"
                }
                i = i + 1
            }
            self.complete = false
            self.fail(node, "E0101", "`" + name + "` needs a type argument")
            return "unknown"
        }
        let struct_index = self.resolve_struct(self.current_module, name, 0)
        if struct_index >= 0 {
            return self.struct_canonical(struct_index)
        }
        let enum_index = self.resolve_enum(self.current_module, name, 0)
        if enum_index >= 0 {
            if self.enums[enum_index].is_generic {
                // A generic enum's payloads mention type parameters this pass
                // does not instantiate.
                self.complete = false
                return "unknown"
            }
            return self.enum_canonical(enum_index)
        }
        let alias_index = self.resolve_alias(self.current_module, name, 0)
        if alias_index >= 0 {
            return self.expand_alias(alias_index, 0)
        }
        if self.is_foreign_type(self.current_module, name) {
            // `use type opaque::Meters`: the name is a type by declaration,
            // but its definition is outside this checker's input.
            self.complete = false
            return "unknown"
        }
        if self.has_external_glob(self.current_module) {
            // `use std::fmt::*`: a bare name may be declared by a module the
            // checker cannot read.
            self.complete = false
            return "unknown"
        }
        if self.is_external_import(name) {
            // `use std::http::{Request, Response}`: the name is a type from an
            // external module.
            self.complete = false
            return "unknown"
        }
        if self.has_macros {
            // A macro may generate this type declaration.
            self.complete = false
            return "unknown"
        }
        // Enum, alias, generic parameter, and opaque imported types are not
        // modeled here; the name is unknown to the checker, not necessarily
        // wrong, so `build` must not reject on this alone.
        self.complete = false
        self.fail(node, "E0101", "unknown type `" + name + "`")
        return "unknown"
    }

    fn is_number(self, ty: string): bool {
        return ty == "number"
    }

    fn is_optional(self, ty: string): bool {
        if ty.len == 0 {
            return false
        }
        return ty.slice(ty.len - 1, ty.len) == "?"
    }

    fn optional_inner(self, ty: string): string {
        if !self.is_optional(ty) {
            return ty
        }
        return ty.slice(0, ty.len - 1)
    }

    fn is_range(self, ty: string): bool {
        return ty == "Range"
    }

    fn is_list(self, ty: string): bool {
        if ty.len < 6 {
            return false
        }
        return ty.slice(0, 5) == "List<"
    }

    fn list_element(self, ty: string): string {
        if !self.is_list(ty) {
            return "unknown"
        }
        return ty.slice(5, ty.len - 1)
    }

    fn is_generic(self, ty: string, head: string): bool {
        if ty.len < head.len + 2 {
            return false
        }
        return ty.slice(0, head.len + 1) == head + "<"
            and ty.slice(ty.len - 1, ty.len) == ">"
    }

    /// Split the top-level arguments of `Head<A,B>`; nesting is respected.
    fn generic_args(self, ty: string, head: string): List<string> {
        let mut out: List<string> = []
        if !self.is_generic(ty, head) {
            return out
        }
        let inner = ty.slice(head.len + 1, ty.len - 1)
        let chars = inner.split("")
        let mut part = StringBuilder::new()
        let mut depth = 0
        let mut i = 0
        while i < chars.len {
            let c = chars[i]
            if c == "," and depth == 0 {
                out.push(part.build())
                part = StringBuilder::new()
            } else {
                if c == "<" or c == "(" {
                    depth = depth + 1
                } else if c == ">" or c == ")" {
                    depth = depth - 1
                }
                part.append(c)
            }
            i = i + 1
        }
        out.push(part.build())
        return out
    }

    fn is_map(self, ty: string): bool {
        return self.is_generic(ty, "Map")
    }

    fn map_key(self, ty: string): string {
        let args = self.generic_args(ty, "Map")
        if args.len < 2 {
            return "unknown"
        }
        return args[0]
    }

    fn map_value(self, ty: string): string {
        let args = self.generic_args(ty, "Map")
        if args.len < 2 {
            return "unknown"
        }
        return args[1]
    }

    fn is_set(self, ty: string): bool {
        return self.is_generic(ty, "Set")
    }

    fn set_element(self, ty: string): string {
        let args = self.generic_args(ty, "Set")
        if args.len < 1 {
            return "unknown"
        }
        return args[0]
    }

    fn is_union(self, ty: string): bool {
        let chars = ty.split("")
        let mut depth = 0
        let mut i = 0
        while i < chars.len {
            let c = chars[i]
            if c == "<" or c == "(" {
                depth = depth + 1
            } else if c == ">" or c == ")" {
                depth = depth - 1
            } else if c == "|" and depth == 0 {
                return true
            }
            i = i + 1
        }
        return false
    }

    fn union_members(self, ty: string): List<string> {
        let mut out: List<string> = []
        let chars = ty.split("")
        let mut part = StringBuilder::new()
        let mut depth = 0
        let mut i = 0
        while i < chars.len {
            let c = chars[i]
            if c == "|" and depth == 0 {
                out.push(part.build())
                part = StringBuilder::new()
            } else {
                if c == "<" or c == "(" {
                    depth = depth + 1
                } else if c == ">" or c == ")" {
                    depth = depth - 1
                }
                part.append(c)
            }
            i = i + 1
        }
        out.push(part.build())
        return out
    }

    fn union_has_member(self, ty: string, member: string): bool {
        for known in self.union_members(ty) {
            if known == member {
                return true
            }
        }
        return false
    }

    fn without_union_member(self, ty: string, member: string): string {
        if !self.is_union(ty) {
            return ty
        }
        let mut out = ""
        for known in self.union_members(ty) {
            if known != member {
                if out == "" {
                    out = known
                } else {
                    out = out + "|" + known
                }
            }
        }
        if out == "" {
            return "unknown"
        }
        return out
    }

    fn is_fn_type(self, ty: string): bool {
        if ty.len < 4 {
            return false
        }
        return ty.slice(0, 3) == "fn("
    }

    fn make_fn_type(self, params: List<string>, ret: string): string {
        let mut out = "fn("
        let mut i = 0
        while i < params.len {
            if i > 0 {
                out = out + ","
            }
            out = out + params[i]
            i = i + 1
        }
        return out + ")->" + ret
    }

    /// The index of the `)` closing the outer `fn(`, or `-1`.
    fn fn_close(self, ty: string): number {
        let chars = ty.split("")
        let mut depth = 0
        let mut i = 3
        while i < chars.len {
            let c = chars[i]
            if c == ")" and depth == 0 {
                return i
            }
            if c == "(" or c == "<" {
                depth = depth + 1
            } else if c == ")" or c == ">" {
                depth = depth - 1
            }
            i = i + 1
        }
        return -1
    }

    fn fn_params(self, ty: string): List<string> {
        let mut out: List<string> = []
        if !self.is_fn_type(ty) {
            return out
        }
        let close = self.fn_close(ty)
        if close < 0 {
            return out
        }
        let inner = ty.slice(3, close)
        if inner == "" {
            return out
        }
        let chars = inner.split("")
        let mut part = StringBuilder::new()
        let mut depth = 0
        let mut i = 0
        while i < chars.len {
            let c = chars[i]
            if c == "," and depth == 0 {
                out.push(part.build())
                part = StringBuilder::new()
            } else {
                if c == "(" or c == "<" {
                    depth = depth + 1
                } else if c == ")" or c == ">" {
                    depth = depth - 1
                }
                part.append(c)
            }
            i = i + 1
        }
        out.push(part.build())
        return out
    }

    fn fn_ret(self, ty: string): string {
        if !self.is_fn_type(ty) {
            return "unknown"
        }
        let close = self.fn_close(ty)
        if close < 0 or close + 3 > ty.len {
            return "unknown"
        }
        return ty.slice(close + 3, ty.len)
    }

    fn assignable(self, expected: string, actual: string): bool {
        if expected == actual {
            return true
        }
        if expected == "unknown" {
            return true
        }
        if actual == "unknown" {
            // An unmodeled expression is not evidence of a type error.
            return true
        }
        if self.is_number(expected) and self.is_number(actual) {
            return true
        }
        if self.is_union(expected) {
            for member in self.union_members(expected) {
                if self.assignable(member, actual) {
                    return true
                }
            }
            return false
        }
        if self.is_union(actual) {
            for member in self.union_members(actual) {
                if !self.assignable(expected, member) {
                    return false
                }
            }
            return true
        }
        if actual == "null" {
            return self.is_optional(expected)
        }
        if self.is_optional(expected) {
            // `T` fits `T?`: the optional adds null to the domain.
            return self.assignable(self.optional_inner(expected), actual)
        }
        if self.is_optional(actual) and self.is_optional(expected) {
            return self.assignable(self.optional_inner(expected), self.optional_inner(actual))
        }
        if self.is_list(expected) and self.is_list(actual) {
            return self.assignable(self.list_element(expected), self.list_element(actual))
        }
        if self.is_fn_type(expected) and self.is_fn_type(actual) {
            let expected_params = self.fn_params(expected)
            let actual_params = self.fn_params(actual)
            if expected_params.len != actual_params.len {
                return false
            }
            let mut i = 0
            while i < expected_params.len {
                if !self.assignable(expected_params[i], actual_params[i]) {
                    return false
                }
                i = i + 1
            }
            return self.assignable(self.fn_ret(expected), self.fn_ret(actual))
        }
        if self.is_map(expected) and self.is_map(actual) {
            return self.assignable(self.map_key(expected), self.map_key(actual))
                and self.assignable(self.map_value(expected), self.map_value(actual))
        }
        if self.is_set(expected) and self.is_set(actual) {
            return self.assignable(self.set_element(expected), self.set_element(actual))
        }
        return false
    }

    fn unify(mut self, node: Node, left: string, right: string): string {
        if left == right {
            return left
        }
        if left == "unknown" {
            // An empty literal or an unmodeled operand should not erase the
            // type the other side already established.
            return right
        }
        if right == "unknown" {
            return left
        }
        if self.assignable(left, right) {
            return left
        }
        if self.assignable(right, left) {
            return right
        }
        if self.is_optional(left) and right == "null" {
            return left
        }
        if self.is_optional(right) and left == "null" {
            return right
        }
        self.fail(
            node,
            "E0211",
            "`" + left + "` and `" + right + "` have no common type",
        )
        return "unknown"
    }

    // ── declarations ─────────────────────────────────────────────────────

    fn collect_functions(mut self, root: Node, module_id: string) {
        for item in root.children {
            if item.kind == "Fn" {
                if self.is_macro_decl(item) {
                    self.has_macros = true
                } else {
                    self.add_function(item, module_id)
                }
            } else if item.kind == "Const" {
                self.add_const_sig(item, module_id)
            } else if item.kind == "Mod" {
                self.collect_mod(item, module_id)
            } else if item.kind == "Use" {
                self.add_module_use(module_id, item)
            } else if item.kind == "Struct" {
                self.add_struct(item, module_id)
            } else if item.kind == "Enum" {
                self.add_enum(item, module_id)
            } else if item.kind == "TypeAlias" {
                self.add_alias(item, module_id)
            } else if item.kind == "Impl" {
                self.add_impl(item, module_id)
            } else if item.kind == "Extern" {
                for child in item.children {
                    if child.kind == "ExternFn" {
                        self.add_extern_function(child, module_id)
                    }
                }
            }
        }
    }

    /// Register struct names before function signatures are read, so a
    /// parameter or return type may name a struct declared later.
    fn collect_structs(mut self, items: Node, module_id: string) {
        for item in items.children {
            if item.kind == "Struct" {
                self.add_struct(item, module_id)
            } else if item.kind == "Enum" {
                self.add_enum(item, module_id)
            } else if item.kind == "TypeAlias" {
                self.add_alias(item, module_id)
            } else if item.kind == "Mod" and has_child_kind(item, "ModBody") {
                let child = if module_id == "" {
                    item.value
                } else {
                    module_id + "::" + item.value
                }
                self.collect_structs(item, child)
            }
        }
    }

    /// Prelude `Result`/`Error`: a user declaration of the same name wins,
    /// because the builtins are added after the user's type names.
    fn add_builtin_types(mut self) {
        if self.find_struct_in("", "Error") < 0 {
            self.structs.push(
                StructSig(
                    name: "Error",
                    module_id: "",
                    is_pub: true,
                    field_nodes: [],
                    fields: [FieldSig(name: "message", ty: "string")],
                ),
            )
        }
        if self.find_enum_in("", "Result") < 0 {
            self.enums.push(
                EnumSig(
                    name: "Result",
                    module_id: "",
                    is_pub: true,
                    is_generic: false,
                    variant_nodes: [],
                    variants: [
                        VariantSig(
                            name: "Ok",
                            field_nodes: [],
                            fields: [FieldSig(name: "", ty: "unknown")],
                        ),
                        VariantSig(
                            name: "Err",
                            field_nodes: [],
                            fields: [FieldSig(name: "", ty: "unknown")],
                        ),
                    ],
                ),
            )
        }
    }

    fn add_struct(mut self, item: Node, module_id: string) {
        if self.find_struct_in(module_id, item.value) >= 0 {
            return
        }
        self.note_generic_params(item)
        let mut field_nodes: List<Node> = []
        for child in item.children {
            if child.kind == "Field" {
                field_nodes.push(child)
            }
        }
        self.structs.push(
            StructSig(
                name: item.value,
                module_id: module_id,
                is_pub: has_child_kind(item, "Pub"),
                field_nodes: field_nodes,
                fields: [],
            ),
        )
    }

    /// Fill struct field types after every struct name exists, so a field may
    /// name a struct declared later in the same module.
    fn resolve_structs(mut self) {
        let saved_module = self.current_module
        let mut i = 0
        while i < self.structs.len and self.error == "" {
            self.current_module = self.structs[i].module_id
            let mut f = 0
            while f < self.structs[i].field_nodes.len and self.error == "" {
                let field = self.structs[i].field_nodes[f]
                let mut ty = "unknown"
                for child in field.children {
                    if self.is_type_node(child) {
                        ty = self.type_of(child)
                    }
                }
                self.structs[i].fields.push(FieldSig(name: field.value, ty: ty))
                f = f + 1
            }
            i = i + 1
        }
        self.current_module = saved_module
    }

    fn add_enum(mut self, item: Node, module_id: string) {
        if self.find_enum_in(module_id, item.value) >= 0 {
            return
        }
        self.note_generic_params(item)
        let mut variant_nodes: List<Node> = []
        for child in item.children {
            if child.kind == "Variant" {
                variant_nodes.push(child)
            }
        }
        self.enums.push(
            EnumSig(
                name: item.value,
                module_id: module_id,
                is_pub: has_child_kind(item, "Pub"),
                is_generic: has_child_kind(item, "GenericParams"),
                variant_nodes: variant_nodes,
                variants: [],
            ),
        )
    }

    fn add_alias(mut self, item: Node, module_id: string) {
        if self.find_alias_in(module_id, item.value) >= 0 {
            return
        }
        self.note_generic_params(item)
        let mut type_node = item
        for child in item.children {
            if self.is_type_node(child) {
                type_node = child
            }
        }
        self.aliases.push(
            AliasSig(
                name: item.value,
                module_id: module_id,
                is_pub: has_child_kind(item, "Pub"),
                is_generic: has_child_kind(item, "GenericParams"),
                type_node: type_node,
                target: "",
            ),
        )
    }

    fn add_impl(mut self, item: Node, module_id: string) {
        self.note_generic_params(item)
        let mut type_names: List<string> = []
        for child in item.children {
            if child.kind == "TypeName" {
                type_names.push(child.value)
            }
        }
        // `impl Trait for Type` has two type names; trait dispatch stays
        // outside this pass.
        if type_names.len != 1 {
            self.complete = false
            return
        }
        let owner = type_names[0]
        for child in item.children {
            if child.kind == "Fn" {
                self.methods.push(
                    MethodSig(
                        owner: owner,
                        name: child.value,
                        module_id: module_id,
                        param_names: [],
                        min_params: 0,
                        params: [],
                        ret: "unknown",
                        decl: child,
                    ),
                )
            }
        }
    }

    /// Resolve owner types and signatures once structs, enums, aliases, and
    /// imports are known.
    fn resolve_method_signatures(mut self) {
        let saved_module = self.current_module
        let mut i = 0
        while i < self.methods.len and self.error == "" {
            self.current_module = self.methods[i].module_id
            let raw_owner = self.methods[i].owner
            let struct_index = self.resolve_struct(self.methods[i].module_id, raw_owner, 0)
            if struct_index >= 0 {
                self.methods[i].owner = self.struct_canonical(struct_index)
            } else {
                let enum_index = self.resolve_enum(self.methods[i].module_id, raw_owner, 0)
                if enum_index >= 0 and !self.enums[enum_index].is_generic {
                    self.methods[i].owner = self.enum_canonical(enum_index)
                } else {
                    self.methods[i].owner = "unknown"
                    self.complete = false
                }
            }
            let item = self.methods[i].decl
            let mut names: List<string> = []
            let mut params: List<string> = []
            let mut ret = "unknown"
            let mut min_params = 0
            let mut seen_default = false
            for child in item.children {
                if child.kind == "Param" {
                    if child.value == "self" or child.value == "mut self" {
                        continue
                    }
                    names.push(child.value)
                    let mut ty = "unknown"
                    let mut has_default = false
                    for part in child.children {
                        if self.is_type_node(part) {
                            ty = self.type_of(part)
                        } else if part.kind != "Pub" and part.kind != "Async"
                            and part.kind != "Mut" and part.kind != "Shared"
                        {
                            has_default = true
                        }
                    }
                    if has_default and !seen_default {
                        min_params = params.len
                        seen_default = true
                    }
                    params.push(ty)
                } else if self.is_type_node(child) {
                    ret = self.type_of(child)
                }
            }
            if !seen_default {
                min_params = params.len
            }
            if self.error == "" {
                self.methods[i].param_names = names
                self.methods[i].min_params = min_params
                self.methods[i].params = params
                self.methods[i].ret = ret
            }
            i = i + 1
        }
        self.current_module = saved_module
    }

    /// Fill variant payload types after every type name exists. A generic
    /// enum's payloads may mention type parameters, so they stay unresolved
    /// (the enum itself is then treated as an opaque type).
    fn resolve_enums(mut self) {
        let saved_module = self.current_module
        let mut i = 0
        while i < self.enums.len and self.error == "" {
            self.current_module = self.enums[i].module_id
            if !self.enums[i].is_generic {
                let mut v = 0
                while v < self.enums[i].variant_nodes.len and self.error == "" {
                    let variant = self.enums[i].variant_nodes[v]
                    let mut variant_fields: List<FieldSig> = []
                    let mut field_nodes: List<Node> = []
                    let mut payload_nodes: List<Node> = []
                    for child in variant.children {
                        if child.kind == "Payload" {
                            for part in child.children {
                                if part.kind == "PayloadField" {
                                    let mut ty = "unknown"
                                    for type_child in part.children {
                                        if self.is_type_node(type_child) {
                                            ty = self.type_of(type_child)
                                        }
                                    }
                                    variant_fields.push(FieldSig(name: part.value, ty: ty))
                                } else if self.is_type_node(part) {
                                    payload_nodes.push(part)
                                }
                            }
                        }
                    }
                    let mut p = 0
                    while p < payload_nodes.len {
                        let ty = self.type_of(payload_nodes[p])
                        variant_fields.push(FieldSig(name: "", ty: ty))
                        p = p + 1
                    }
                    field_nodes.push(variant)
                    self.enums[i].variants.push(
                        VariantSig(
                            name: variant.value,
                            field_nodes: field_nodes,
                            fields: variant_fields,
                        ),
                    )
                    v = v + 1
                }
            }
            i = i + 1
        }
        self.current_module = saved_module
    }

    fn collect_mod(mut self, item: Node, parent: string) {
        let module_id = if parent == "" { item.value } else { parent + "::" + item.value }
        let inline = has_child_kind(item, "ModBody")
        // A file-backed module lives in another file; the checker has no
        // loader, so its interface is opaque rather than "not found".
        self.add_module(module_id, parent, !inline)
        if !inline {
            return
        }
        for child in item.children {
            if child.kind == "Fn" {
                if self.is_macro_decl(child) {
                    self.has_macros = true
                } else {
                    self.add_function(child, module_id)
                }
            } else if child.kind == "Const" {
                self.add_const_sig(child, module_id)
            } else if child.kind == "Mod" {
                self.collect_mod(child, module_id)
            } else if child.kind == "Use" {
                self.add_module_use(module_id, child)
            } else if child.kind == "Struct" {
                self.add_struct(child, module_id)
            } else if child.kind == "Enum" {
                self.add_enum(child, module_id)
            } else if child.kind == "TypeAlias" {
                self.add_alias(child, module_id)
            } else if child.kind == "Impl" {
                self.add_impl(child, module_id)
            } else if child.kind == "Extern" {
                for entry in child.children {
                    if entry.kind == "ExternFn" {
                        self.add_extern_function(entry, module_id)
                    }
                }
            }
        }
    }

    fn add_function(mut self, item: Node, module_id: string) {
        if self.error != "" {
            return
        }
        self.note_generic_params(item)
        self.functions.push(
            FuncSig(
                name: item.value,
                module_id: module_id,
                is_pub: has_child_kind(item, "Pub"),
                min_params: 0,
                params: [],
                ret: "unknown",
                decl: item,
            ),
        )
    }

    /// `extern "C" { fn abs(x: i32): i32 as c_abs }`: the C symbol stays in
    /// the declaration; the local binding is the `as` alias when present.
    fn add_extern_function(mut self, item: Node, module_id: string) {
        if self.error != "" {
            return
        }
        let mut name = item.value
        for child in item.children {
            if child.kind == "ExternAlias" {
                name = child.value
            }
        }
        self.functions.push(
            FuncSig(
                name: name,
                module_id: module_id,
                is_pub: true,
                min_params: 0,
                params: [],
                ret: "unit",
                decl: item,
            ),
        )
    }

    /// Resolve parameter and return types after `use` and struct names are
    /// known, so a signature may name an imported or forward-declared type.
    fn resolve_function_signatures(mut self) {
        let saved_module = self.current_module
        let mut i = 0
        while i < self.functions.len and self.error == "" {
            let sig = self.functions[i]
            self.current_module = sig.module_id
            let item = sig.decl
            let mut params: List<string> = []
            let mut ret = "unknown"
            if item.kind == "ExternFn" {
                // A C function without a return annotation is `void`.
                ret = "unit"
            }
            let mut min_params = 0
            let mut seen_default = false
            for child in item.children {
                if child.kind == "Param" {
                    if child.value == "self" or child.value == "mut self" {
                        self.fail(child, "E0003", "stage 1 checker does not support methods yet")
                        break
                    }
                    let mut ty = "unknown"
                    let mut has_default = false
                    for part in child.children {
                        if self.is_type_node(part) {
                            ty = self.type_of(part)
                        } else if part.kind != "Pub" and part.kind != "Async"
                            and part.kind != "Mut" and part.kind != "Shared"
                        {
                            has_default = true
                        }
                    }
                    if item.kind == "ExternFn" and self.is_optional(ty) {
                        // `free(p: Ptr?)`: an omitted optional FFI argument
                        // binds `null`.
                        has_default = true
                    }
                    if has_default and !seen_default {
                        min_params = params.len
                        seen_default = true
                    }
                    params.push(ty)
                } else if self.is_type_node(child) {
                    ret = self.type_of(child)
                }
            }
            if !seen_default {
                min_params = params.len
            }
            if self.error == "" {
                self.functions[i].min_params = min_params
                self.functions[i].params = params
                self.functions[i].ret = ret
            }
            i = i + 1
        }
        self.current_module = saved_module
    }

    fn add_const_sig(mut self, item: Node, module_id: string) {
        if self.error != "" {
            return
        }
        self.current_module = module_id
        let mut ty = ""
        for child in item.children {
            if self.is_type_node(child) {
                ty = self.type_of(child)
            }
        }
        let index = self.module_index(module_id)
        if index >= 0 and self.error == "" {
            self.modules[index].consts.push(
                ConstSig(name: item.value, ty: ty, is_pub: has_child_kind(item, "Pub")),
            )
        }
    }

    fn add_module_use(mut self, module_id: string, item: Node) {
        let index = self.module_index(module_id)
        if index >= 0 {
            self.modules[index].uses.push(item)
        }
    }

    fn resolve_uses(mut self) {
        let mut m = 0
        while m < self.modules.len {
            let module_id = self.modules[m].id
            let mut u = 0
            while u < self.modules[m].uses.len {
                let node = self.modules[m].uses[u]
                self.resolve_use(module_id, node)
                u = u + 1
            }
            m = m + 1
        }
    }

    fn resolve_use(mut self, module_id: string, node: Node) {
        let type_only = has_child_kind(node, "UseType")
        let is_pub = has_child_kind(node, "Pub")
        let head = node.value
        let mut segments: List<string> = []
        let mut alias = ""
        let mut group = node
        let mut has_group = false
        let mut glob = false
        for child in node.children {
            if child.kind == "UseSegment" {
                segments.push(child.value)
            } else if child.kind == "UseAlias" {
                alias = child.value
            } else if child.kind == "UseGroup" {
                group = child
                has_group = true
            } else if child.kind == "UseGlob" {
                glob = true
            }
        }
        if has_group {
            if head == "" {
                for entry in group.children {
                    self.mark_export(module_id, entry.value)
                }
                return
            }
            let prefix = self.resolve_module(module_id, head, segments)
            if prefix == "#" {
                // `use std::http::{Request, Response}`: every entry may name a
                // type, function, or constant outside this buffer.
                for entry in group.children {
                    let mut entry_alias = ""
                    for child in entry.children {
                        if child.kind == "UseAlias" {
                            entry_alias = child.value
                        }
                    }
                    let bound = if entry_alias == "" { entry.value } else { entry_alias }
                    self.note_external_import(bound)
                }
                return
            }
            for entry in group.children {
                let mut rel: List<string> = []
                let mut entry_alias = ""
                for child in entry.children {
                    if child.kind == "UseSegment" {
                        rel.push(child.value)
                    } else if child.kind == "UseAlias" {
                        entry_alias = child.value
                    }
                }
                let mut target = prefix
                let mut i = 0
                while i + 1 < rel.len {
                    let child = self.child_module(target, rel[i])
                    if child != "#" {
                        target = child
                    } else {
                        let aliased = self.import_module(target, rel[i])
                        if aliased == "#" {
                            target = "#"
                            break
                        }
                        target = aliased
                    }
                    i = i + 1
                }
                if target == "#" {
                    continue
                }
                let bound = if entry_alias == "" { entry.value } else { entry_alias }
                if type_only {
                    self.note_foreign_type(module_id, bound, target)
                }
                let child = self.child_module(target, entry.value)
                if child != "#" {
                    self.add_import(module_id, bound, child, "", is_pub)
                } else {
                    self.add_import(module_id, bound, target, entry.value, is_pub)
                }
            }
            return
        }
        if glob {
            let target = self.resolve_module(module_id, head, segments)
            // `#` records an external glob (`use std::fmt::*`): the module is
            // outside this buffer, so a bare name may still come from it.
            self.add_glob(module_id, target, is_pub)
            return
        }
        if head == "" {
            return
        }
        if segments.len == 0 {
            let target = self.resolve_module(module_id, head, [])
            if target != "#" {
                let bound = if alias == "" { head } else { alias }
                self.add_import(module_id, bound, target, "", is_pub)
            }
            return
        }
        let member = segments[segments.len - 1]
        let mut prefix: List<string> = []
        let mut i = 0
        while i + 1 < segments.len {
            prefix.push(segments[i])
            i = i + 1
        }
        let bound = if alias == "" { member } else { alias }
        let target = self.resolve_module(module_id, head, prefix)
        if target == "#" {
            // `use std::os::exec_path`: the binding exists, but its kind and
            // signature are outside this buffer.
            self.note_external_import(bound)
            return
        }
        if type_only {
            self.note_foreign_type(module_id, bound, target)
        }
        let child = self.child_module(target, member)
        if child != "#" {
            self.add_import(module_id, bound, child, "", is_pub)
            return
        }
        self.add_import(module_id, bound, target, member, is_pub)
    }

    fn note_foreign_type(mut self, module_id: string, name: string, target: string) {
        let index = self.module_index(module_id)
        if index < 0 {
            return
        }
        if target == "#" {
            self.modules[index].foreign_types.push(name)
            return
        }
        let target_index = self.module_index(target)
        if target_index >= 0 and self.modules[target_index].opaque {
            self.modules[index].foreign_types.push(name)
        }
    }

    fn is_foreign_type(self, module_id: string, name: string): bool {
        let index = self.module_index(module_id)
        if index < 0 {
            return false
        }
        let mut i = 0
        while i < self.modules[index].foreign_types.len {
            if self.modules[index].foreign_types[i] == name {
                return true
            }
            i = i + 1
        }
        return false
    }

    fn add_import(mut self, module_id: string, bound: string,
                  target: string, member: string, is_pub: bool) {
        let index = self.module_index(module_id)
        if index >= 0 {
            self.modules[index].imports.push(
                ImportSig(alias: bound, target: target, member: member, is_pub: is_pub),
            )
        }
    }

    fn add_glob(mut self, module_id: string, target: string, is_pub: bool) {
        let index = self.module_index(module_id)
        if index >= 0 {
            self.modules[index].globs.push(GlobSig(target: target, is_pub: is_pub))
        }
    }

    fn has_external_glob(self, module_id: string): bool {
        let index = self.module_index(module_id)
        if index < 0 {
            return false
        }
        let mut i = 0
        while i < self.modules[index].globs.len {
            if self.modules[index].globs[i].target == "#" {
                return true
            }
            i = i + 1
        }
        return false
    }

    fn mark_export(mut self, module_id: string, name: string) {
        let mut f = 0
        while f < self.functions.len {
            if self.functions[f].module_id == module_id and self.functions[f].name == name {
                self.functions[f].is_pub = true
            }
            f = f + 1
        }
        let index = self.module_index(module_id)
        if index < 0 {
            return
        }
        let mut c = 0
        while c < self.modules[index].consts.len {
            if self.modules[index].consts[c].name == name {
                self.modules[index].consts[c].is_pub = true
            }
            c = c + 1
        }
        let mut i = 0
        while i < self.modules[index].imports.len {
            if self.modules[index].imports[i].alias == name {
                self.modules[index].imports[i].is_pub = true
            }
            i = i + 1
        }
    }

    fn check_program(mut self, root: Node) {
        self.check_module_items(root, "", false)
    }

    fn check_module_items(mut self, items: Node, module_id: string, nested: bool) {
        let saved_module = self.current_module
        self.current_module = module_id
        if nested {
            self.enter_scope()
        }
        for item in items.children {
            if self.error != "" {
                break
            }
            if item.kind == "Fn" {
                if !self.is_macro_decl(item) {
                    self.check_function(item)
                }
            } else if item.kind == "Let" {
                self.check_let(item)
            } else if item.kind == "Const" {
                self.check_const(item)
            } else if item.kind == "Mod" {
                if has_child_kind(item, "ModBody") {
                    let child = if module_id == "" {
                        item.value
                    } else {
                        module_id + "::" + item.value
                    }
                    self.check_module_items(item, child, true)
                }
                // A file-backed module's body is not in this buffer; calls
                // into it resolve as opaque instead of producing a false
                // "not found".
            } else if item.kind == "Attribute" or item.kind == "Use"
                or item.kind == "Pub" or item.kind == "Async" or item.kind == "ModBody"
            {
                // Attributes are attached to their declaration, imports were
                // resolved before checking, and the markers are not
                // declarations.
            } else if item.kind == "Struct" or item.kind == "Enum"
                or item.kind == "TypeAlias" or item.kind == "Extern"
            {
                // Fields, payloads, alias targets, and FFI signatures are
                // resolved before checking.
            } else if item.kind == "Trait" {
                // Trait declarations carry signatures only; dispatch through
                // `Trait::method(recv)` stays opaque, so the pass is partial.
                self.complete = false
            } else if item.kind == "Impl" {
                for child in item.children {
                    if child.kind == "Fn" {
                        self.check_method(child)
                    }
                }
            } else {
                self.fail(
                    item,
                    "E0003",
                    "stage 1 checker does not support `" + item.kind + "` declarations yet",
                )
            }
        }
        if nested {
            self.leave_scope()
        }
        self.current_module = saved_module
    }

    fn check_function(mut self, item: Node) {
        let index = self.find_function_in(self.current_module, item.value)
        if index < 0 {
            self.fail(item, "E0101", "cannot find function `" + item.value + "`")
            return
        }
        let sig = self.functions[index]
        self.current_return = sig.ret
        self.enter_scope()
        self.bind_const_params(item)
        let mut p = 0
        while p < sig.params.len {
            let name = self.param_name(item, p)
            self.bind(name, sig.params[p])
            p = p + 1
        }
        let mut body = item
        let mut found = false
        for child in item.children {
            if child.kind == "Block" {
                body = child
                found = true
            }
        }
        if !found {
            self.fail(item, "E0003", "a function needs a body")
        } else {
            self.check_block(body, false)
        }
        self.leave_scope()
    }

    fn check_method(mut self, item: Node) {
        let index = self.find_method_in(self.current_module, item.value)
        if index < 0 {
            self.complete = false
            return
        }
        let sig = self.methods[index]
        self.current_return = sig.ret
        self.enter_scope()
        self.bind("self", sig.owner)
        let mut p = 0
        while p < sig.param_names.len and p < sig.params.len {
            self.bind(sig.param_names[p], sig.params[p])
            p = p + 1
        }
        let mut body = item
        let mut found = false
        for child in item.children {
            if child.kind == "Block" {
                body = child
                found = true
            }
        }
        if !found {
            self.fail(item, "E0003", "a method needs a body")
        } else {
            self.check_block(body, false)
        }
        self.leave_scope()
    }

    // The parser stores parameter names on the direct `Param` children.
    fn param_name(self, item: Node, index: number): string {
        let mut seen = 0
        for child in item.children {
            if child.kind == "Param" {
                if seen == index {
                    return child.value
                }
                seen = seen + 1
            }
        }
        return "_"
    }

    fn check_const(mut self, item: Node) {
        let mut ty = ""
        let mut initializer = item
        let mut found = false
        for child in item.children {
            if child.kind == "Pub" or child.kind == "Async" {
                continue
            }
            if self.is_type_node(child) {
                ty = self.type_of(child)
            } else {
                initializer = child
                found = true
            }
        }
        if !found {
            self.fail(item, "E0003", "a constant needs an initializer")
            return
        }
        let actual = self.check_expr(initializer)
        if ty == "" {
            ty = actual
        } else if !self.assignable(ty, actual) {
            self.fail(
                initializer,
                "E0201",
                "expected `" + ty + "`, found `" + actual + "`",
            )
        }
        self.bind(item.value, ty)
    }

    fn check_let(mut self, item: Node) {
        if item.value == "" and item.children.len >= 2
            and item.children[0].kind == "Destructure"
        {
            let pattern = item.children[0]
            let initializer = item.children[item.children.len - 1]
            let actual = self.check_expr(initializer)
            if self.error != "" {
                // Still bind the names so later reads do not add cascading
                // "not found" errors to a partial analysis.
                for binding in pattern.children {
                    if binding.kind == "NamePattern" and binding.value != "_" {
                        self.bind(binding.value, "unknown")
                    }
                }
                return
            }
            self.bind_destructure(pattern, actual)
            return
        }
        let mut ty = ""
        let mut initializer = item
        let mut found = false
        for child in item.children {
            if child.kind == "Mut" or child.kind == "Pub" or child.kind == "Async" {
                // Mutability is tracked when the checker grows assignment rules.
            } else if self.is_type_node(child) {
                ty = self.type_of(child)
            } else {
                initializer = child
                found = true
            }
        }
        if !found {
            self.fail(item, "E0003", "a binding needs an initializer")
            return
        }
        if ty != "" and self.is_map(ty) and initializer.kind == "Map" {
            self.check_map_against(initializer, ty)
            self.bind(item.value, ty)
            return
        }
        if ty != "" and initializer.kind == "Map" {
            let struct_index = self.find_struct_by_type(self.optional_inner(ty))
            if struct_index >= 0 {
                self.check_struct_object(initializer, struct_index)
                if self.error == "" {
                    self.bind(item.value, ty)
                }
                return
            }
        }
        let actual = self.check_expr(initializer)
        if ty == "" {
            ty = actual
        } else if !self.assignable(ty, actual) {
            self.fail(
                initializer,
                "E0201",
                "expected `" + ty + "`, found `" + actual + "`",
            )
        }
        self.bind(item.value, ty)
    }

    /// Check a `{ k: v }` initializer against an expected `Map<K, V>`.
    fn check_map_against(mut self, node: Node, ty: string) {
        let key_ty = self.map_key(ty)
        let value_ty = self.map_value(ty)
        for child in node.children {
            if child.kind == "Entry" {
                if child.children.len >= 2 {
                    let key = self.check_expr(child.children[0])
                    let value = self.check_expr(child.children[1])
                    if self.error != "" {
                        return
                    }
                    if !self.assignable(key_ty, key) {
                        self.fail(
                            child,
                            "E0201",
                            "map key expects `" + key_ty + "`, found `" + key + "`",
                        )
                        return
                    }
                    if !self.assignable(value_ty, value) {
                        self.fail(
                            child,
                            "E0201",
                            "map value expects `" + value_ty + "`, found `" + value + "`",
                        )
                        return
                    }
                } else if child.children.len == 1 {
                    // An untyped object entry has an identifier key, which is
                    // a string by construction.
                    if !self.assignable(key_ty, "string") {
                        self.fail(
                            child,
                            "E0201",
                            "map key expects `" + key_ty + "`, found `string`",
                        )
                        return
                    }
                    let value = self.check_expr(child.children[0])
                    if self.error != "" {
                        return
                    }
                    if !self.assignable(value_ty, value) {
                        self.fail(
                            child,
                            "E0201",
                            "map value expects `" + value_ty + "`, found `" + value + "`",
                        )
                        return
                    }
                } else {
                    self.complete = false
                }
            } else {
                // A spread needs the operand's shape, which is not available
                // when the expected type is a map.
                self.check_expr(child)
                self.complete = false
            }
        }
    }

    fn check_struct_object(mut self, node: Node, index: number) {
        let sig = self.structs[index]
        let mut used: List<bool> = []
        let mut f = 0
        while f < sig.fields.len {
            used.push(false)
            f = f + 1
        }
        for child in node.children {
            if child.kind != "Entry" {
                self.complete = false
                continue
            }
            if child.children.len == 0 {
                self.complete = false
                continue
            }
            let mut target = self.struct_field_index(index, child.value)
            if target < 0 {
                self.fail(
                    node,
                    "E0206",
                    "`" + sig.name + "` has no field `" + child.value + "`",
                )
                return
            }
            if used[target] {
                self.fail(
                    node,
                    "E0208",
                    "field `" + sig.fields[target].name + "` is initialized twice",
                )
                return
            }
            used[target] = true
            let ty = self.check_expr(child.children[0])
            if self.error != "" {
                return
            }
            if !self.assignable(sig.fields[target].ty, ty) {
                self.fail(
                    node,
                    "E0202",
                    "field `" + sig.fields[target].name + "` expects `"
                        + sig.fields[target].ty + "`, found `" + ty + "`",
                )
                return
            }
        }
        f = 0
        while f < used.len {
            if !used[f] and !self.is_optional(sig.fields[f].ty) {
                self.fail(
                    node,
                    "E0205",
                    "missing field `" + sig.fields[f].name + "` in initializer of `"
                        + sig.name + "`",
                )
                return
            }
            f = f + 1
        }
    }

    fn bind_destructure(mut self, pattern: Node, actual: string) {
        if pattern.value == "object" {
            let anon = self.find_anon(actual)
            let struct_index = self.find_struct_by_type(actual)
            for binding in pattern.children {
                if binding.kind != "NamePattern" or binding.value == "_" {
                    continue
                }
                let name = binding.value
                let mut ty = "unknown"
                if anon >= 0 {
                    let mut f = self.anon_objects[anon].fields.len
                    while f > 0 {
                        f = f - 1
                        if self.anon_objects[anon].fields[f].name == name {
                            ty = self.anon_objects[anon].fields[f].ty
                        }
                    }
                } else if struct_index >= 0 {
                    let f = self.struct_field_index(struct_index, name)
                    if f >= 0 {
                        ty = self.structs[struct_index].fields[f].ty
                    }
                } else {
                    self.complete = false
                }
                self.bind(name, ty)
            }
            return
        }
        if pattern.value == "tuple" {
            let parts = self.tuple_types(actual)
            if parts.len != pattern.children.len {
                self.complete = false
            }
            let mut i = 0
            while i < pattern.children.len {
                let binding = pattern.children[i]
                if binding.kind == "NamePattern" and binding.value != "_" {
                    if i < parts.len {
                        self.bind(binding.value, parts[i])
                    } else {
                        self.bind(binding.value, "unknown")
                    }
                }
                i = i + 1
            }
            return
        }
        self.complete = false
        for binding in pattern.children {
            if binding.kind == "NamePattern" and binding.value != "_" {
                self.bind(binding.value, "unknown")
            }
        }
    }

    // ── statements ───────────────────────────────────────────────────────

    fn check_block(mut self, block: Node, value_used: bool): string {
        self.enter_scope()
        let mut value = "unit"
        let mut index = 0
        for stmt in block.children {
            if self.error != "" {
                break
            }
            value = self.check_statement(
                stmt,
                value_used and index == block.children.len - 1,
            )
            index = index + 1
        }
        self.leave_scope()
        return value
    }

    fn check_statement(mut self, stmt: Node, value_used: bool): string {
        if stmt.kind == "Let" {
            self.check_let(stmt)
            return "unit"
        }
        if stmt.kind == "Const" {
            self.check_const(stmt)
            return "unit"
        }
        if stmt.kind == "Assign" {
            self.check_assign(stmt)
            return "unit"
        }
        if stmt.kind == "ExprStmt" {
            if stmt.children.len == 0 {
                return "unit"
            }
            let expr = stmt.children[0]
            if !value_used and expr.kind == "Match" {
                // A statement-position `match` may mix arm types (one arm
                // prints, another yields a value); only a value-position
                // match needs a common type.
                self.check_match_arms(expr, false)
                return "unit"
            }
            return self.check_expr(expr)
        }
        if stmt.kind == "Lock" {
            self.check_lock(stmt)
            return "unit"
        }
        if stmt.kind == "Spawn" {
            self.check_spawn(stmt)
            return "unit"
        }
        if stmt.kind == "Return" {
            self.check_return(stmt)
            return "unit"
        }
        if stmt.kind == "Jump" {
            return "unit"
        }
        if stmt.kind == "Defer" {
            if stmt.children.len > 0 {
                self.check_expr(stmt.children[0])
            }
            return "unit"
        }
        if stmt.kind == "While" {
            self.check_while(stmt)
            return "unit"
        }
        if stmt.kind == "For" {
            self.check_for(stmt)
            return "unit"
        }
        if stmt.kind == "Fn" {
            self.fail(stmt, "E0003", "nested functions are not supported yet")
            return "unit"
        }
        self.fail(
            stmt,
            "E0003",
            "stage 1 checker does not support `" + stmt.kind + "` statements yet",
        )
        return "unit"
    }

    fn check_assign(mut self, stmt: Node) {
        if stmt.children.len < 2 {
            self.fail(stmt, "E0003", "an assignment needs two operands")
            return
        }
        let lhs = self.place_type(stmt.children[0])
        let rhs = self.check_expr(stmt.children[1])
        if self.error == "" and (lhs == "unknown" or rhs == "unknown") {
            self.complete = false
            return
        }
        if self.error == "" and !self.assignable(lhs, rhs) {
            self.fail(
                stmt,
                "E0201",
                "expected `" + lhs + "`, found `" + rhs + "`",
            )
        }
    }

    fn place_type(mut self, node: Node): string {
        if node.kind == "Name" {
            let ty = self.lookup(node.value)
            if ty == "" {
                self.fail(node, "E0101", "cannot find value `" + node.value + "` in this scope")
                return "unknown"
            }
            return ty
        }
        if node.kind == "Index" {
            return self.check_index(node)
        }
        if node.kind == "Member" {
            return self.check_expr(node)
        }
        self.fail(node, "E0003", "stage 1 checker does not support this assignment target yet")
        return "unknown"
    }

    fn check_return(mut self, stmt: Node) {
        let mut actual = "unit"
        if stmt.children.len > 0 {
            actual = self.check_expr(stmt.children[0])
        }
        if self.error != "" {
            return
        }
        if !self.assignable(self.current_return, actual) {
            self.fail(
                stmt,
                "E0203",
                "expected `" + self.current_return + "`, found `" + actual + "`",
            )
        }
    }

    fn check_while(mut self, stmt: Node) {
        if stmt.children.len == 0 {
            self.fail(stmt, "E0003", "a loop needs a condition")
            return
        }
        let cond = self.check_expr(stmt.children[0])
        if self.error == "" and cond != "bool" {
            self.fail(
                stmt.children[0],
                "E0201",
                "expected `bool`, found `" + cond + "`",
            )
            return
        }
        if stmt.children.len > 1 {
            self.check_block(stmt.children[1], false)
        }
    }

    fn check_for(mut self, stmt: Node) {
        if stmt.children.len == 0 {
            self.fail(stmt, "E0003", "a for loop needs an iterable")
            return
        }
        let iterable = self.check_expr(stmt.children[0])
        if self.error != "" {
            return
        }
        if iterable == "unknown" {
            self.complete = false
            self.enter_scope()
            self.bind(stmt.value, "unknown")
            if stmt.children.len > 1 {
                self.check_block(stmt.children[1], false)
            }
            self.leave_scope()
            return
        }
        if !self.is_list(iterable) and !self.is_range(iterable)
            and !self.is_map(iterable) and !self.is_set(iterable)
        {
            self.fail(
                stmt.children[0],
                "E0213",
                "`" + iterable + "` is not iterable",
            )
            return
        }
        self.enter_scope()
        if self.is_range(iterable) {
            self.bind(stmt.value, "number")
        } else if self.is_map(iterable) {
            self.bind(stmt.value, self.map_key(iterable))
        } else if self.is_set(iterable) {
            self.bind(stmt.value, self.set_element(iterable))
        } else {
            self.bind(stmt.value, self.list_element(iterable))
        }
        if stmt.children.len > 1 {
            self.check_block(stmt.children[1], false)
        }
        self.leave_scope()
    }

    // ── expressions ──────────────────────────────────────────────────────

    fn check_expr(mut self, node: Node): string {
        if self.error != "" {
            return "unknown"
        }
        if node.kind == "Literal" {
            return self.literal_type(node.value)
        }
        if node.kind == "Name" {
            let mut ty = self.lookup(node.value)
            if ty == "" {
                ty = self.value_type(self.current_module, node.value, 0)
                if ty == "unknown" {
                    // A module constant whose type is hidden (opaque module,
                    // missing annotation, or unknown import).
                    self.complete = false
                }
            }
            if ty == "" {
                let fn_index = self.resolve_function(self.current_module, node.value, 0)
                if fn_index >= 0 {
                    let sig = self.functions[fn_index]
                    return self.make_fn_type(sig.params, sig.ret)
                }
                if fn_index == -2 {
                    self.complete = false
                    return "unknown"
                }
                if self.is_external_import(node.value) {
                    // A value imported from outside this buffer.
                    self.complete = false
                    return "unknown"
                }
                self.fail(node, "E0101", "cannot find value `" + node.value + "` in this scope")
                return "unknown"
            }
            return ty
        }
        if node.kind == "Path" {
            let enum_index = self.resolve_variant_path(node.value)
            if enum_index >= 0 {
                if self.enums[enum_index].is_generic {
                    self.complete = false
                    return "unknown"
                }
                let parts = split_path(node.value)
                let variant = self.variant_index(enum_index, parts[parts.len - 1])
                if variant >= 0 and self.enums[enum_index].variants[variant].fields.len == 0 {
                    return self.enum_canonical(enum_index)
                }
                self.complete = false
                return "unknown"
            }
            let ty = self.path_value_type(node.value)
            if ty == "" or ty == "unknown" {
                // A std path, a function value, or a module the checker does
                // not model.
                self.complete = false
                return "unknown"
            }
            return ty
        }
        if node.kind == "Group" {
            if node.children.len == 0 {
                return "unit"
            }
            return self.check_expr(node.children[0])
        }
        if node.kind == "Binary" {
            return self.check_binary(node)
        }
        if node.kind == "Unary" {
            return self.check_unary(node)
        }
        if node.kind == "Call" {
            return self.check_call(node)
        }
        if node.kind == "Member" {
            return self.check_member(node)
        }
        if node.kind == "OptionalMember" {
            return self.check_optional_member(node)
        }
        if node.kind == "Index" {
            return self.check_index(node)
        }
        if node.kind == "If" {
            return self.check_if(node)
        }
        if node.kind == "Ternary" {
            return self.check_ternary(node)
        }
        if node.kind == "List" {
            return self.check_list(node)
        }
        if node.kind == "Block" {
            return self.check_block(node, true)
        }
        if node.kind == "Spawn" {
            return self.check_spawn(node)
        }
        if node.kind == "Lock" {
            return self.check_lock(node)
        }
        if node.kind == "MacroCall" {
            // The expansion is not in this buffer.
            self.complete = false
            return "unknown"
        }
        if node.kind == "Assign" {
            if node.children.len < 2 {
                return "unknown"
            }
            let lhs = self.place_type(node.children[0])
            let rhs = self.check_expr(node.children[1])
            if self.error == "" and (lhs == "unknown" or rhs == "unknown") {
                self.complete = false
            } else if self.error == "" and !self.assignable(lhs, rhs) {
                self.fail(node, "E0201", "expected `" + lhs + "`, found `" + rhs + "`")
            }
            return rhs
        }
        if node.kind == "Try" or node.kind == "Await" {
            if node.children.len > 0 {
                self.check_expr(node.children[0])
            }
            self.complete = false
            return "unknown"
        }
        if node.kind == "Is" {
            if node.children.len < 2 {
                self.complete = false
                return "bool"
            }
            let left = self.check_expr(node.children[0])
            let right = self.type_of(node.children[1])
            if self.error != "" {
                return "unknown"
            }
            if left == "unknown" or right == "unknown" {
                self.complete = false
            }
            return "bool"
        }
        if node.kind == "Closure" or node.kind == "ArrowClosure" {
            return self.check_closure(node)
        }
        if node.kind == "Tuple" {
            let mut text = "("
            let mut i = 0
            while i < node.children.len {
                if i > 0 {
                    text = text + ","
                }
                text = text + self.check_expr(node.children[i])
                i = i + 1
            }
            if self.error != "" {
                return "unknown"
            }
            return text + ")"
        }
        if node.kind == "Spread" {
            if node.children.len == 0 {
                self.complete = false
                return "unknown"
            }
            let inner = self.check_expr(node.children[0])
            if inner == "unknown" {
                self.complete = false
            }
            return inner
        }
        if node.kind == "Map" {
            return self.check_map_literal(node)
        }
        if node.kind == "Match" {
            return self.check_match(node)
        }
        if node.kind == "Template" {
            for child in node.children {
                if child.kind != "TemplateText" {
                    self.check_expr(child)
                    if self.error != "" {
                        return "unknown"
                    }
                }
            }
            return "string"
        }
        self.fail(
            node,
            "E0003",
            "stage 1 checker does not support `" + node.kind + "` expressions yet",
        )
        return "unknown"
    }

    fn literal_type(self, text: string): string {
        if text == "true" or text == "false" {
            return "bool"
        }
        if text == "null" {
            return "null"
        }
        if text.len == 0 {
            return "unknown"
        }
        let first = text.slice(0, 1)
        if first == "\"" or first == "'" or first == "`" {
            return "string"
        }
        return "number"
    }

    /// `spawn async { … }`, `spawn.thread`, `spawn.process { … }`, and
    /// `spawn.on(target)`: a task's type is its body's type, while a service
    /// declaration is an opaque handle.
    fn check_spawn(mut self, node: Node): string {
        let mut result = "unit"
        let mut has_body = false
        let mut service = false
        for child in node.children {
            if child.kind == "Block" {
                result = self.check_block(child, true)
                has_body = true
            } else if self.is_type_node(child) {
                service = true
                self.type_of(child)
                if self.error != "" {
                    return "unknown"
                }
            } else {
                self.check_expr(child)
                if self.error != "" {
                    return "unknown"
                }
            }
        }
        if service {
            return "unknown"
        }
        if !has_body {
            self.complete = false
        }
        return result
    }

    fn check_lock(mut self, node: Node): string {
        if node.children.len == 0 {
            return "unit"
        }
        self.check_expr(node.children[0])
        if self.error != "" {
            return "unknown"
        }
        if node.children.len > 1 {
            return self.check_block(node.children[1], true)
        }
        return "unit"
    }

    fn check_unary(mut self, node: Node): string {
        if node.children.len == 0 {
            return "unit"
        }
        let ty = self.check_expr(node.children[0])
        if self.error != "" {
            return "unknown"
        }
        if ty == "unknown" {
            self.complete = false
            return "unknown"
        }
        if node.value == "await" {
            // `await task` yields the task's payload; the checker models a
            // task as the type of its body.
            return ty
        }
        if node.value == "!" {
            if ty != "bool" {
                self.fail(node, "E0201", "expected `bool`, found `" + ty + "`")
                return "unknown"
            }
            return "bool"
        }
        if node.value == "-" or node.value == "~" {
            if !self.is_number(ty) {
                self.fail(node, "E0201", "expected `number`, found `" + ty + "`")
                return "unknown"
            }
            return "number"
        }
        if node.value == "shared" or node.value == "copy" or node.value == "move" {
            return ty
        }
        self.fail(node, "E0003", "stage 1 checker does not support `" + node.value + "` yet")
        return "unknown"
    }

    fn check_binary(mut self, node: Node): string {
        if node.children.len < 2 {
            return "unit"
        }
        let left = self.check_expr(node.children[0])
        let right = self.check_expr(node.children[1])
        if self.error != "" {
            return "unknown"
        }
        if left == "unknown" or right == "unknown" {
            self.complete = false
            return "unknown"
        }
        let op = node.value
        if op == "..<" or op == "..=" {
            if self.is_number(left) and self.is_number(right) {
                return "Range"
            }
            self.fail(node, "E0201", "a range needs `number` operands")
            return "unknown"
        }
        if op == "+" {
            if self.is_number(left) and self.is_number(right) {
                return "number"
            }
            if left == "string" and right == "string" {
                return "string"
            }
            if self.is_list(left) and self.is_list(right) {
                let elem = self.unify(
                    node,
                    self.list_element(left),
                    self.list_element(right),
                )
                return "List<" + elem + ">"
            }
            self.fail(
                node,
                "E0201",
                "operator `+` cannot combine `" + left + "` and `" + right + "`",
            )
            return "unknown"
        }
        if op == "-"
            or op == "*"
            or op == "/"
            or op == "%"
            or op == "**"
            or op == "&"
            or op == "|"
            or op == "^"
            or op == "<<"
            or op == ">>"
        {
            if self.is_number(left) and self.is_number(right) {
                return "number"
            }
            self.fail(
                node,
                "E0201",
                "operator `" + op + "` needs `number` operands, found `" + left + "` and `" + right + "`",
            )
            return "unknown"
        }
        if op == "<" or op == ">" or op == "<=" or op == ">=" {
            if self.is_number(left) and self.is_number(right) {
                return "bool"
            }
            self.fail(
                node,
                "E0201",
                "operator `" + op + "` needs `number` operands",
            )
            return "unknown"
        }
        if op == "and" or op == "or" {
            if left == "bool" and right == "bool" {
                return "bool"
            }
            self.fail(node, "E0201", "operator `" + op + "` needs `bool` operands")
            return "unknown"
        }
        if op == "==" or op == "!=" {
            if self.assignable(left, right) or self.assignable(right, left) {
                return "bool"
            }
            self.fail(
                node,
                "E0201",
                "`" + left + "` and `" + right + "` cannot be compared",
            )
            return "unknown"
        }
        if op == "??" {
            if left == "null" {
                return right
            }
            if self.is_optional(left) {
                return self.unify(node, self.optional_inner(left), right)
            }
            if left == "unknown" {
                return right
            }
            self.fail(node, "E0201", "`??` needs an optional or null left operand")
            return "unknown"
        }
        self.fail(node, "E0003", "stage 1 checker does not support `" + op + "` yet")
        return "unknown"
    }

    fn check_call(mut self, node: Node): string {
        if node.children.len == 0 {
            return "unit"
        }
        let mut callee = node.children[0]
        let mut type_args: List<string> = []
        if callee.kind == "TypeApply" and callee.children.len > 0 {
            // `f<T>(…)` / `Array::filled<T, N>(…)`: the callee is the first
            // child and the type arguments are a sibling.
            type_args = self.type_arguments(callee)
            callee = callee.children[0]
        }
        if callee.kind == "Member" or callee.kind == "OptionalMember" {
            return self.check_method_call(node, callee)
        }
        let mut name = ""
        if callee.kind == "Name" or callee.kind == "Path" {
            name = callee.value
        }
        let mut arg_types: List<string> = []
        let mut arg_names: List<string> = []
        let mut i = 1
        while i < node.children.len {
            let mut arg = node.children[i]
            if arg.kind == "Arg" {
                arg_names.push(arg.value)
                if arg.children.len > 0 {
                    arg = arg.children[0]
                }
            } else {
                arg_names.push("")
            }
            arg_types.push(self.check_expr(arg))
            i = i + 1
        }
        if self.error != "" {
            return "unknown"
        }
        if callee.kind != "Name" and callee.kind != "Path" {
            // A call through any expression: `fs[0]()`, `make()(1)`, and so on.
            let target = self.check_expr(callee)
            if self.is_fn_type(target) {
                return self.check_fn_value_call(node, "value", target, arg_types)
            }
            if target == "unknown" {
                self.complete = false
                return "unknown"
            }
            self.fail(callee, "E0204", "this expression is not callable")
            return "unknown"
        }
        if self.is_fn_type(self.lookup(name)) {
            return self.check_fn_value_call(node, name, self.lookup(name), arg_types)
        }
        if name == "print" or name == "println" {
            return "unit"
        }
        if name == "str" {
            if arg_types.len != 1 {
                self.fail(node, "E0207", "`str` expects 1 argument")
            }
            return "string"
        }
        if name == "assert" {
            if arg_types.len != 2 {
                self.fail(node, "E0207", "`assert` expects 2 arguments")
                return "unit"
            }
            if arg_types[0] != "bool" {
                self.fail(node, "E0202", "`assert` expects a `bool` condition")
            }
            if arg_types[1] != "string" {
                self.fail(node, "E0202", "`assert` expects a `string` message")
            }
            return "unit"
        }
        if name == "panic" {
            return "unit"
        }
        if name == "reply" {
            // A service handler's reply value is consumed by the runtime.
            return "unit"
        }
        if name == "Array::filled" {
            let mut elem = "unknown"
            if type_args.len > 0 {
                elem = type_args[0]
            } else if arg_types.len > 0 {
                elem = arg_types[0]
            }
            if arg_types.len != 1 {
                self.fail(node, "E0207", "`Array::filled` expects 1 argument")
                return "List<" + elem + ">"
            }
            if !self.assignable(elem, arg_types[0]) {
                self.fail(
                    node,
                    "E0202",
                    "`Array::filled` expects a `" + elem + "` value, found `"
                        + arg_types[0] + "`",
                )
            }
            return "List<" + elem + ">"
        }
        if name == "Set::from_list" {
            if arg_types.len != 1 {
                self.fail(node, "E0207", "`Set::from_list` expects 1 argument")
                return "Set<unknown>"
            }
            if self.is_list(arg_types[0]) {
                return "Set<" + self.list_element(arg_types[0]) + ">"
            }
            if arg_types[0] == "unknown" {
                self.complete = false
                return "Set<unknown>"
            }
            self.fail(
                node,
                "E0202",
                "`Set::from_list` expects a list, found `" + arg_types[0] + "`",
            )
            return "Set<unknown>"
        }
        let struct_index = self.resolve_struct(self.current_module, name, 0)
        if struct_index >= 0 {
            return self.check_struct_constructor(node, struct_index, arg_names, arg_types)
        }
        if callee.kind == "Path" {
            let enum_index = self.resolve_variant_path(name)
            if enum_index >= 0 {
                return self.check_variant_constructor(node, enum_index, name, arg_names, arg_types)
            }
        }
        let index = self.resolve_function(self.current_module, name, 0)
        if index == -2 {
            // A file-backed module or an external/std path: its interface is
            // outside the checker's input, so this is not a confirmed error.
            self.complete = false
            return "unknown"
        }
        if index < 0 {
            if callee.kind == "Path" {
                self.complete = false
                return "unknown"
            }
            if self.has_macros {
                // A declared macro may generate this function.
                self.complete = false
                return "unknown"
            }
            if self.lookup(name) != "" {
                self.fail(node, "E0204", "`" + name + "` is not callable")
            } else {
                self.complete = false
                self.fail(node, "E0101", "cannot find function `" + name + "`")
            }
            return "unknown"
        }
        let sig = self.functions[index]
        if arg_types.len < sig.min_params or arg_types.len > sig.params.len {
            self.fail(
                node,
                "E0207",
                "`" + name + "` expects " + str(sig.min_params) + ".." + str(sig.params.len)
                    + " arguments, found " + str(arg_types.len),
            )
            return sig.ret
        }
        let mut p = 0
        while p < arg_types.len {
            if !self.assignable(sig.params[p], arg_types[p]) {
                self.fail(
                node,
                    "E0202",
                    "argument " + str(p + 1) + " to `" + name + "` expects `" + sig.params[p] + "`, found `" + arg_types[p] + "`",
                )
                return sig.ret
            }
            p = p + 1
        }
        return sig.ret
    }

    /// A function literal (`fn(x: T): R { … }`) or arrow closure
    /// (`(x: T): R => expr`). An unannotated parameter or return stays
    /// `unknown`, so the body is checked as far as its types allow.
    fn check_closure(mut self, node: Node): string {
        let mut params: List<string> = []
        let mut ret = ""
        let mut body = node
        for child in node.children {
            if child.kind == "Param" {
                let mut ty = "unknown"
                for part in child.children {
                    if self.is_type_node(part) {
                        ty = self.type_of(part)
                    }
                }
                params.push(ty)
            } else if self.is_type_node(child) {
                ret = self.type_of(child)
            } else {
                body = child
            }
        }
        if self.error != "" {
            return "unknown"
        }
        self.enter_scope()
        let mut index = 0
        for child in node.children {
            if child.kind == "Param" {
                self.bind(child.value, params[index])
                index = index + 1
            }
        }
        let body_ty = self.check_expr(body)
        self.leave_scope()
        if self.error != "" {
            return "unknown"
        }
        if ret == "" {
            ret = body_ty
        } else if body_ty != "unknown" and !self.assignable(ret, body_ty) {
            self.fail(
                body,
                "E0201",
                "closure returns `" + body_ty + "`, expected `" + ret + "`",
            )
            return "unknown"
        }
        return self.make_fn_type(params, ret)
    }

    fn check_fn_value_call(mut self, node: Node, label: string, ty: string,
                           args: List<string>): string {
        let params = self.fn_params(ty)
        let ret = self.fn_ret(ty)
        if args.len != params.len {
            self.fail(
                node,
                "E0207",
                "`" + label + "` expects " + str(params.len) + " arguments, found "
                    + str(args.len),
            )
            return ret
        }
        let mut i = 0
        while i < args.len {
            if !self.assignable(params[i], args[i]) {
                self.fail(
                    node,
                    "E0202",
                    "argument " + str(i + 1) + " to `" + label + "` expects `"
                        + params[i] + "`, found `" + args[i] + "`",
                )
                return ret
            }
            i = i + 1
        }
        return ret
    }

    fn check_method_call(mut self, node: Node, callee: Node): string {
        let mut arg_types: List<string> = []
        let mut i = 1
        while i < node.children.len {
            let mut arg = node.children[i]
            if arg.kind == "Arg" {
                if arg.children.len > 0 {
                    arg = arg.children[0]
                }
            }
            arg_types.push(self.check_expr(arg))
            i = i + 1
        }
        if callee.children.len == 0 {
            return "unknown"
        }
        let recv = self.check_expr(callee.children[0])
        if self.error != "" {
            return "unknown"
        }
        if recv == "unknown" {
            self.complete = false
            return "unknown"
        }
        if self.is_map(recv) or self.is_set(recv) or self.is_list(recv)
            or recv == "string"
        {
            let builtin = self.collection_method(node, recv, callee.value, arg_types)
            if builtin != "" {
                return builtin
            }
        }
        let index = self.find_method(recv, callee.value)
        if index < 0 {
            // Built-in collection/string members are outside this pass.
            self.complete = false
            return "unknown"
        }
        let sig = self.methods[index]
        if arg_types.len < sig.min_params or arg_types.len > sig.params.len {
            self.fail(
                node,
                "E0207",
                "`" + sig.name + "` expects " + str(sig.min_params) + ".."
                    + str(sig.params.len) + " arguments, found " + str(arg_types.len),
            )
            return sig.ret
        }
        let mut p = 0
        while p < arg_types.len {
            if !self.assignable(sig.params[p], arg_types[p]) {
                self.fail(
                    node,
                    "E0202",
                    "argument " + str(p + 1) + " to `" + sig.name + "` expects `"
                        + sig.params[p] + "`, found `" + arg_types[p] + "`",
                )
                return sig.ret
            }
            p = p + 1
        }
        return sig.ret
    }

    fn expect_arity(mut self, node: Node, name: string, args: List<string>,
                    count: number): bool {
        if args.len == count {
            return true
        }
        self.fail(
            node,
            "E0207",
            "`" + name + "` expects " + str(count) + " arguments, found " + str(args.len),
        )
        return false
    }

    fn expect_arg(mut self, node: Node, name: string, index: number,
                  expected: string, args: List<string>): bool {
        if args.len <= index {
            return false
        }
        if self.assignable(expected, args[index]) {
            return true
        }
        self.fail(
            node,
            "E0202",
            "argument " + str(index + 1) + " to `" + name + "` expects `"
                + expected + "`, found `" + args[index] + "`",
        )
        return false
    }

    /// Built-in collection members (`Map`, `Set`, and `List`). Returns `""`
    /// when the name is not a builtin, so user methods still resolve.
    fn collection_method(mut self, node: Node, recv: string, name: string,
                         args: List<string>): string {
        if self.is_map(recv) {
            let key = self.map_key(recv)
            let value = self.map_value(recv)
            if name == "get" or name == "remove" {
                self.expect_arity(node, name, args, 1)
                self.expect_arg(node, name, 0, key, args)
                return value + "?"
            }
            if name == "set" {
                if self.expect_arity(node, name, args, 2) {
                    self.expect_arg(node, name, 0, key, args)
                    self.expect_arg(node, name, 1, value, args)
                }
                return "unit"
            }
            if name == "has" or name == "contains" {
                self.expect_arity(node, name, args, 1)
                self.expect_arg(node, name, 0, key, args)
                return "bool"
            }
            if name == "keys" {
                return "List<" + key + ">"
            }
            if name == "values" {
                return "List<" + value + ">"
            }
            if name == "entries" {
                return "List<(" + key + "," + value + ")>"
            }
            if name == "len" or name == "size" {
                return "number"
            }
            return ""
        }
        if self.is_set(recv) {
            let elem = self.set_element(recv)
            if name == "has" or name == "contains" or name == "insert"
                or name == "remove"
            {
                self.expect_arity(node, name, args, 1)
                self.expect_arg(node, name, 0, elem, args)
                return "bool"
            }
            if name == "len" or name == "size" {
                return "number"
            }
            return ""
        }
        if self.is_list(recv) {
            let elem = self.list_element(recv)
            if name == "len" or name == "size" {
                return "number"
            }
            if name == "contains" {
                self.expect_arity(node, name, args, 1)
                self.expect_arg(node, name, 0, elem, args)
                return "bool"
            }
            if name == "push" or name == "append" {
                if self.expect_arity(node, name, args, 1) {
                    self.expect_arg(node, name, 0, elem, args)
                }
                return "unit"
            }
            if name == "pop" or name == "first" or name == "last" {
                return elem + "?"
            }
            return ""
        }
        if recv == "string" {
            if name == "len" or name == "byte_len" or name == "size" {
                return "number"
            }
            if name == "contains" {
                if self.expect_arity(node, name, args, 1) {
                    self.expect_arg(node, name, 0, "string", args)
                }
                return "bool"
            }
            if name == "split" {
                return "List<string>"
            }
        }
        return ""
    }

    fn check_struct_constructor(mut self, node: Node, index: number,
                                labels: List<string>, types: List<string>): string {
        let sig = self.structs[index]
        let mut used: List<bool> = []
        let mut f = 0
        while f < sig.fields.len {
            used.push(false)
            f = f + 1
        }
        let mut seen_named = false
        let mut a = 0
        while a < types.len {
            let label = labels[a]
            let mut target = -1
            if label == "" {
                if seen_named {
                    self.fail(node, "E0208", "a positional argument follows a named argument")
                    return self.struct_canonical(index)
                }
                target = a
                if target >= sig.fields.len {
                    self.fail(
                        node,
                        "E0205",
                        "too many fields in initializer of `" + sig.name + "`",
                    )
                    return self.struct_canonical(index)
                }
            } else {
                seen_named = true
                target = self.struct_field_index(index, label)
                if target < 0 {
                    self.fail(
                        node,
                        "E0206",
                        "`" + sig.name + "` has no field `" + label + "`",
                    )
                    return self.struct_canonical(index)
                }
            }
            if used[target] {
                self.fail(
                    node,
                    "E0208",
                    "field `" + sig.fields[target].name + "` is initialized twice",
                )
                return self.struct_canonical(index)
            }
            used[target] = true
            if !self.assignable(sig.fields[target].ty, types[a]) {
                self.fail(
                    node,
                    "E0202",
                    "field `" + sig.fields[target].name + "` expects `"
                        + sig.fields[target].ty + "`, found `" + types[a] + "`",
                )
                return self.struct_canonical(index)
            }
            a = a + 1
        }
        f = 0
        while f < used.len {
            if !used[f] and !self.is_optional(sig.fields[f].ty) {
                self.fail(
                    node,
                    "E0205",
                    "missing field `" + sig.fields[f].name + "` in initializer of `"
                        + sig.name + "`",
                )
                return self.struct_canonical(index)
            }
            f = f + 1
        }
        return self.struct_canonical(index)
    }

    fn check_variant_constructor(mut self, node: Node, enum_index: number,
                                 path: string, labels: List<string>, types: List<string>): string {
        if self.enums[enum_index].is_generic {
            self.complete = false
            return "unknown"
        }
        let parts = split_path(path)
        let variant = parts[parts.len - 1]
        let v = self.variant_index(enum_index, variant)
        if v < 0 {
            self.fail(
                node,
                "E0102",
                "`" + self.enums[enum_index].name + "` has no variant `" + variant + "`",
            )
            return self.enum_canonical(enum_index)
        }
        let fields = self.enums[enum_index].variants[v].fields
        if types.len != fields.len {
            self.fail(
                node,
                "E0207",
                "variant `" + variant + "` expects " + str(fields.len)
                    + " payload values, found " + str(types.len),
            )
            return self.enum_canonical(enum_index)
        }
        let mut i = 0
        while i < types.len {
            if labels[i] != "" {
                let target = self.variant_field_index(enum_index, v, labels[i])
                if target < 0 {
                    self.fail(
                        node,
                        "E0102",
                        "variant `" + variant + "` has no payload field `" + labels[i] + "`",
                    )
                    return self.enum_canonical(enum_index)
                }
                if !self.assignable(fields[target].ty, types[i]) {
                    self.fail(
                        node,
                        "E0202",
                        "payload field `" + labels[i] + "` expects `"
                            + fields[target].ty + "`, found `" + types[i] + "`",
                    )
                    return self.enum_canonical(enum_index)
                }
            } else if !self.assignable(fields[i].ty, types[i]) {
                self.fail(
                    node,
                    "E0202",
                    "payload " + str(i + 1) + " of `" + variant + "` expects `"
                        + fields[i].ty + "`, found `" + types[i] + "`",
                )
                return self.enum_canonical(enum_index)
            }
            i = i + 1
        }
        return self.enum_canonical(enum_index)
    }

    fn variant_field_index(self, enum_index: number, variant: number, name: string): number {
        if enum_index < 0 or enum_index >= self.enums.len {
            return -1
        }
        if variant < 0 or variant >= self.enums[enum_index].variants.len {
            return -1
        }
        let fields = self.enums[enum_index].variants[variant].fields
        let mut i = 0
        while i < fields.len {
            if fields[i].name == name {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn struct_field_index(self, index: number, name: string): number {
        if index < 0 or index >= self.structs.len {
            return -1
        }
        let mut i = 0
        while i < self.structs[index].fields.len {
            if self.structs[index].fields[i].name == name {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn check_member(mut self, node: Node): string {
        if node.children.len == 0 {
            return "unknown"
        }
        let recv = self.check_expr(node.children[0])
        if self.error != "" {
            return "unknown"
        }
        return self.member_type(node, recv)
    }

    fn check_optional_member(mut self, node: Node): string {
        if node.children.len == 0 {
            return "unknown"
        }
        let recv = self.check_expr(node.children[0])
        if self.error != "" {
            return "unknown"
        }
        if recv == "null" {
            return "null"
        }
        if recv == "unknown" {
            self.complete = false
            return "unknown"
        }
        let ty = self.member_type(node, self.optional_inner(recv))
        if ty == "unknown" or ty == "null" or self.is_optional(ty) {
            return ty
        }
        return ty + "?"
    }

    fn member_type(mut self, node: Node, recv: string): string {
        if recv == "unknown" {
            self.complete = false
            return "unknown"
        }
        if node.value == "len" or node.value == "byte_len" {
            if recv == "string" or self.is_list(recv) {
                return "number"
            }
        }
        if node.value == "size" or node.value == "len" {
            if self.is_map(recv) or self.is_set(recv) {
                return "number"
            }
        }
        let position = self.index_text(node.value)
        if position >= 0 and self.is_tuple_type(recv) {
            let parts = self.tuple_types(recv)
            if position >= parts.len {
                self.fail(
                    node,
                    "E0220",
                    "tuple position " + node.value + " is out of range for `" + recv + "`",
                )
                return "unknown"
            }
            return parts[position]
        }
        let anon = self.find_anon(recv)
        if anon >= 0 {
            let mut i = self.anon_objects[anon].fields.len
            while i > 0 {
                i = i - 1
                if self.anon_objects[anon].fields[i].name == node.value {
                    return self.anon_objects[anon].fields[i].ty
                }
            }
            self.fail(
                node,
                "E0206",
                "object literal has no field `" + node.value + "`",
            )
            return "unknown"
        }
        let struct_index = self.find_struct_by_type(recv)
        if struct_index >= 0 {
            let field = self.struct_field_index(struct_index, node.value)
            if field >= 0 {
                return self.structs[struct_index].fields[field].ty
            }
            if self.has_macros {
                // A derive macro may add the field.
                self.complete = false
                return "unknown"
            }
            self.fail(
                node,
                "E0206",
                "`" + self.structs[struct_index].name + "` has no field `"
                    + node.value + "`",
            )
            return "unknown"
        }
        self.fail(
            node,
            "E0102",
            "no member `" + node.value + "` on `" + recv + "`",
        )
        return "unknown"
    }

    fn check_index(mut self, node: Node): string {
        if node.children.len < 2 {
            return "unknown"
        }
        let recv = self.check_expr(node.children[0])
        let index = self.check_expr(node.children[1])
        if self.error != "" {
            return "unknown"
        }
        if recv == "unknown" or index == "unknown" {
            self.complete = false
            return "unknown"
        }
        if self.is_map(recv) {
            if !self.assignable(self.map_key(recv), index) {
                self.fail(
                    node.children[1],
                    "E0201",
                    "map key expects `" + self.map_key(recv) + "`, found `" + index + "`",
                )
            }
            return self.map_value(recv)
        }
        if !self.is_number(index) {
            self.fail(
                node.children[1],
                "E0201",
                "an index must be `number`, found `" + index + "`",
            )
            return "unknown"
        }
        if self.is_list(recv) {
            return self.list_element(recv)
        }
        self.fail(node, "E0215", "`" + recv + "` cannot be indexed")
        return "unknown"
    }

    fn check_if(mut self, node: Node): string {
        if node.children.len < 2 {
            return "unit"
        }
        let cond = self.check_expr(node.children[0])
        if self.error != "" {
            return "unknown"
        }
        if cond == "unknown" {
            self.complete = false
            return "unknown"
        }
        if cond != "bool" {
            self.fail(
                node.children[0],
                "E0201",
                "expected `bool`, found `" + cond + "`",
            )
            return "unknown"
        }
        let mut narrow_name = ""
        let mut then_narrow = ""
        let mut else_narrow = ""
        let condition = node.children[0]
        if condition.kind == "Binary" and condition.children.len == 2
            and (condition.value == "!=" or condition.value == "==")
        {
            let left = condition.children[0]
            let right = condition.children[1]
            let mut tested = left
            let mut null_on_right = true
            if left.kind == "Literal" and left.value == "null" {
                tested = right
                null_on_right = false
            } else if !(right.kind == "Literal" and right.value == "null") {
                tested = condition
            }
            let is_null_test = null_on_right
                and right.kind == "Literal" and right.value == "null"
            let is_null_test2 = !null_on_right
                and left.kind == "Literal" and left.value == "null"
            if tested.kind == "Name" and (is_null_test or is_null_test2) {
                let ty = self.lookup(tested.value)
                if self.is_optional(ty) {
                    narrow_name = tested.value
                    let inner = self.optional_inner(ty)
                    if condition.value == "==" {
                        else_narrow = inner
                    } else {
                        then_narrow = inner
                    }
                }
            }
        } else if condition.kind == "Is" and condition.children.len >= 2
            and condition.children[0].kind == "Name"
        {
            let name = condition.children[0].value
            let current = self.lookup(name)
            let tested = self.type_of(condition.children[1])
            if self.error == "" and tested != "unknown" {
                narrow_name = name
                if condition.value == "is not" {
                    then_narrow = self.without_union_member(current, tested)
                    else_narrow = tested
                } else {
                    then_narrow = tested
                    else_narrow = self.without_union_member(current, tested)
                }
            }
        }
        let then_ty = if narrow_name != "" and then_narrow != "" {
            self.enter_scope()
            self.bind(narrow_name, then_narrow)
            let ty = self.check_block(node.children[1], true)
            self.leave_scope()
            ty
        } else {
            self.check_block(node.children[1], true)
        }
        if node.children.len < 3 {
            return "unit"
        }
        let else_node = node.children[2]
        let else_ty = if narrow_name != "" and else_narrow != "" {
            self.enter_scope()
            self.bind(narrow_name, else_narrow)
            let ty = if else_node.kind == "If" {
                self.check_expr(else_node)
            } else {
                self.check_block(else_node, true)
            }
            self.leave_scope()
            ty
        } else if else_node.kind == "If" {
            self.check_expr(else_node)
        } else {
            self.check_block(else_node, true)
        }
        return self.unify(node, then_ty, else_ty)
    }

    fn check_ternary(mut self, node: Node): string {
        if node.children.len < 3 {
            return "unknown"
        }
        let cond = self.check_expr(node.children[0])
        if self.error != "" {
            return "unknown"
        }
        if cond != "bool" {
            self.fail(node.children[0], "E0201", "a ternary condition must be `bool`")
            return "unknown"
        }
        let then_ty = self.check_expr(node.children[1])
        let else_ty = self.check_expr(node.children[2])
        return self.unify(node, then_ty, else_ty)
    }

    fn check_match(mut self, node: Node): string {
        return self.check_match_arms(node, true)
    }

    fn check_match_arms(mut self, node: Node, unify_arms: bool): string {
        if node.children.len == 0 {
            return "unit"
        }
        let subject = self.check_expr(node.children[0])
        if self.error != "" {
            return "unknown"
        }
        let mut result = "unit"
        let mut first = true
        let mut i = 1
        while i < node.children.len {
            let arm = node.children[i]
            if arm.kind != "Arm" or arm.children.len == 0 {
                self.complete = false
                i = i + 1
                continue
            }
            self.enter_scope()
            self.check_pattern(arm.children[0], subject)
            // The guard, when present, sits between the pattern and the body.
            let mut g = 1
            while g + 1 < arm.children.len {
                let child = arm.children[g]
                if child.kind == "Guard" and child.children.len > 0 {
                    let guard_ty = self.check_expr(child.children[0])
                    if self.error == "" and guard_ty != "bool" and guard_ty != "unknown" {
                        self.fail(
                            child,
                            "E0201",
                            "a match guard must be `bool`, found `" + guard_ty + "`",
                        )
                    }
                    if guard_ty == "unknown" {
                        self.complete = false
                    }
                }
                g = g + 1
            }
            let body = arm.children[arm.children.len - 1]
            let arm_ty = if body.kind == "Block" {
                self.check_block(body, true)
            } else {
                self.check_expr(body)
            }
            self.leave_scope()
            if self.error != "" {
                return "unknown"
            }
            if first {
                result = arm_ty
                first = false
            } else if unify_arms {
                result = self.unify(node, result, arm_ty)
            }
            i = i + 1
        }
        if result == "unknown" {
            self.complete = false
        }
        return result
    }

    fn check_pattern(mut self, pattern: Node, subject: string) {
        if pattern.kind == "NamePattern" {
            let value = pattern.value
            if value == "_" {
                return
            }
            if value.split("::").len > 1 {
                let enum_index = self.resolve_variant_path(value)
                if enum_index < 0 {
                    self.complete = false
                    return
                }
                if self.enums[enum_index].is_generic {
                    self.complete = false
                    return
                }
                if subject != "unknown" and subject != self.enum_canonical(enum_index) {
                    self.fail(
                        pattern,
                        "E0201",
                        "pattern `" + value + "` does not match `" + subject + "`",
                    )
                }
                return
            }
            self.bind(value, subject)
            return
        }
        if pattern.kind == "VariantPattern" {
            if pattern.value.split("::").len == 1 {
                let struct_index = self.resolve_struct(self.current_module, pattern.value, 0)
                if struct_index >= 0 {
                    if subject != "unknown" and subject != self.struct_canonical(struct_index) {
                        self.fail(
                            pattern,
                            "E0201",
                            "pattern `" + pattern.value + "` does not match `" + subject + "`",
                        )
                        return
                    }
                    let fields = self.structs[struct_index].fields
                    for child in pattern.children {
                        if child.kind == "PatternPayload" {
                            if child.children.len != fields.len {
                                self.complete = false
                                return
                            }
                            let mut p = 0
                            while p < child.children.len {
                                let binding = child.children[p]
                                if binding.kind == "NamePattern" and binding.value != "_" {
                                    self.bind(binding.value, fields[p].ty)
                                } else if binding.kind != "NamePattern" {
                                    self.complete = false
                                }
                                p = p + 1
                            }
                        }
                    }
                    return
                }
            }
            let enum_index = self.resolve_variant_path(pattern.value)
            if enum_index < 0 {
                self.complete = false
                return
            }
            if self.enums[enum_index].is_generic {
                // Payload types mention type parameters; bind the names so
                // the arm body still checks, but keep the pass incomplete.
                for child in pattern.children {
                    if child.kind == "PatternPayload" {
                        for binding in child.children {
                            if binding.kind == "NamePattern" and binding.value != "_" {
                                self.bind(binding.value, "unknown")
                            }
                        }
                    }
                }
                self.complete = false
                return
            }
            if subject != "unknown" and subject != self.enum_canonical(enum_index) {
                self.fail(
                    pattern,
                    "E0201",
                    "pattern `" + pattern.value + "` does not match `" + subject + "`",
                )
                return
            }
            let parts = split_path(pattern.value)
            let variant = self.variant_index(enum_index, parts[parts.len - 1])
            if variant < 0 {
                self.complete = false
                return
            }
            let fields = self.enums[enum_index].variants[variant].fields
            for child in pattern.children {
                if child.kind != "PatternPayload" {
                    continue
                }
                if child.children.len != fields.len {
                    self.complete = false
                    return
                }
                let mut p = 0
                while p < child.children.len {
                    let binding = child.children[p]
                    if binding.kind == "NamePattern" and binding.value != "_" {
                        self.bind(binding.value, fields[p].ty)
                    } else if binding.kind != "NamePattern" {
                        self.complete = false
                    }
                    p = p + 1
                }
            }
            return
        }
        if pattern.kind == "TypePattern" {
            // `bool b`, `int i`, `string s`: bind the trailing name.
            let words = pattern.value.split(" ")
            let mut type_text = ""
            let mut binder = ""
            for word in words {
                if word != "" {
                    if type_text == "" {
                        type_text = word
                    }
                    binder = word
                }
            }
            if type_text == "int" or type_text == "number" or type_text == "float" {
                type_text = "number"
            }
            if binder != "" and binder != "_" {
                self.bind(binder, type_text)
            }
            return
        }
        // Literal, range, or-patterns and struct patterns carry no binding the
        // checker needs here; shapes it cannot read stay "not modeled".
        if pattern.kind != "LiteralPattern" {
            self.complete = false
        }
    }

    fn is_tuple_type(self, ty: string): bool {
        if ty.len < 2 {
            return false
        }
        return ty.slice(0, 1) == "(" and ty.slice(ty.len - 1, ty.len) == ")"
    }

    /// Split `(A,B)` / `(A,(B,C))` into top-level element types.
    fn tuple_types(self, ty: string): List<string> {
        let mut out: List<string> = []
        if !self.is_tuple_type(ty) {
            return out
        }
        let inner = ty.slice(1, ty.len - 1)
        let chars = inner.split("")
        let mut part = StringBuilder::new()
        let mut depth = 0
        let mut i = 0
        while i < chars.len {
            let c = chars[i]
            if c == "," and depth == 0 {
                out.push(part.build())
                part = StringBuilder::new()
            } else {
                if c == "<" or c == "(" {
                    depth = depth + 1
                } else if c == ">" or c == ")" {
                    depth = depth - 1
                }
                part.append(c)
            }
            i = i + 1
        }
        out.push(part.build())
        return out
    }

    /// A member name that is a tuple position (`0`, `1`, …); `-1` otherwise.
    fn index_text(self, text: string): number {
        if text == "" {
            return -1
        }
        let mut value = 0
        let chars = text.split("")
        let mut i = 0
        while i < chars.len {
            let code = chars[i].code_at(0)
            if code < 48 or code > 57 {
                return -1
            }
            value = value * 10 + (code - 48)
            i = i + 1
        }
        return value
    }

    fn check_map_literal(mut self, node: Node): string {
        let mut fields: List<FieldSig> = []
        // `Map<K, V>{ k: v }` uses expression keys (two children per entry);
        // `{ k: v }` uses identifier keys (one child) and stays an anonymous
        // object so member reads keep their shape.
        let mut typed = node.children.len > 0
        let mut key_ty = ""
        let mut value_ty = ""
        for child in node.children {
            if child.kind == "Entry" {
                if child.children.len >= 2 {
                    let key = self.check_expr(child.children[0])
                    let value = self.check_expr(child.children[1])
                    if self.error != "" {
                        return "unknown"
                    }
                    if key_ty == "" {
                        key_ty = key
                    } else {
                        key_ty = self.unify(child, key_ty, key)
                    }
                    if value_ty == "" {
                        value_ty = value
                    } else {
                        value_ty = self.unify(child, value_ty, value)
                    }
                } else if child.children.len == 1 {
                    typed = false
                    let ty = self.check_expr(child.children[0])
                    fields.push(FieldSig(name: child.value, ty: ty))
                } else {
                    typed = false
                    fields.push(FieldSig(name: child.value, ty: "unknown"))
                }
            } else if child.kind == "Spread" {
                typed = false
                let inner = self.check_expr(child)
                if self.error != "" {
                    return "unknown"
                }
                let anon = self.find_anon(inner)
                if anon >= 0 {
                    for field in self.anon_objects[anon].fields {
                        fields.push(field)
                    }
                } else if inner == "unknown" or self.is_map(inner) {
                    // A spread of an opaque or map value needs the expected
                    // type; the entries that follow are still checked.
                    self.complete = false
                } else {
                    self.fail(
                        child,
                        "E0214",
                        "`" + inner + "` cannot be spread into an object",
                    )
                    return "unknown"
                }
            } else {
                typed = false
                self.complete = false
            }
        }
        if self.error != "" {
            return "unknown"
        }
        if typed {
            if key_ty == "" {
                key_ty = "unknown"
            }
            if value_ty == "" {
                value_ty = "unknown"
            }
            return "Map<" + key_ty + "," + value_ty + ">"
        }
        let id = self.next_anon
        self.next_anon = self.next_anon + 1
        self.anon_objects.push(AnonSig(id: id, fields: fields))
        return "@obj" + str(id)
    }

    fn find_anon(self, ty: string): number {
        if ty.len < 4 or ty.slice(0, 4) != "@obj" {
            return -1
        }
        let mut i = 0
        while i < self.anon_objects.len {
            if "@obj" + str(self.anon_objects[i].id) == ty {
                return i
            }
            i = i + 1
        }
        return -1
    }

    /// Merge two list-element types. A heterogeneous literal is valid and
    /// infers `unknown` (matching stage 0); `null` widens the other side to
    /// optional.
    fn merge_element(mut self, node: Node, current: string, next: string): string {
        if current == "unknown" {
            return next
        }
        if next == "unknown" {
            return current
        }
        if current == "null" {
            if self.is_optional(next) {
                return next
            }
            return next + "?"
        }
        if next == "null" {
            if self.is_optional(current) {
                return current
            }
            return current + "?"
        }
        if self.assignable(current, next) or self.assignable(next, current) {
            return self.unify(node, current, next)
        }
        return "unknown"
    }

    fn check_list(mut self, node: Node): string {
        let mut elem = ""
        for child in node.children {
            if child.kind == "Spread" {
                let inner = self.check_expr(child)
                if self.error != "" {
                    return "unknown"
                }
                if self.is_list(inner) {
                    let item = self.list_element(inner)
                    if elem == "" {
                        elem = item
                    } else {
                        elem = self.merge_element(child, elem, item)
                    }
                } else if inner == "unknown" {
                    self.complete = false
                    if elem == "" {
                        elem = "unknown"
                    }
                } else {
                    self.fail(
                        child,
                        "E0214",
                        "`" + inner + "` cannot be spread into a list",
                    )
                    return "unknown"
                }
            } else {
                let ty = self.check_expr(child)
                if self.error != "" {
                    return "unknown"
                }
                if elem == "" {
                    elem = ty
                } else {
                    elem = self.merge_element(child, elem, ty)
                }
            }
        }
        if elem == "" {
            elem = "unknown"
        }
        return "List<" + elem + ">"
    }
}

fn split_path(path: string): List<string> {
    let mut parts: List<string> = []
    let mut part = StringBuilder::new()
    let chars = path.split("")
    let mut i = 0
    while i < chars.len {
        let c = chars[i]
        if c == ":" and i + 1 < chars.len and chars[i + 1] == ":" {
            parts.push(part.build())
            part = StringBuilder::new()
            i = i + 2
        } else {
            part.append(c)
            i = i + 1
        }
    }
    parts.push(part.build())
    return parts
}

fn has_child_kind(node: Node, kind: string): bool {
    for child in node.children {
        if child.kind == kind {
            return true
        }
    }
    return false
}
