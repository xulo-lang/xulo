// xuloc's first semantic pass.
//
// The checker works on the generic AST and covers the front-end subset stage 1
// needs for Gate 3: functions, parameters, primitive types, `List<T>`, `T?`,
// `let`/`const`, assignment, `return`, `if`/`else`, `while`, `for`, calls,
// arithmetic/comparison/logical operators, indexing, and the `print`/`str`/
// `assert`/`panic` intrinsics.
//
// Layout: this file holds `CheckResult`, the signature/scope records, the
// `Checker` state, and the `check` entry point. The passes live in
// `checker/`:
//   * ck_util   — AST helpers shared by every module;
//   * ck_diag   — diagnostics and lexical scopes;
//   * ck_module — module tree and `use` resolution;
//   * ck_types  — canonical types, assignability, and unification;
//   * ck_decls  — declaration collection and signature resolution;
//   * ck_stmt   — statements, blocks, and function bodies;
//   * ck_expr   — expressions, calls, patterns, and match arms.
// Every pass is a free function taking the checker state, matching
// `backend/`'s procedural split: Xulo methods cannot cross module boundaries.
//
// It deliberately reports "not supported yet" (E0003) for declarations it does
// not understand instead of silently accepting them. Inline modules, their
// `use` paths (aliases, groups, globs), and `pub use` re-exports are modeled;
// a file-backed module is opaque because the checker has no loader. Simple
// structs are modeled too: field types, constructors, and member reads.
// Enums are modeled with payload constructors and `match` arms (variant,
// literal, type, binder, wildcard, and guard patterns); a generic enum
// instantiation keeps its payload types through construction and binding.
// Template
// strings check their interpolated expressions, and an untyped object literal
// gets an anonymous shape so its member reads and object destructuring are
// checked. Tuple types, literals, positional reads, writes, and destructuring
// are modeled as `(T1,T2)` strings, `type` aliases expand on demand, and an
// inherent `impl Type` exposes methods with `self`, default parameters relax a
// call's minimum arity, `Result`/`Error` are prelude types with the payload
// types of `Result<T, E>` carried through `?`, constructors, and `match`,
// `Map<K, V>`, `Set<T>`, and `Array<T, N>` carry their element types through
// literals,
// constructors, members, iteration, and spread, function types `fn(A)->R` and
// closures (block and arrow bodies, captured locals) are checked, union types
// `A|B` and `is` narrowing are modeled, a heterogeneous literal is
// `List<unknown>`, an external `use path::*` keeps bare names opaque,
// `await` yields its operand's task type, `spawn`/`lock`/`shared` are
// modeled, `extern "C"` declarations bind their `as` alias with `Ptr` as an
// opaque address, generic type/const parameters are `unknown` in a body but a
// call infers them from its arguments (so `first([1, 2])` yields `number`),
// generic enum instantiations (`Option<int>`) carry their payload types
// through constructors and `match`, a `trait` declaration is
// accepted with dispatch left opaque, macro definition bodies are skipped and
// a macro invocation is `unknown` (a declared macro also makes unresolved
// names opaque), names imported from an external module are opaque, a named
// function used as a value has its `fn(...)->...` type, and ranges, optional
// chaining, `try`, and null narrowing are checked. Generic instantiation and
// the remaining pattern forms arrive in later WP6 slices.
//
// Types are canonical strings (`number`, `string`, `bool`, `unit`, `unknown`,
// `null`, `List<T>`, `T?`) so comparisons never depend on structural equality.
// Scopes are a flat binding list plus a scope-id stack; leaving a block only
// decrements the active scope count, so the checker avoids list `pop`/
// `truncate`, which the AOT runtime does not lower yet.

use ast::Node;

pub mod ck_util;
pub mod ck_diag;
pub mod ck_module;
pub mod ck_types;
pub mod ck_decls;
pub mod ck_stmt;
pub mod ck_expr;

pub struct CheckResult {
    pub ok: bool,
    /// Whether the checker saw the whole program with constructs it models.
    /// `false` means it reached a declaration, type, or call it cannot judge
    /// (E0003, an unknown type name, a std/module function, a method call), so
    /// a failure is "not checked", not a confirmed error.
    pub complete: bool,
    pub code: string,
    pub message: string,
    pub line: number,
    pub column: number,
}

pub struct Binding {
    pub name: string,
    pub ty: string,
    pub scope: number,
}

pub struct FuncSig {
    pub name: string,
    pub module_id: string,
    pub is_pub: bool,
    pub min_params: number,
    pub params: List<string>,
    /// `unknown` when the declaration omits the return type: the checker does
    /// not infer it, so a call must not claim a narrower type.
    pub ret: string,
    /// Generic parameter names (`T`, `N`) and the templates that mention them
    /// as `$T$`; call sites infer the arguments and substitute the return.
    pub type_params: List<string>,
    pub param_templates: List<string>,
    pub ret_template: string,
    /// The declaration, kept so parameter and return types are resolved after
    /// every module and struct name is known.
    pub decl: Node,
}

pub struct MethodSig {
    pub owner: string,
    pub name: string,
    pub module_id: string,
    pub param_names: List<string>,
    pub min_params: number,
    pub params: List<string>,
    pub ret: string,
    pub decl: Node,
}

pub struct ConstSig {
    pub name: string,
    pub ty: string,
    pub is_pub: bool,
}

pub struct FieldSig {
    pub name: string,
    pub ty: string,
}

pub struct StructSig {
    pub name: string,
    pub module_id: string,
    pub is_pub: bool,
    /// Field type annotations, resolved after every struct name is known.
    pub field_nodes: List<Node>,
    pub fields: List<FieldSig>,
}

pub struct VariantSig {
    pub name: string,
    pub field_nodes: List<Node>,
    pub fields: List<FieldSig>,
}

pub struct EnumSig {
    pub name: string,
    pub module_id: string,
    pub is_pub: bool,
    pub is_generic: bool,
    pub generic_params: List<string>,
    pub variant_nodes: List<Node>,
    pub variants: List<VariantSig>,
}

/// The shape of an untyped object literal (`{ name: "a", age: 1 }`). Type
/// strings name it as `@objN`, so member reads can recover the fields.
pub struct AnonSig {
    pub id: number,
    pub fields: List<FieldSig>,
}

/// A `type Name = Target` alias. The target is expanded on demand, so aliases
/// may name aliases declared later.
pub struct AliasSig {
    pub name: string,
    pub module_id: string,
    pub is_pub: bool,
    pub is_generic: bool,
    pub type_node: Node,
    pub target: string,
}

pub struct ImportSig {
    pub alias: string,
    pub target: string,
    pub member: string,
    pub is_pub: bool,
}

pub struct GlobSig {
    pub target: string,
    pub is_pub: bool,
}

/// One module's namespace: its declarations and the `use` statements that
/// name other modules. A file-backed module is `opaque`: the checker has no
/// loader, so a call into it is "not modeled" rather than an error.
pub struct ModuleSig {
    pub id: string,
    pub parent: string,
    pub opaque: bool,
    pub consts: List<ConstSig>,
    pub imports: List<ImportSig>,
    pub globs: List<GlobSig>,
    pub uses: List<Node>,
    /// Type names imported from an opaque module or `std`: the checker cannot
    /// inspect their shape, so uses are "unknown", not errors.
    pub foreign_types: List<string>,
}

pub struct Checker {
    pub functions: List<FuncSig>,
    pub methods: List<MethodSig>,
    pub structs: List<StructSig>,
    pub enums: List<EnumSig>,
    pub aliases: List<AliasSig>,
    pub alias_depth: number,
    pub anon_objects: List<AnonSig>,
    pub next_anon: number,
    pub modules: List<ModuleSig>,
    pub current_module: string,
    pub bindings: List<Binding>,
    pub scopes: List<number>,
    pub active_scopes: number,
    pub next_scope: number,
    pub current_return: string,
    /// Type and const parameter names (`T`, `N`) declared by any generic
    /// item in the program. They are not concrete types, so `type_of` maps
    /// them to `unknown` instead of reporting E0101.
    pub generic_names: List<string>,
    /// Whether the program declares a macro. A macro can generate items the
    /// checker cannot see, so an unresolved name is "not modeled" rather than
    /// a confirmed error.
    pub has_macros: bool,
    /// Bare names bound by a `use` whose target is outside this buffer
    /// (`use std::http::{Request, Response}`). They may be types, functions,
    /// or constants, so every lookup treats them as opaque.
    pub external_imports: List<string>,
    pub complete: bool,
    pub error: string,
    pub code: string,
    pub line: number,
    pub column: number,
}

pub fn check(root: Node): CheckResult {
    let mut checker = Checker(
        functions: [],
        methods: [],
        structs: [],
        enums: [],
        aliases: [],
        alias_depth: 0,
        anon_objects: [],
        next_anon: 0,
        modules: [],
        current_module: "",
        bindings: [],
        scopes: [],
        active_scopes: 0,
        next_scope: 1,
        current_return: "unit",
        generic_names: [],
        has_macros: false,
        external_imports: [],
        complete: true,
        error: "",
        code: "",
        line: 1,
        column: 1,
    )
    ck_diag::enter_scope(checker)
    ck_module::add_module(checker, "", "#", false)
    ck_decls::collect_structs(checker, root, "")
    ck_decls::add_builtin_types(checker)
    ck_decls::collect_functions(checker, root, "")
    ck_module::resolve_uses(checker)
    ck_decls::resolve_structs(checker)
    ck_decls::resolve_enums(checker)
    ck_decls::resolve_function_signatures(checker)
    ck_decls::resolve_method_signatures(checker)
    if checker.error == "" {
        ck_stmt::check_program(checker, root)
    }
    return CheckResult(
        ok: checker.error == "",
        complete: checker.complete,
        code: checker.code,
        message: checker.error,
        line: checker.line,
        column: checker.column,
    )
}
