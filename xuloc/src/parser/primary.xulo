// Stage 1 parser: primary/postfix expressions and literals.
//
// Procedural form of the old `impl Parser` methods; `p` is the parser state.

use ast::{Node, node, add};
use super::control;
use super::exprs;
use super::nodes;
use super::stmts;
use super::template;
use super::tokens;
use super::types;
use super::Parser;

pub fn pr_postfix(p: mut Parser): Node {
    let mut value = pr_primary(p)
    while p.error == "" {
        if tokens::tk_at(p, "(") {
            value = pr_call_tail(p, value)
        } else if tokens::tk_at(p, "[") {
            tokens::tk_advance(p)
            let index = exprs::ex_expr(p)
            tokens::tk_expect(p, "]")
            let mut n = node(
                "Index",
                "",
                value.start,
                tokens::tk_prev(p).end,
                value.line,
                value.column,
            )
            add(n, value)
            add(n, index)
            value = n
        } else if tokens::tk_at(p, ".") or tokens::tk_at(p, "?.") {
            let dot = tokens::tk_advance(p)
            let property = pr_member_name(p)
            // A tuple position chain (`p.0.0`) lexes as one float token
            // (`0.0`); split it back into member accesses.
            let mut first = true
            for part in property.split(".") {
                let mut kind = "Member"
                if dot.text == "?." and first {
                    kind = "OptionalMember"
                }
                let mut n = node(
                    kind,
                    part,
                    value.start,
                    tokens::tk_prev(p).end,
                    value.line,
                    value.column,
                )
                add(n, value)
                value = n
                first = false
            }
        } else if tokens::tk_at(p, "<")
            and (value.kind == "Name" or value.kind == "Path")
            and pr_call_type_args_ahead(p)
        {
            let args = types::ty_type_args(p)
            let mut n = node(
                "TypeApply",
                "",
                value.start,
                args.end,
                value.line,
                value.column,
            )
            add(n, value)
            add(n, args)
            value = n
        } else if tokens::tk_at(p, "?") {
            // `?` is ternary whenever a complete `Expression ":"` follows the
            // marker (spec `expressions/operators.md`); otherwise it is
            // postfix propagation.
            if pr_has_ternary_after(p) {
                break
            }
            let question = tokens::tk_advance(p)
            let mut n = node(
                "Try",
                "?",
                value.start,
                question.end,
                value.line,
                value.column,
            )
            add(n, value)
            value = n
        } else if tokens::tk_at(p, "!")
            and (value.kind == "Name" or value.kind == "Path")
        {
            // `name!(…)` / `module::name! { … }`: a function-macro invocation.
            // The body is a token tree, so it is skipped balanced instead of
            // parsed as ordinary expressions.
            let bang = tokens::tk_advance(p)
            let mut n = node(
                "MacroCall",
                value.value,
                value.start,
                bang.end,
                value.line,
                value.column,
            )
            add(n, value)
            if tokens::tk_at(p, "(") {
                tokens::tk_skip_balanced(p, "(", ")")
            } else if tokens::tk_at(p, "{") {
                tokens::tk_skip_balanced(p, "{", "}")
            } else if tokens::tk_at(p, "[") {
                tokens::tk_skip_balanced(p, "[", "]")
            }
            n.end = tokens::tk_prev(p).end
            value = n
        } else {
            break
        }
    }
    return value
}

/// `?` starts a ternary when an expression parses after it and a `:` follows.
/// The probe is speculative: the position and any diagnostic are restored.
fn pr_has_ternary_after(p: mut Parser): bool {
    let saved_pos = p.pos
    let saved_error = p.error
    let saved_line = p.err_line
    let saved_column = p.err_column
    tokens::tk_advance(p)
    let _ = exprs::ex_expr(p)
    let ternary = p.error == "" and tokens::tk_at(p, ":")
    p.pos = saved_pos
    p.error = saved_error
    p.err_line = saved_line
    p.err_column = saved_column
    return ternary
}

/// A `<` after a primary is call-site type arguments only when the matching
/// `>` is followed by `(`; otherwise it stays the comparison operator.
fn pr_call_type_args_ahead(p: Parser): bool {
    let mut i = p.pos
    let mut depth = 0
    while i < p.tokens.len {
        let text = p.tokens[i].text
        if text == "<" {
            depth = depth + 1
        } else if text == ">" {
            depth = depth - 1
            if depth == 0 {
                return i + 1 < p.tokens.len and p.tokens[i + 1].text == "("
            }
        } else if text == ">>" {
            depth = depth - 2
            if depth <= 0 {
                return i + 1 < p.tokens.len and p.tokens[i + 1].text == "("
            }
        } else if text == ";" or text == "{" or text == "}" or text == "=>" {
            return false
        }
        i = i + 1
    }
    return false
}

pub fn pr_member_name(p: mut Parser): string {
    let token = tokens::tk_current(p)
    if token.kind == "ident"
        or token.kind == "keyword"
        or token.kind == "int"
        or token.kind == "float"
    {
        tokens::tk_advance(p)
        return token.text
    }
    tokens::tk_fail(p, "expected a member name, found " + tokens::tk_describe(p))
    return ""
}

pub fn pr_call_tail(p: mut Parser, callee: Node): Node {
    let start = tokens::tk_current(p)
    tokens::tk_advance(p)
    let mut n = node(
        "Call",
        "",
        callee.start,
        start.end,
        callee.line,
        callee.column,
    )
    add(n, callee)
    while p.error == "" and !tokens::tk_at(p, ")") and !tokens::tk_at_kind(p, "eof") {
        if (tokens::tk_at_kind(p, "ident") or tokens::tk_at_kind(p, "keyword")) and tokens::tk_peek_text(p, 1) == ":" {
            let arg_start = tokens::tk_current(p)
            let name = tokens::tk_ident_name(p)
            tokens::tk_advance(p)
            let mut arg = node(
                "Arg",
                name,
                arg_start.start,
                arg_start.end,
                arg_start.line,
                arg_start.column,
            )
            add(arg, exprs::ex_expr(p))
            arg.end = tokens::tk_prev(p).end
            add(n, arg)
        } else {
            add(n, exprs::ex_expr(p))
        }
        if tokens::tk_at(p, ",") {
            tokens::tk_advance(p)
        } else {
            break
        }
    }
    tokens::tk_expect(p, ")")
    n.end = tokens::tk_prev(p).end
    return n
}

/// An arrow closure is `(params) [: Return] => body` or `name => body`.
/// Look ahead past the parameter list (and optional return type) so a grouped
/// expression or a parenthesized tuple keeps its usual reading.
fn pr_arrow_ahead(p: Parser): bool {
    if (tokens::tk_at_kind(p, "ident") or tokens::tk_at_kind(p, "keyword"))
        and tokens::tk_peek_text(p, 1) == "=>"
    {
        return true
    }
    if !tokens::tk_at(p, "(") {
        return false
    }
    let mut i = p.pos
    let mut depth = 0
    while i < p.tokens.len {
        let text = p.tokens[i].text
        if text == "(" {
            depth = depth + 1
        } else if text == ")" {
            depth = depth - 1
            if depth == 0 {
                i = i + 1
                break
            }
        } else if p.tokens[i].kind == "eof" {
            return false
        }
        i = i + 1
    }
    if i >= p.tokens.len {
        return false
    }
    if p.tokens[i].text == "=>" {
        return true
    }
    if p.tokens[i].text != ":" {
        return false
    }
    i = i + 1
    depth = 0
    while i < p.tokens.len {
        let text = p.tokens[i].text
        if text == "=>" and depth == 0 {
            return true
        }
        if text == "(" or text == "[" or text == "{" or text == "<" {
            depth = depth + 1
        } else if text == ")" or text == "]" or text == "}" or text == ">" {
            if depth == 0 {
                return false
            }
            depth = depth - 1
        } else if text == ">>" {
            if depth < 2 {
                return false
            }
            depth = depth - 2
        } else if (text == ";" or text == "=" or text == ",") and depth == 0 {
            return false
        }
        i = i + 1
    }
    return false
}

fn pr_arrow_closure(p: mut Parser): Node {
    let start = tokens::tk_current(p)
    let mut n = node("ArrowClosure", "", start.start, start.end, start.line, start.column)
    if tokens::tk_at(p, "(") {
        tokens::tk_advance(p)
        while p.error == "" and !tokens::tk_at(p, ")") and !tokens::tk_at_kind(p, "eof") {
            let param_start = tokens::tk_current(p)
            if tokens::tk_at(p, "mut") or tokens::tk_at(p, "shared") {
                tokens::tk_advance(p)
            }
            let name = tokens::tk_ident_name(p)
            let mut param = node(
                "Param",
                name,
                param_start.start,
                param_start.end,
                param_start.line,
                param_start.column,
            )
            if tokens::tk_at(p, ":") {
                tokens::tk_advance(p)
                add(param, types::ty_type_expr(p))
            }
            param.end = tokens::tk_prev(p).end
            add(n, param)
            if tokens::tk_at(p, ",") {
                tokens::tk_advance(p)
            } else {
                break
            }
        }
        tokens::tk_expect(p, ")")
    } else {
        let param_start = tokens::tk_current(p)
        let name = tokens::tk_ident_name(p)
        add(n, nodes::nd_mk(p, "Param", name, param_start))
    }
    if tokens::tk_at(p, ":") {
        tokens::tk_advance(p)
        add(n, types::ty_type_expr(p))
    }
    if !tokens::tk_expect(p, "=>") {
        return n
    }
    if tokens::tk_at(p, "{") {
        add(n, stmts::st_block(p))
    } else {
        add(n, exprs::ex_expr(p))
    }
    n.end = tokens::tk_prev(p).end
    return n
}

/// `lock target { … }` guards a shared binding and evaluates to its body.
fn pr_lock_expr(p: mut Parser): Node {
    let start = tokens::tk_advance(p)
    let mut n = node("Lock", "", start.start, start.end, start.line, start.column)
    add(n, exprs::ex_expr(p))
    if tokens::tk_at(p, "{") {
        add(n, stmts::st_block(p))
    } else {
        tokens::tk_fail(p, "expected a lock body, found " + tokens::tk_describe(p))
    }
    n.end = tokens::tk_prev(p).end
    return n
}

/// `spawn [.target] async { … }` runs a task; `spawn.process Type { … }`
/// starts a service (spec `grammar.md`, `SpawnExpression`).
fn pr_spawn_expr(p: mut Parser): Node {
    let start = tokens::tk_advance(p)
    let mut target = "default"
    let mut n = node("Spawn", target, start.start, start.end, start.line, start.column)
    if tokens::tk_at(p, ".") {
        tokens::tk_advance(p)
        target = tokens::tk_ident_name(p)
        n.value = target
        if target == "on" {
            if tokens::tk_expect(p, "(") {
                add(n, exprs::ex_expr(p))
                tokens::tk_expect(p, ")")
            }
        }
    }
    if tokens::tk_at(p, "async") {
        tokens::tk_advance(p)
        if tokens::tk_at(p, "{") {
            add(n, stmts::st_block(p))
        } else {
            tokens::tk_fail(p, "expected a spawn body, found " + tokens::tk_describe(p))
        }
    } else if target == "process" {
        add(n, types::ty_type_expr(p))
        if tokens::tk_at(p, "{") {
            let body = pr_map_body(p, false)
            add(n, body)
        } else {
            tokens::tk_fail(p, "expected a service body, found " + tokens::tk_describe(p))
        }
    } else {
        tokens::tk_fail(p, "expected `async` after spawn, found " + tokens::tk_describe(p))
    }
    n.end = tokens::tk_prev(p).end
    return n
}

pub fn pr_primary(p: mut Parser): Node {
    let start = tokens::tk_current(p)
    if pr_arrow_ahead(p) {
        return pr_arrow_closure(p)
    }
    if tokens::tk_at(p, "true") or tokens::tk_at(p, "false") or tokens::tk_at(p, "null") {
        tokens::tk_advance(p)
        return nodes::nd_mk(p, "Literal", start.text, start)
    }
    if tokens::tk_at_kind(p, "int")
        or tokens::tk_at_kind(p, "float")
        or tokens::tk_at_kind(p, "string")
    {
        tokens::tk_advance(p)
        return nodes::nd_mk(p, "Literal", start.text, start)
    }
    if tokens::tk_at_kind(p, "template") {
        tokens::tk_advance(p)
        return template::tp_template_expr(p, start)
    }
    if tokens::tk_at(p, "(") {
        return pr_paren_expr(p)
    }
    if tokens::tk_at(p, "[") {
        return pr_list_expr(p)
    }
    if tokens::tk_at(p, "{") {
        return pr_map_expr(p)
    }
    if tokens::tk_at(p, "if") {
        return control::ct_if_expr(p)
    }
    if tokens::tk_at(p, "match") {
        return control::ct_match_expr(p)
    }
    if tokens::tk_at(p, "lock") {
        return pr_lock_expr(p)
    }
    if tokens::tk_at(p, "spawn") {
        return pr_spawn_expr(p)
    }
    if tokens::tk_at(p, "fn") {
        return control::ct_fn_expr(p)
    }
    if tokens::tk_at(p, "panic") {
        tokens::tk_advance(p)
        let name = nodes::nd_mk(p, "Name", "panic", start)
        if tokens::tk_at(p, "(") {
            return pr_call_tail(p, name)
        }
        return name
    }
    if tokens::tk_at(p, "Map") and tokens::tk_peek_text(p, 1) == "<" {
        return pr_typed_map_expr(p)
    }
    if tokens::tk_at_kind(p, "ident") or tokens::tk_at_kind(p, "keyword") {
        tokens::tk_advance(p)
        let mut n = nodes::nd_mk(p, "Name", start.text, start)
        while p.error == "" and tokens::tk_at(p, "::") {
            tokens::tk_advance(p)
            let segment = tokens::tk_ident_name(p)
            let mut path = node(
                "Path",
                n.value + "::" + segment,
                n.start,
                tokens::tk_prev(p).end,
                n.line,
                n.column,
            )
            add(path, n)
            n = path
        }
        return n
    }
    tokens::tk_fail(p, "expected an expression, found " + tokens::tk_describe(p))
    return nodes::nd_placeholder(p, start)
}

pub fn pr_paren_expr(p: mut Parser): Node {
    let start = tokens::tk_advance(p)
    let first = exprs::ex_expr(p)
    if tokens::tk_at(p, ",") {
        let mut n = node("Tuple", "", start.start, start.end, start.line, start.column)
        add(n, first)
        while p.error == "" and tokens::tk_at(p, ",") {
            tokens::tk_advance(p)
            if tokens::tk_at(p, ")") {
                break
            }
            add(n, exprs::ex_expr(p))
        }
        tokens::tk_expect(p, ")")
        n.end = tokens::tk_prev(p).end
        return n
    }
    tokens::tk_expect(p, ")")
    let mut n = node("Group", "", start.start, tokens::tk_prev(p).end, start.line, start.column)
    add(n, first)
    return n
}

pub fn pr_list_expr(p: mut Parser): Node {
    let start = tokens::tk_advance(p)
    let mut n = node("List", "", start.start, start.end, start.line, start.column)
    while p.error == "" and !tokens::tk_at(p, "]") and !tokens::tk_at_kind(p, "eof") {
        if tokens::tk_at(p, "...") {
            let spread_start = tokens::tk_advance(p)
            let mut spread = node(
                "Spread",
                "",
                spread_start.start,
                spread_start.end,
                spread_start.line,
                spread_start.column,
            )
            add(spread, exprs::ex_expr(p))
            spread.end = tokens::tk_prev(p).end
            add(n, spread)
        } else {
            add(n, exprs::ex_expr(p))
        }
        if tokens::tk_at(p, ",") {
            tokens::tk_advance(p)
        } else {
            break
        }
    }
    tokens::tk_expect(p, "]")
    n.end = tokens::tk_prev(p).end
    return n
}

pub fn pr_map_expr(p: mut Parser): Node {
    return pr_map_body(p, false)
}

// `Map<K, V>{ "k": v }` is a typed map literal: the type arguments are
// skipped and the keys are expressions, unlike a brace object literal's
// bare identifier keys (spec `expressions/literals.md`).
pub fn pr_typed_map_expr(p: mut Parser): Node {
    let start = tokens::tk_advance(p)
    types::ty_type_args(p)
    if p.error != "" {
        return nodes::nd_placeholder(p, start)
    }
    if !tokens::tk_at(p, "{") {
        tokens::tk_fail(p, "expected `{` after a map type")
        return nodes::nd_placeholder(p, start)
    }
    let mut n = pr_map_body(p, true)
    n.start = start.start
    n.line = start.line
    n.column = start.column
    return n
}

pub fn pr_map_body(p: mut Parser, typed: bool): Node {
    let start = tokens::tk_advance(p)
    let mut n = node("Map", "", start.start, start.end, start.line, start.column)
    while p.error == "" and !tokens::tk_at(p, "}") and !tokens::tk_at_kind(p, "eof") {
        if tokens::tk_at(p, "...") {
            let spread_start = tokens::tk_advance(p)
            let mut spread = node(
                "Spread",
                "",
                spread_start.start,
                spread_start.end,
                spread_start.line,
                spread_start.column,
            )
            add(spread, exprs::ex_expr(p))
            spread.end = tokens::tk_prev(p).end
            add(n, spread)
        } else if typed {
            let key = exprs::ex_expr(p)
            tokens::tk_expect(p, ":")
            let mut entry = node("Entry", "", key.start, key.end, key.line, key.column)
            add(entry, key)
            add(entry, exprs::ex_expr(p))
            entry.end = tokens::tk_prev(p).end
            add(n, entry)
        } else {
            let key = tokens::tk_ident_name(p)
            tokens::tk_expect(p, ":")
            let mut entry = nodes::nd_mk(p, "Entry", key, start)
            add(entry, exprs::ex_expr(p))
            entry.end = tokens::tk_prev(p).end
            add(n, entry)
        }
        if tokens::tk_at(p, ",") {
            tokens::tk_advance(p)
        } else {
            break
        }
    }
    tokens::tk_expect(p, "}")
    n.end = tokens::tk_prev(p).end
    return n
}
