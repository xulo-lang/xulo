// Stage 1 parser: expression precedence.
//
// Binary operators use precedence climbing instead of one function per
// precedence level. The flat loop keeps the parser's call depth low enough for
// the interpreted bootstrap path (the runtime stops at 128 nested calls) while
// keeping the same tree shapes and associativity as the former ladder.

use ast::{Node, node, add};
use super::nodes;
use super::primary;
use super::tokens;
use super::types;
use super::Parser;

pub fn ex_expr(p: mut Parser): Node {
    return ex_ternary(p)
}

pub fn ex_ternary(p: mut Parser): Node {
    let cond = ex_binary(p, 1)
    if p.error == "" and tokens::tk_at(p, "?") {
        tokens::tk_advance(p)
        let then_branch = ex_expr(p)
        if !tokens::tk_expect(p, ":") {
            return cond
        }
        let else_branch = ex_ternary(p)
        let mut n = node(
            "Ternary",
            "?",
            cond.start,
            else_branch.end,
            cond.line,
            cond.column,
        )
        add(n, cond)
        add(n, then_branch)
        add(n, else_branch)
        return n
    }
    return cond
}

/// Precedence of a binary operator, or `0` when the token is not one.
fn bi_prec(op: string): number {
    if op == "or" {
        return 1
    }
    if op == "and" {
        return 2
    }
    if op == "??" {
        return 3
    }
    if op == "==" or op == "!=" {
        return 4
    }
    if op == "is" {
        return 5
    }
    if op == "<" or op == ">" or op == "<=" or op == ">=" {
        return 6
    }
    if op == "..<" or op == "..=" {
        return 7
    }
    if op == "|" {
        return 8
    }
    if op == "^" {
        return 9
    }
    if op == "&" {
        return 10
    }
    if op == "<<" or op == ">>" {
        return 11
    }
    if op == "+" or op == "-" {
        return 12
    }
    if op == "*" or op == "/" or op == "%" {
        return 13
    }
    if op == "**" {
        return 14
    }
    return 0
}

/// Parse operators whose precedence is at least `min_prec`. Left-associative
/// operators stay in this loop; only the right operand recurses, and `**`
/// recurses at its own precedence to stay right-associative.
fn ex_binary(p: mut Parser, min_prec: number): Node {
    let mut left = ex_unary(p)
    while p.error == "" {
        let op = tokens::tk_current(p).text
        let prec = bi_prec(op)
        if prec < min_prec or prec == 0 {
            break
        }
        if op == "is" {
            tokens::tk_advance(p)
            let mut value = "is"
            if tokens::tk_at(p, "not") {
                tokens::tk_advance(p)
                value = "is not"
            }
            let ty = types::ty_type_expr(p)
            let mut n = node("Is", value, left.start, ty.end, left.line, left.column)
            add(n, left)
            add(n, ty)
            left = n
            continue
        }
        let token = tokens::tk_advance(p)
        let mut next_min = prec + 1
        if op == "**" {
            next_min = prec
        }
        let right = ex_binary(p, next_min)
        left = nodes::nd_binary(p, token.text, left, right)
    }
    return left
}

pub fn ex_unary(p: mut Parser): Node {
    let start = tokens::tk_current(p)
    if tokens::tk_at(p, "!")
        or tokens::tk_at(p, "-")
        or tokens::tk_at(p, "~")
        or tokens::tk_at(p, "await")
        or tokens::tk_at(p, "move")
        or tokens::tk_at(p, "copy")
        or tokens::tk_at(p, "shared")
    {
        let op = tokens::tk_advance(p)
        let operand = ex_unary(p)
        let mut n = node(
            "Unary",
            op.text,
            start.start,
            operand.end,
            start.line,
            start.column,
        )
        add(n, operand)
        return n
    }
    return primary::pr_postfix(p)
}
