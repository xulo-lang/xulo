// Stage 1 command line.
//
// Two ways to choose the input, because `xulo run <file>` does not forward
// script arguments:
//
//   * compiled binary:  xuloc tokens <file>
//                       xuloc parse  <file>
//   * under `xulo run`: set XULO_STAGE1_MODE=tokens|parse and
//                       XULO_STAGE1_FILE=<file>
//
// A third form scans a whole tree and reports, per file, whether the stage 1
// lexer and parser accept it. The example corpus gate drives this:
//
//   XULO_STAGE1_MODE=scan XULO_STAGE1_DIR=examples xulo run xuloc/src/main.xulo
//
// The default mode is `parse`. Diagnostics go to stderr in the stage 0 shape
// `<file>:<line>:<column>: error: <message>` and the process exits 1.

mod ast;
mod checker;
mod lexer;
mod parser;
mod backend;

use ast::{render};
use backend::{compile, BuildResult};
use backend::bk_util::{base_of, dir_of, join_path, stem_of};
use checker::{check, CheckResult};
use lexer::{lex, LexResult, Token};
use parser::{parse, ParseResult};

struct CcRun {
    code: number,
    output: string,
}

fn make_dir(path: string) {
    match std::fs::mkdir(path) {
        Result::Ok(_) => {}
        Result::Err(error) => {
            std::io::eprintln("xuloc: cannot create " + path + ": " + error.message)
            std::process::exit(1)
        }
    }
}

fn cc_args(runtime_path: string, c_path: string, binary: string): List<string> {
    let mut args: List<string> = [
        "-std=c11",
        "-O1",
        "-w",
        "-I",
        dir_of(runtime_path),
        "-o",
        binary,
        c_path,
    ]
    if std::os::platform() != "windows" {
        args.push("-lm")
    }
    if std::os::platform() == "windows" {
        args.push("-Wl,/STACK:67108864")
    }
    return args
}

fn run_cc(compiler: string, runtime_path: string, c_path: string, binary: string): CcRun {
    match std::process::exec(compiler, cc_args(runtime_path, c_path, binary)) {
        Result::Ok(run) => {
            return CcRun(code: run.code, output: run.stdout + run.stderr)
        }
        Result::Err(error) => {
            return CcRun(code: -1, output: error.message)
        }
    }
}

fn run_build(file: string, source: string) {
    let lexed: LexResult = lex(source)
    if lexed.error != "" {
        fail(file, lexed.line, lexed.column, "E0001", lexed.error)
    }
    let parsed: ParseResult = parse(lexed.tokens)
    if parsed.error != "" {
        fail(file, parsed.line, parsed.column, "E0002", parsed.error)
    }
    // Reject a program only when the checker understood all of it and found a
    // confirmed error. `complete == false` means it hit a construct or name it
    // does not model (structs, modules, std calls, generics), so code
    // generation gets the final say instead of a false rejection.
    let checked: CheckResult = check(parsed.root)
    if !checked.ok and checked.complete {
        fail(file, checked.line, checked.column, checked.code, checked.message)
    }
    let runtime_path = env_or("XULO_STAGE1_RUNTIME", "xuloc/runtime/runtime.c")
    let built: BuildResult = compile(parsed.root, file, base_of(runtime_path))
    if !built.ok {
        fail(file, 1, 1, "E0005", built.message)
    }
    let dir = dir_of(file)
    let work = join_path(join_path(dir, ".xupm"), "build")
    make_dir(join_path(dir, ".xupm"))
    make_dir(work)
    let mut c_path = env_or("XULO_STAGE1_C", "")
    if c_path == "" {
        c_path = join_path(work, stem_of(file) + ".c")
    }
    match std::fs::write(c_path, built.source) {
        Result::Ok(_) => {}
        Result::Err(error) => {
            fail(file, 1, 1, "E0004", "cannot write " + c_path + ": " + error.message)
        }
    }
    let mut binary = env_or("XULO_STAGE1_OUT", "")
    if binary == "" {
        binary = join_path(work, stem_of(file))
        if std::os::platform() == "windows" {
            binary = binary + ".exe"
        }
    }
    let mut compiler = env_or("XULO_CC", "")
    let explicit = compiler != ""
    if compiler == "" {
        compiler = "clang"
    }
    let mut candidates: List<string> = [compiler]
    if !explicit {
        if compiler == "clang" {
            candidates.push("cc")
        }
        if std::os::platform() == "windows" {
            candidates.push("C:\\Program Files\\LLVM\\bin\\clang.exe")
        }
    }
    let mut index = 0
    let mut chosen = compiler
    let mut compiled = CcRun(code: -1, output: "no C compiler was tried")
    while index < candidates.len {
        chosen = candidates[index]
        compiled = run_cc(chosen, runtime_path, c_path, binary)
        if compiled.code == 0 {
            break
        }
        index = index + 1
    }
    if compiled.code != 0 {
        fail(
            file,
            1,
            1,
            "E0005",
            "the C compiler `" + chosen + "` failed:\n" + compiled.output,
        )
    }
    print(binary)
}

fn env_or(name: string, fallback: string): string {
    match std::os::getenv(name) {
        Result::Ok(value) => {
            return value ?? fallback
        }
        Result::Err(_) => {
            return fallback
        }
    }
}

fn usage() {
    std::io::eprintln("usage: xuloc <tokens|parse|check|build> <file>")
    std::io::eprintln("   or: XULO_STAGE1_MODE=tokens|parse|check|build XULO_STAGE1_FILE=<file> xulo run xuloc/src/main.xulo")
    std::io::eprintln("   or: XULO_STAGE1_MODE=scan XULO_STAGE1_DIR=<dir> xulo run xuloc/src/main.xulo")
}

fn kind_label(code: string): string {
    if code == "E0001" {
        return "lexical"
    }
    if code == "E0002" {
        return "syntax"
    }
    if code == "E0004" {
        return "io"
    }
    if code == "E0005" {
        return "codegen"
    }
    return "semantic"
}

fn fail(file: string, line: number, column: number, code: string, message: string) {
    std::io::eprintln(
        file + ":" + str(line) + ":" + str(column) + ": error[" + code + "] " + kind_label(code) + ": " + message,
    )
    std::process::exit(1)
}

fn print_tokens(tokens: List<Token>) {
    for token in tokens {
        let mut out = StringBuilder::new()
        out.append(str(token.line))
        out.append(":")
        out.append(str(token.column))
        out.append(" ")
        out.append(token.kind)
        out.append(" ")
        out.append(str(token.start))
        out.append(":")
        out.append(str(token.end))
        out.append(" ")
        out.append(token.text)
        print(out.build())
    }
}

fn run_tokens(file: string, source: string) {
    let result: LexResult = lex(source)
    if result.error != "" {
        fail(file, result.line, result.column, "E0001", result.error)
    }
    print_tokens(result.tokens)
}

fn run_check(file: string, source: string) {
    let lexed: LexResult = lex(source)
    if lexed.error != "" {
        fail(file, lexed.line, lexed.column, "E0001", lexed.error)
    }
    let parsed: ParseResult = parse(lexed.tokens)
    if parsed.error != "" {
        fail(file, parsed.line, parsed.column, "E0002", parsed.error)
    }
    let result: CheckResult = check(parsed.root)
    if !result.ok {
        fail(file, result.line, result.column, result.code, result.message)
    }
    print("no errors")
}

fn run_parse(file: string, source: string) {
    let lexed: LexResult = lex(source)
    if lexed.error != "" {
        fail(file, lexed.line, lexed.column, "E0001", lexed.error)
    }
    let result: ParseResult = parse(lexed.tokens)
    if result.error != "" {
        fail(file, result.line, result.column, "E0002", result.error)
    }
    print(render(result.root, 0))
}

fn has_xulo_suffix(path: string): bool {
    let size = path.len
    if size < 5 {
        return false
    }
    return path.slice(size - 5, size) == ".xulo"
}

/// Whether `path` is listed in the semicolon-separated `XULO_STAGE1_SKIP`.
///
/// The corpus gate uses this for inputs that crash the stage 1 parser (deep
/// nesting exhausts the interpreter's call depth if it is a call frame; the
/// skip keeps the rest of the tree measurable).
fn skipped(path: string): bool {
    let list = env_or("XULO_STAGE1_SKIP", "")
    if list == "" {
        return false
    }
    for item in split_on(list, ";") {
        if item == path {
            return true
        }
    }
    return false
}

fn split_on(text: string, separator: string): List<string> {
    let mut parts: List<string> = []
    if separator == "" {
        parts.push(text)
        return parts
    }
    let sep_size = separator.len
    let mut start = 0
    let mut index = 0
    while index + sep_size <= text.len {
        if text.slice(index, index + sep_size) == separator {
            parts.push(text.slice(start, index))
            index = index + sep_size
            start = index
        } else {
            index = index + 1
        }
    }
    parts.push(text.slice(start, text.len))
    return parts
}

/// One line per file: `<path>\t<lexer status>\t<parser status>`.
///
/// A lexer failure makes the parser column `skipped`, so a file that cannot be
/// tokenized is not also reported as a parse failure. Lines go through
/// `std::io::println`, so a crash still leaves every earlier line on stdout.
fn scan_file(file: string) {
    if skipped(file) {
        std::io::println(file + "\tskipped\tskipped")
        return
    }
    match std::fs::read(file) {
        Result::Ok(source) => {
            let lexed: LexResult = lex(source)
            let mut lex_status = "ok"
            if lexed.error != "" {
                lex_status = "error E0001 " + lexed.error
            }
            let mut parse_status = "skipped"
            if lexed.error == "" {
                let parsed: ParseResult = parse(lexed.tokens)
                if parsed.error != "" {
                    parse_status = "error E0002 " + parsed.error
                } else {
                    parse_status = "ok"
                }
            }
            std::io::println(file + "\t" + lex_status + "\t" + parse_status)
        }
        Result::Err(error) => {
            std::io::println(file + "\terror E0004 " + error.message + "\tskipped")
        }
    }
}

/// Scan every `.xulo` file under `dir`, in the host's walk order.
fn run_scan(dir: string) {
    match std::fs::walk(dir) {
        Result::Ok(paths) => {
            for path in paths {
                if has_xulo_suffix(path) {
                    scan_file(path)
                }
            }
        }
        Result::Err(error) => {
            fail(dir, 1, 1, "E0004", error.message)
        }
    }
}

fn main() {
    let args = std::process::args()
    let mut mode = env_or("XULO_STAGE1_MODE", "parse")
    let mut file = env_or("XULO_STAGE1_FILE", "")
    let mut dir = env_or("XULO_STAGE1_DIR", "")
    // Nested `if`s, not `a and (b or c)`: the C backend evaluates the right
    // side of a nested short-circuit eagerly, and `args[1]` is out of bounds
    // when the binary is called without arguments.
    if args.len >= 3 {
        if args[1] == "tokens"
            or args[1] == "parse"
            or args[1] == "check"
            or args[1] == "build"
        {
            mode = args[1]
            file = args[2]
        }
    }
    if mode == "scan" {
        if dir == "" {
            usage()
            std::process::exit(1)
        }
        run_scan(dir)
        return
    }
    if file == "" {
        usage()
        std::process::exit(1)
    }
    if mode != "tokens" and mode != "parse" and mode != "check" and mode != "build" {
        usage()
        std::process::exit(1)
    }
    match std::fs::read(file) {
        Result::Ok(source) => {
            if mode == "tokens" {
                run_tokens(file, source)
            } else if mode == "check" {
                run_check(file, source)
            } else if mode == "build" {
                run_build(file, source)
            } else {
                run_parse(file, source)
            }
        }
        Result::Err(error) => {
            fail(file, 1, 1, "E0004", "cannot read file: " + error.message)
        }
    }
}
